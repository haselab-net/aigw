#!/usr/bin/env python3
"""talkto "message" -- send a message to whichever aigw session (aigw
workspace doc, `the deployment notes`) this one is currently linked to.

Deliberately explicit, not automatic: aigw does not relay everything this
session says, only what is passed to this command. The message is queued as
soon as this exits 0; delivery depends on a link actually existing right now
(the aigw backend silently drops it otherwise -- this script has no way to
ask, since it only ever writes a file, never talks over the network) and,
for a host/root partner, on that tier's passkey window being open.

Talks to the backend by appending one JSON line to $AIGW_TALKTO -- a file
under this session's own directory, not a socket or a port, the same
share-nothing-except-the-bind-mount trick $AIGW_OUTBOX already uses.
"""
import json
import os
import sys
import time


def main():
    if len(sys.argv) != 2:
        print('usage: talkto "message to send to the linked session"', file=sys.stderr)
        return 1
    path = os.environ.get("AIGW_TALKTO")
    if not path:
        print("talkto: $AIGW_TALKTO is not set -- this shell was not started by aigw, "
              "or this preset does not support session links", file=sys.stderr)
        return 1
    text = sys.argv[1]
    if not text.strip():
        print("talkto: message is empty", file=sys.stderr)
        return 1
    line = json.dumps({"ts": time.time(), "text": text})
    with open(path, "a") as f:
        f.write(line + "\n")
    print("talkto: queued")
    return 0


if __name__ == "__main__":
    sys.exit(main())
