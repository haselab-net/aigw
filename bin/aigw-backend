#!/opt/aigw/venv/bin/python3
"""
Per-user backend for the "aigw" mobile AI control panel.

Runs as the target Unix user (systemd `User=%i` in aigw-backend@.service, one
instance per host user, started on demand by aigw-backend-proxy@<port>.socket
-- see the deployment notes). Binds an AF_UNIX socket at
BACKEND_SOCKET_PATH, not a loopback TCP port (the deployment notes, 2026-08-30
revision 2): loopback TCP has no per-uid access control on Linux, so a
127.0.0.1 port -- despite the docstring this one used to have -- was
reachable by ANY local user on this host, not just aigw-gateway. A
Unix-domain socket has real filesystem permissions instead: this one is
mode 0600, owned by this user alone, so the only things that can ever
connect are this user's own processes and root -- and the only root process
that ever does is aigw-proxy-handler, relaying a connection that already
passed through aigw-backend-proxy@<port>.socket's own, separately
permissioned AF_UNIX socket (owner "aigw", mode 0600 -- see that unit).
There is deliberately no group "aigw" anywhere in this: an earlier revision
of this fix chmod'd this socket group "aigw" and had aigw-gateway connect to
it directly, which meant giving aigw-gateway a `systemctl start
aigw-backend@<user>` sudo rule to wake a stopped one -- rejected on review
(the deployment notes: the privileged side, not its caller, must
be the authorization boundary; a wildcard `aigw-backend@*.service` rule put
that boundary in aigw-gateway's own username-validation code instead, one
bug away from `aigw-backend@root.service` actually starting as root). Root
already owns that boundary today -- aigw-backend-proxy@.service has no
`User=` line, so it runs as root already, and always has -- so keeping the
existing activation relay and just swapping its transport closes the same
hole without moving who is trusted to start a backend at all.

A "session" runs inside this user's own devbox-<user> container, driven
entirely through the existing `sandbox` command (never raw docker) -- so this
process needs no privilege beyond what the human user already has. Two kinds:
Claude Code is driven headlessly (`claude -p ... --output-format stream-json
--resume <id>`, one subprocess per message -- its interactive TUI is a
fullscreen, cursor-redrawing app that doesn't fit an append-only chat log at
all, so we never launch it interactively); everything else (a plain shell
today, any future AI CLI without its own headless mode -- including someone
just running `claude` interactively *inside* that shell, which hits the exact
same fullscreen-redraw problem headless mode exists to avoid) runs in a real
tmux pane instead, polled via `tmux capture-pane` rather than tailed as a raw
byte stream (see _watch_tmux_session) -- that's what makes an interactively-
run fullscreen program show up as legible text instead of garbage, whether
the pane was one this backend created (the "shell" preset) or one a user
started by hand and later pointed this backend at (the "attach" preset, see
adopt_session).

Conversation state lives under $HOME/sandhome/.aigw/<session-id>/, which is
bind-mounted at the same absolute path inside the container, so any process
inside the container (an AI CLI, or a plain script) can drop files in
outbox/ to have them shown as attachments, without this process ever needing
to `docker exec` just to read them back out.
"""
import base64
import hashlib
import hmac
import secrets
import datetime
import difflib
import getpass
import json
import mimetypes
import os
import pwd
import queue
import re
import shlex
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse, parse_qs, unquote

HOME = Path.home()
# This host's own public DNS name, for the one place it's needed below (a
# mailto: contact address in the VAPID claims Web Push requires) --
# generic, since there's nothing security-sensitive riding on getting this
# exactly right the way there is for aigw-gateway's own OAuth redirect URI.
PUBLIC_HOST = socket.getfqdn()
# Bind-mounted into devbox-<user> at this same absolute path, and is $HOME
# inside the container -- which is what lets this process both read the
# container's Claude Code state (see claude_project_dir) and name a working
# directory that means the same thing on either side (see resolve_workdir).
SANDHOME = HOME / "sandhome"
SESSIONS_DIR = SANDHOME / ".aigw"
STATE_DIR = HOME / ".aigw-state"
# Persisted screen-panel backlog, across a session's own lifetime (unlike
# _screen_backlog, the in-memory cache this backs -- see _screen_log_path
# and the "scrolled off" hookup in _watch_tmux_session,
# the deployment notes). Under STATE_DIR, not SESSIONS_DIR: this
# is the backend's own bookkeeping (same shelf as session_links.json/
# push_subscriptions.json), never something a container-side process reads
# or writes directly, unlike the per-session dirs under SESSIONS_DIR which
# are bind-mounted into the container as $AIGW_OUTBOX and friends.
SCREEN_LOG_DIR = STATE_DIR / "screen-logs"
VAPID_PRIVATE_KEY_FILE = "/etc/aigw/vapid_private.pem"
VAPID_SUB_FILE = "/etc/aigw/vapid_sub.txt"

# Absolute paths, never a bare "claude": the host-side commands run under
# systemd's own minimal PATH (no ~/.local/bin, no login-shell profile
# sourcing), and the root-side ones run in a pane whose PATH is whatever the
# root tmux server inherited. A host-shell/root-shell pane gets away with
# plain `claude` only because it runs `bash -l`.
HOST_CLAUDE_BIN = str(HOME / ".local/bin/claude")
ROOT_CLAUDE_BIN = "/root/.local/bin/claude"

# Codex CLI is one shared /usr/local/bin/codex (root-owned, world-executable,
# the deployment notes), not a per-user install like Claude Code above -- so
# unlike HOST_CLAUDE_BIN/ROOT_CLAUDE_BIN there is only one path, same for
# host and root. Still not a bare "codex" for the same PATH reason as above.
HOST_CODEX_BIN = "/usr/local/bin/codex"
ROOT_CODEX_BIN = "/usr/local/bin/codex"

SESSION_ID_RE = re.compile(r"^[a-f0-9]{8,32}$")
OUTBOX_NAME_RE = re.compile(r"^[A-Za-z0-9._-]{1,200}$")

# Strips ANSI/terminal control sequences from raw tmux pane output. We are a
# chat-bubble UI, not a terminal emulator (xterm.js), so escape codes (color,
# bracketed-paste-mode toggles, cursor movement, etc.) would otherwise show
# up as literal garbage text.
_ANSI_RE = re.compile(r"\x1b(?:\[[0-9;?]*[a-zA-Z]|\][^\x07]*(?:\x07|\x1b\\)|[@-_])")


def clean_terminal_text(text):
    text = _ANSI_RE.sub("", text)
    return text.replace("\r\n", "\n").replace("\r", "\n")

# "claude" is handled specially (see _run_claude_headless_turn): it ships a
# fullscreen, cursor-redrawing TUI (like vim) plus its own API built for
# programmatic, turn-by-turn driving instead of a live pane -- Claude Code's
# headless "print mode" (`-p` + `--output-format stream-json` +
# `--resume <id>`). Every other preset uses a real tmux pane, watched via
# _watch_tmux_session's capture-pane polling -- which, unlike raw pipe-pane
# byte tailing, handles a fullscreen redrawing program just fine too (so
# someone running `claude` interactively *inside* a "shell" preset session
# still gets legible text, not garbage).
#
# (A "codewhale" preset -- one persistent `codewhale app-server --http` per
# user, driven over that tool's own HTTP/SSE runtime API -- lived here until
# 2026-08-01, when it was removed as unused at the user's request.)
#
# Each tmux preset says *where* its pane lives, extending the
# "container"/"host" split adopt_session already had (see tmux_exec) with a
# third location, "root":
#
#   container - inside the user's own devbox-<user>, via `sandbox exec`.
#   host      - this host itself, in that user's own tmux server. Crosses no
#               new privilege boundary: aigw-backend@<user>.service is
#               already `User=%i`, so it can already run anything that
#               user's own SSH shell could, and "attach" has been driving
#               host-side panes since 2026-07-31. NOT sandboxed though --
#               the pane sees the user's real $HOME.
#   root      - this host itself, as root, in a tmux server that is NOT ours:
#               it belongs to aigw-root-tmux@<user>.service, runs as root,
#               and every pane it creates runs as root. We reach it as an
#               ordinary tmux client over its socket.
#
# Unlike the other two, "root" grants more than this user's own rights, and
# deliberately so: the alternative -- typing a sudo password into the chat --
# would persist the password in plaintext in events.jsonl, which is mounted
# read-write into the container.
#
# Note what is NOT here: any sudo call, or any root-side program this process
# passes arguments to. The privilege is granted entirely out of band, by an
# administrator enabling aigw-root-tmux@<user>.service, and is expressed as
# "this Unix user may talk to that already-running root tmux server" -- via
# 0700/0600 filesystem permissions plus tmux's own `server-access` ACL, both
# enforced by code that never sees anything we send. If the unit is not
# enabled for this user, the socket simply is not there. See the
# "root-shell" section of the deployment notes.

# GPU machines reachable over SSH via a shared jump host (see
# /opt/aigw-ssh and the deployment notes). Both are actually Windows
# boxes; each runs psmux (github.com/psmux/psmux, winget id marlocarlo.psmux)
# instead of tmux -- a separate binary that speaks the same CLI (new-session/
# send-keys/capture-pane/list-sessions/kill-session/set-option/respawn-pane
# real MSYS2 tmux on both -- NOT psmux (github.com/psmux/psmux), tried first
# (2026-08-14) since winbox-b had no MSYS2 at the time. psmux was dropped
# after real-machine testing *seemed* to show `send-keys -l` corrupting
# literal text (dropping spaces, and "$" plus everything after it in the same
# word) and claude.exe's TUI refusing to start under it -- but the actual
# root cause, found only after also installing MSYS2's tmux on winbox-a and
# seeing the exact same symptom there, was a bug in THIS file's own
# `_ssh_run` (fixed same-day, see its docstring): unquoted text sent over ssh
# gets word-split and $-expanded by the remote bash before psmux or tmux ever
# see it, which explains every one of those symptoms without psmux being at
# fault at all. The claude.exe TUI-launch failure specifically was not
# re-tested against psmux after the _ssh_run fix, so whether that one was
# also just the quoting bug or a genuine psmux/ConPTY limitation is still
# unknown -- MSYS2 tmux was already installed on both machines by then (via
# `winget install MSYS2.MSYS2` + `pacman -S tmux` on winbox-b, already
# present on winbox-a) and simply kept, since it needs no PowerShell-quoting
# special case at all and is the same send-keys/capture-pane code already
# trusted for container/host/root; see tmux_exec below.
# The shared key at /opt/aigw-ssh lets every aigw-backend@<user> reach them as
# the one shared account these two machines have -- same all-users-share-
# one-account model as media-cli's Open WebUI key (the deployment notes),
# not a new privilege boundary tied to any one aigw user.
SSH_CONFIG_PATH = "/opt/aigw-ssh/config"
# ControlMaster socket directory (see _ssh_run) -- world-writable+sticky like
# /tmp because different aigw-backend@<user> processes (different Unix users)
# each need to create their own socket here; namespaced by uid so one user's
# ssh multiplexing can't be reused (and can't be broken) by another's.
SSH_CONTROL_DIR = "/run/aigw-ssh-mux"
# Environment for every ssh/scp this backend runs (2026-10-08). OpenSSH runs
# ProxyJump's hop as `$SHELL -c 'exec ssh -W ...'`, and $SHELL here is the
# account's login shell (systemd sets it from passwd). For a self-signup
# account that has not set its password yet, that is adm-force-password-setup,
# which refuses every command -- so every ssh machine looked unreachable and
# the machine selector never appeared for that user. Only these ssh calls get
# a plain /bin/sh; the user's own shells (tmux panes) keep their login shell.
SSH_ENV = {**os.environ, "SHELL": "/bin/sh"}
SSH_MACHINES_CONFIG_PATH = "/etc/aigw/ssh_machines.json"
# Deployment-specific (which GPU/remote machines exist, at what paths), so
# this lives in a config file rather than a code literal -- see
# the deployment notes for why (this whole file is also published,
# minus this data, as part of haselab-net/aigw). Unlike WEBAUTHN_CONFIG_PATH
# in aigw-unlockd, nothing here is security-sensitive enough to warrant
# refusing to start over a missing/invalid file: a deployment with no
# remote machines to reach over ssh just has an empty SSH_MACHINES, and
# every ssh:<machine> preset/route simply has nothing to iterate over.
#
# Schema: {"<machine>": {"tmux": <abs path>, "bash": <abs path>,
# "claude": <abs path>, "claude_tui": <abs path, optional>, "drives":
# <bool, optional>}, ...}.
#   - "tmux"/"bash"/"claude" absolute, not bare names: a non-interactive
#     ssh command's PATH is not guaranteed to include the same directories
#     an interactive login shell would, and on Windows a bare "bash"/"tmux"
#     is ambiguous whenever more than one bash-like environment (MSYS2,
#     WSL, Cygwin, ...) is installed on the same machine.
#   - "claude_tui" overrides "claude" only for the interactive TUI presets
#     (claude-tui-<machine>/claude-login-<machine> -- see the SSH_MACHINES
#     loop below) -- for a machine that wants a wrapper around the real
#     binary there (a login notice, a startup shim, ...) without affecting
#     the one-shot machine-parsed calls (claude_auth_status_ssh/
#     claude_auth_logout_ssh) that still need the real binary's stdout to
#     be clean JSON/plain text.
#   - "drives" (default false): offers the drive+folder picker
#     (the deployment notes) on that machine's Claude preset -- set it
#     only for a Windows machine that exposes real drive letters, never
#     for a plain Linux box (no such concept there).
#   - "ssh_host" / "tmux_socket" / "start_task" (all optional, used
#     together): a *desktop variant* of a Windows machine -- an extra entry
#     (e.g. "winbox-b-desktop") that reaches the same ssh Host ("ssh_host",
#     default: the entry's own name) but drives a separate tmux server
#     (`tmux -L <tmux_socket>`) that runs in the logged-on user's
#     interactive Windows session (session 1) instead of the sshd service's
#     session 0, so whatever its panes start can see and drive desktop
#     apps. Being its own entry, it gets its own presets and its own row in
#     the machine picker for free -- that row *is* the "run on the desktop"
#     option. A tmux server is a child of whoever starts it, so this one
#     must never be started from ssh: "start_task" names an interactive
#     ("run only when user is logged on") Scheduled Task on that machine
#     that starts it (_ensure_desktop_tmux_server), and new-session refuses
#     rather than fall back to a session-0 server when that fails (nobody
#     logged on).
def _load_ssh_machines():
    try:
        with open(SSH_MACHINES_CONFIG_PATH) as f:
            raw = f.read()
    except OSError:
        print(f"[aigw-backend] {SSH_MACHINES_CONFIG_PATH} not found -- "
              "no ssh:<machine> presets configured", file=sys.stderr, flush=True)
        return {}
    try:
        return json.loads(raw)
    except json.JSONDecodeError as e:
        print(f"[aigw-backend] {SSH_MACHINES_CONFIG_PATH}: invalid JSON ({e}) -- "
              "no ssh:<machine> presets configured", file=sys.stderr, flush=True)
        return {}


SSH_MACHINES = _load_ssh_machines()

# A second sandbox container, separate from devbox-<user>, for material too
# sensitive to sit in ~/sandhome -- where every dependency an `npm install`
# drags into the dev container, and every agent running there, can read it.
# The motivating case is a mailbox (see that deployment's own notes), hence
# the default label, but nothing here is mail-specific.
#
# Deployment-specific, so it lives in a config file rather than in this
# file, exactly like SSH_MACHINES above: the container name and directory
# are one host's local arrangement, not something the published core should
# carry. Absent or malformed config, or a directory that is not there (a
# host that simply has no such sandbox), degrades to "no Email preset" --
# the same graceful degradation _load_ssh_machines chose, and for the same
# reason: this is a convenience feature, not a security boundary, so it
# fails quiet rather than refusing to start.
#
# What this IS load-bearing for: SESSION STATE LOCATION. See session_roots()
# -- a session started from this preset keeps its events.jsonl (and outbox/,
# inbox/) under <dir>/.aigw/ instead of ~/sandhome/.aigw/, so the chat log
# of what was read lands where only this sandbox can see it. Putting it in
# SESSIONS_DIR would hand the dev container the very thing the separate
# sandbox exists to keep away from it.
MAILBOX_CONFIG_PATH = "/etc/aigw/mailbox.json"


def _load_mailbox():
    try:
        with open(MAILBOX_CONFIG_PATH) as f:
            raw = f.read()
    except OSError:
        return None  # silent: most hosts have no second sandbox, that is normal
    try:
        cfg = json.loads(raw)
    except json.JSONDecodeError as e:
        print(f"[aigw-backend] {MAILBOX_CONFIG_PATH}: invalid JSON ({e}) -- "
              "no Email preset configured", file=sys.stderr, flush=True)
        return None
    name, directory = cfg.get("container_name"), cfg.get("dir")
    if not name or not directory:
        print(f"[aigw-backend] {MAILBOX_CONFIG_PATH}: needs both "
              '"container_name" and "dir" -- no Email preset configured',
              file=sys.stderr, flush=True)
        return None
    path = Path(directory)
    # "~/<name>" (2026-10-09): every user gets their own box under their own
    # home, created 0700 on first start, instead of only the one user whose
    # home an absolute `dir` happens to be in.
    if directory.startswith("~/") and directory[2:].strip("/"):
        path = HOME / directory[2:].strip("/")
        try:
            path.mkdir(mode=0o700, exist_ok=True)
        except OSError as e:
            print(f"[aigw-backend] {MAILBOX_CONFIG_PATH}: cannot create {path} ({e}) "
                  "-- no Email preset configured", file=sys.stderr, flush=True)
            return None
    # Must be under this user's own home: `sandbox new` enforces the same
    # rule itself and would reject anything else, so catching it here only
    # turns a confusing pane-death into a startup log line. Not a security
    # check -- the real one is in the sandbox CLI, which this cannot weaken.
    # The home check comes first and is pure path arithmetic: the config file
    # is host-wide, so every OTHER user's backend reads a `dir` inside
    # someone else's (0700) home, where is_dir() itself raises
    # PermissionError -- which crashed every other user's backend on
    # startup (2026-10-06).
    try:
        usable = HOME in path.parents and path.is_dir()
    except OSError:
        usable = False
    if not usable:
        print(f"[aigw-backend] {MAILBOX_CONFIG_PATH}: {path} is not a directory "
              "under this user's home -- no Email preset configured",
              file=sys.stderr, flush=True)
        return None
    return {"container_name": name, "dir": path, "label": cfg.get("label", "Email")}


MAILBOX = _load_mailbox()
# The second session-state root (see session_roots). None when no second
# sandbox is configured, which is the only case the rest of this file has to
# branch on.
MAIL_SESSIONS_DIR = (MAILBOX["dir"] / ".aigw") if MAILBOX else None


def _ssh_host(machine):
    """The ssh config Host to connect to for SSH_MACHINES entry `machine` --
    itself, unless it is a desktop variant ("ssh_host", see the schema
    comment above) sharing another entry's Host."""
    return SSH_MACHINES.get(machine, {}).get("ssh_host", machine)


def _tmux_socket_args(machine):
    sock = SSH_MACHINES.get(machine, {}).get("tmux_socket")
    return ["-L", sock] if sock else []


def _ssh_run(machine, remote_argv, timeout=15, redirect_devnull=False, connect_timeout=10):
    """Runs `ssh <machine> <remote_argv...>` via the shared /opt/aigw-ssh
    config.

    UNLIKE a local subprocess.run(argv) call, argv elements handed to ssh as
    separate arguments do NOT arrive at the far end as separate tokens: ssh
    joins every trailing argument with a single space into one string and
    hands THAT to the remote machine's shell (a real bash, on both these
    machines) for its own parsing -- so an unquoted "#S" is a bash comment
    marker (silently truncating the rest of the line), an unquoted "$PID" is
    a bash variable reference (silently expanding to "", since no such
    variable exists), and an unquoted multi-word string is re-split back into
    several words at every space. All three were measured 2026-08-14 as the
    actual cause of what first looked like a psmux (github.com/psmux/psmux)
    text-corruption bug -- switching to real MSYS2 tmux (see the SSH_MACHINES
    comment) did not fix it on its own, because the bug was here, one hop
    earlier, not in whichever program received the (by then already-mangled)
    text. shlex.quote()-ing every element before joining, exactly once here,
    is what actually fixes it -- every other function in this file builds
    `remote_argv` as an ordinary Python list, same as any local subprocess
    call, and never needs to know this quoting happens.

    ControlMaster/ControlPersist turns every call after the first into a
    reused, already-authenticated connection instead of a fresh double-hop
    (via the shared jump host) TCP+SSH handshake -- without it, polling a
    pane's contents every 0.3s (_watch_tmux_session) would be both far too
    slow and a lot of unwanted new connections against that jump host.

    Never raises: subprocess.run's own TimeoutExpired/OSError are caught here
    and turned into a synthetic failed CompletedProcess (returncode 1) that
    every caller already knows how to handle, since they already check
    `r.returncode != 0` the same way they would for a normal ssh failure.
    Without this, a slow/cold connection crashed the whole request with an
    uncaught exception and NO response at all -- measured 2026-08-14 on
    winbox-a's tmux server forking for the first time in a while (see
    tmux_exec's own extended timeout for "new-session" below): the client
    saw nothing happen for 15s, then nothing at all (no error, no success),
    because create_session's tmux_exec calls had never needed to expect an
    exception before ssh: locations existed. The remote command commonly
    keeps running and succeeds anyway even after this local timeout (this is
    exactly what the "new-session" cold-fork case looks like), so a caller
    that retries can end up with an orphaned tmux session/aigw meta.json from
    the first attempt -- a real but separate cleanup concern from this
    function's own job, which is only to never crash its caller."""
    remote_cmd = " ".join(shlex.quote(a) for a in remote_argv)
    if redirect_devnull:
        # See tmux_exec's "new-session" case: redirecting these away BEFORE
        # tmux forks a server is what stops that server (which inherits
        # them) from holding this ssh call's pipes open forever. Appended
        # after quoting, as raw shell syntax -- these three tokens are ours,
        # never derived from remote_argv/user input.
        remote_cmd += " </dev/null >/dev/null 2>&1"
    return _ssh_invoke(machine, remote_cmd, timeout=timeout, connect_timeout=connect_timeout)


def _ssh_invoke(machine, remote_cmd, timeout=15, text=True, connect_timeout=10):
    """Low-level half of _ssh_run: runs `ssh <machine> <remote_cmd>` where
    remote_cmd is already a complete, ready-to-execute shell command string
    (never raises, same synthetic-CompletedProcess-on-failure contract as
    _ssh_run -- see its docstring).

    _ssh_run builds remote_cmd by shlex.quote()-ing every argv element,
    which is the right default (arbitrary text can't smuggle in shell
    syntax) but also means it can never itself use shell features like `~`
    or glob expansion -- those need an unquoted string. Callers that want
    that (see claude_project_dir_key/_ssh_list_jsonl/_ssh_read_new below)
    build remote_cmd by hand and come straight here instead of through
    _ssh_run, and are responsible for only interpolating values that are
    already known-safe to place unquoted in a shell command (in practice:
    values sanitized down to [A-Za-z0-9-] first, never raw paths/input).

    text=False returns raw bytes in stdout/stderr instead of str -- for
    reading a slice of someone's actual conversation log, which is UTF-8
    but not guaranteed to end on a full multi-byte character at whatever
    byte offset a `tail -c` cut it at; the caller decodes once it has
    buffered up to the next newline, same as the local-file tailers already
    do for their own `.open("rb")` reads."""
    control_path = f"{SSH_CONTROL_DIR}/{os.getuid()}-%r@%h:%p"
    ssh_argv = ["ssh", "-F", SSH_CONFIG_PATH,
                "-o", f"ControlPath={control_path}", "-o", "ControlMaster=auto", "-o", "ControlPersist=10m",
                "-o", f"ConnectTimeout={connect_timeout}", _ssh_host(machine), remote_cmd]
    try:
        return subprocess.run(ssh_argv, capture_output=True, text=text, timeout=timeout, env=SSH_ENV)
    except subprocess.TimeoutExpired:
        msg = f"ssh to {machine} timed out after {timeout}s (it may still be starting up -- try again in a moment)"
        empty, msg = (b"", msg.encode()) if not text else ("", msg)
        return subprocess.CompletedProcess(ssh_argv, 1, empty, msg)
    except OSError as e:
        msg = f"could not reach {machine}: {e}"
        empty, msg = (b"", msg.encode()) if not text else ("", msg)
        return subprocess.CompletedProcess(ssh_argv, 1, empty, msg)


# ssh_reachable() runs on every session-list page load and poll (GET
# /capabilities, list_untracked_tmux_sessions), not just once per genuine
# session start -- so unlike a real command's timeout, its own connect
# timeout should favor a fast "not here right now" over patience: a machine
# that's merely asleep and about to answer will just report unreachable for
# one poll and reachable on the next (which happen every few seconds anyway)
# rather than making every poll pay a long, uniform wait. The 240s patience
# for a genuine cold session start lives entirely in
# SSH_NEW_SESSION_POLL_TIMEOUT instead. See the deployment notes.
SSH_REACHABLE_CONNECT_TIMEOUT = 3
# How long a reachability result is trusted before re-checking -- a machine
# being on or off doesn't flip on sub-10-second timescales in practice, so
# this turns "every poll from every open tab pays its own SSH round trip"
# into "one real probe per machine per this window, everyone else reads the
# cache" (2026-08-23, see the deployment notes).
SSH_REACHABLE_CACHE_TTL = 10
_ssh_reachable_cache = {}  # machine -> (checked_at, bool)
_ssh_reachable_cache_lock = threading.Lock()


def ssh_reachable(machine):
    """Live probe -- same 'if it says yes it will work' philosophy as
    root_shell_allowed(), but the gate here is network reachability through a
    shared key rather than a per-user systemd unit. Cheap once the
    ControlMaster connection is warm; the first call after a while pays a
    (deliberately short, see SSH_REACHABLE_CONNECT_TIMEOUT) fresh handshake,
    cached for SSH_REACHABLE_CACHE_TTL so a burst of callers within that
    window shares one probe."""
    now = time.time()
    with _ssh_reachable_cache_lock:
        cached = _ssh_reachable_cache.get(machine)
        if cached is not None and now - cached[0] < SSH_REACHABLE_CACHE_TTL:
            return cached[1]
    try:
        r = _ssh_run(machine, ["true"], timeout=SSH_REACHABLE_CONNECT_TIMEOUT + 2,
                     connect_timeout=SSH_REACHABLE_CONNECT_TIMEOUT)
        result = r.returncode == 0
    except (subprocess.TimeoutExpired, OSError):
        result = False
    with _ssh_reachable_cache_lock:
        _ssh_reachable_cache[machine] = (now, result)
    return result


def reachable_ssh_machines():
    """SSH_MACHINES currently reachable, probed in parallel -- for GET
    /capabilities, which (unlike list_untracked_tmux_sessions, which already
    threads its own per-machine work) used to check each machine in
    sequence. With ssh_reachable()'s own cache this only matters on a cache
    miss, but a miss should still cost one machine's connect timeout, not
    the sum of both."""
    results = {}

    def _check(machine):
        results[machine] = ssh_reachable(machine)

    threads = [threading.Thread(target=_check, args=(machine,)) for machine in SSH_MACHINES]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    return [m for m in SSH_MACHINES if results[m]]


