#!/opt/aigw/venv/bin/python3
"""
Per-user backend for the "aigw" mobile AI control panel.

Runs as the target Unix user (systemd `User=%i` in aigw-backend@.service, one
instance per host user, started on demand by aigw-backend-proxy@<port>.socket
-- see the deployment notes). Binds an AF_UNIX socket at
BACKEND_SOCKET_PATH, not a loopback TCP port (the deployment notes, 2026-08-30
revision 2): loopback TCP has no per-uid access control on Linux, so a
127.0.0.1 port -- despite the docstring this one used to have -- was
reachable by ANY local user on this host, not just aigw-gateway. A
Unix-domain socket has real filesystem permissions instead: this one is
mode 0600, owned by this user alone, so the only things that can ever
connect are this user's own processes and root -- and the only root process
that ever does is aigw-proxy-handler, relaying a connection that already
passed through aigw-backend-proxy@<port>.socket's own, separately
permissioned AF_UNIX socket (owner "aigw", mode 0600 -- see that unit).
There is deliberately no group "aigw" anywhere in this: an earlier revision
of this fix chmod'd this socket group "aigw" and had aigw-gateway connect to
it directly, which meant giving aigw-gateway a `systemctl start
aigw-backend@<user>` sudo rule to wake a stopped one -- rejected on review
(the deployment notes: the privileged side, not its caller, must
be the authorization boundary; a wildcard `aigw-backend@*.service` rule put
that boundary in aigw-gateway's own username-validation code instead, one
bug away from `aigw-backend@root.service` actually starting as root). Root
already owns that boundary today -- aigw-backend-proxy@.service has no
`User=` line, so it runs as root already, and always has -- so keeping the
existing activation relay and just swapping its transport closes the same
hole without moving who is trusted to start a backend at all.

A "session" runs inside this user's own devbox-<user> container, driven
entirely through the existing `sandbox` command (never raw docker) -- so this
process needs no privilege beyond what the human user already has. Two kinds:
Claude Code is driven headlessly (`claude -p ... --output-format stream-json
--resume <id>`, one subprocess per message -- its interactive TUI is a
fullscreen, cursor-redrawing app that doesn't fit an append-only chat log at
all, so we never launch it interactively); everything else (a plain shell
today, any future AI CLI without its own headless mode -- including someone
just running `claude` interactively *inside* that shell, which hits the exact
same fullscreen-redraw problem headless mode exists to avoid) runs in a real
tmux pane instead, polled via `tmux capture-pane` rather than tailed as a raw
byte stream (see _watch_tmux_session) -- that's what makes an interactively-
run fullscreen program show up as legible text instead of garbage, whether
the pane was one this backend created (the "shell" preset) or one a user
started by hand and later pointed this backend at (the "attach" preset, see
adopt_session).

Conversation state lives under $HOME/sandhome/.aigw/<session-id>/, which is
bind-mounted at the same absolute path inside the container, so any process
inside the container (an AI CLI, or a plain script) can drop files in
outbox/ to have them shown as attachments, without this process ever needing
to `docker exec` just to read them back out.
"""
import base64
import difflib
import getpass
import json
import mimetypes
import os
import pwd
import queue
import re
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request
import uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse, parse_qs

HOME = Path.home()
# This host's own public DNS name, for the one place it's needed below (a
# mailto: contact address in the VAPID claims Web Push requires) --
# generic, since there's nothing security-sensitive riding on getting this
# exactly right the way there is for aigw-gateway's own OAuth redirect URI.
PUBLIC_HOST = socket.getfqdn()
# Bind-mounted into devbox-<user> at this same absolute path, and is $HOME
# inside the container -- which is what lets this process both read the
# container's Claude Code state (see claude_project_dir) and name a working
# directory that means the same thing on either side (see resolve_workdir).
SANDHOME = HOME / "sandhome"
SESSIONS_DIR = SANDHOME / ".aigw"
STATE_DIR = HOME / ".aigw-state"
VAPID_PRIVATE_KEY_FILE = "/etc/aigw/vapid_private.pem"
VAPID_SUB_FILE = "/etc/aigw/vapid_sub.txt"

# Absolute paths, never a bare "claude": the host-side commands run under
# systemd's own minimal PATH (no ~/.local/bin, no login-shell profile
# sourcing), and the root-side ones run in a pane whose PATH is whatever the
# root tmux server inherited. A host-shell/root-shell pane gets away with
# plain `claude` only because it runs `bash -l`.
HOST_CLAUDE_BIN = str(HOME / ".local/bin/claude")
ROOT_CLAUDE_BIN = "/root/.local/bin/claude"

SESSION_ID_RE = re.compile(r"^[a-f0-9]{8,32}$")
OUTBOX_NAME_RE = re.compile(r"^[A-Za-z0-9._-]{1,200}$")

# Strips ANSI/terminal control sequences from raw tmux pane output. We are a
# chat-bubble UI, not a terminal emulator (xterm.js), so escape codes (color,
# bracketed-paste-mode toggles, cursor movement, etc.) would otherwise show
# up as literal garbage text.
_ANSI_RE = re.compile(r"\x1b(?:\[[0-9;?]*[a-zA-Z]|\][^\x07]*(?:\x07|\x1b\\)|[@-_])")


def clean_terminal_text(text):
    text = _ANSI_RE.sub("", text)
    return text.replace("\r\n", "\n").replace("\r", "\n")

# "claude" is handled specially (see _run_claude_headless_turn): it ships a
# fullscreen, cursor-redrawing TUI (like vim) plus its own API built for
# programmatic, turn-by-turn driving instead of a live pane -- Claude Code's
# headless "print mode" (`-p` + `--output-format stream-json` +
# `--resume <id>`). Every other preset uses a real tmux pane, watched via
# _watch_tmux_session's capture-pane polling -- which, unlike raw pipe-pane
# byte tailing, handles a fullscreen redrawing program just fine too (so
# someone running `claude` interactively *inside* a "shell" preset session
# still gets legible text, not garbage).
#
# (A "codewhale" preset -- one persistent `codewhale app-server --http` per
# user, driven over that tool's own HTTP/SSE runtime API -- lived here until
# 2026-08-01, when it was removed as unused at the user's request.)
#
# Each tmux preset says *where* its pane lives, extending the
# "container"/"host" split adopt_session already had (see tmux_exec) with a
# third location, "root":
#
#   container - inside the user's own devbox-<user>, via `sandbox exec`.
#   host      - this host itself, in that user's own tmux server. Crosses no
#               new privilege boundary: aigw-backend@<user>.service is
#               already `User=%i`, so it can already run anything that
#               user's own SSH shell could, and "attach" has been driving
#               host-side panes since 2026-07-31. NOT sandboxed though --
#               the pane sees the user's real $HOME.
#   root      - this host itself, as root, in a tmux server that is NOT ours:
#               it belongs to aigw-root-tmux@<user>.service, runs as root,
#               and every pane it creates runs as root. We reach it as an
#               ordinary tmux client over its socket.
#
# Unlike the other two, "root" grants more than this user's own rights, and
# deliberately so: the alternative -- typing a sudo password into the chat --
# would persist the password in plaintext in events.jsonl, which is mounted
# read-write into the container.
#
# Note what is NOT here: any sudo call, or any root-side program this process
# passes arguments to. The privilege is granted entirely out of band, by an
# administrator enabling aigw-root-tmux@<user>.service, and is expressed as
# "this Unix user may talk to that already-running root tmux server" -- via
# 0700/0600 filesystem permissions plus tmux's own `server-access` ACL, both
# enforced by code that never sees anything we send. If the unit is not
# enabled for this user, the socket simply is not there. See the
# "root-shell" section of the deployment notes.

# GPU machines reachable over SSH via a shared jump host (see
# /opt/aigw-ssh and the deployment notes). Both are actually Windows
# boxes; each runs psmux (github.com/psmux/psmux, winget id marlocarlo.psmux)
# instead of tmux -- a separate binary that speaks the same CLI (new-session/
# send-keys/capture-pane/list-sessions/kill-session/set-option/respawn-pane
# real MSYS2 tmux on both -- NOT psmux (github.com/psmux/psmux), tried first
# (2026-08-14) since winbox-b had no MSYS2 at the time. psmux was dropped
# after real-machine testing *seemed* to show `send-keys -l` corrupting
# literal text (dropping spaces, and "$" plus everything after it in the same
# word) and claude.exe's TUI refusing to start under it -- but the actual
# root cause, found only after also installing MSYS2's tmux on winbox-a and
# seeing the exact same symptom there, was a bug in THIS file's own
# `_ssh_run` (fixed same-day, see its docstring): unquoted text sent over ssh
# gets word-split and $-expanded by the remote bash before psmux or tmux ever
# see it, which explains every one of those symptoms without psmux being at
# fault at all. The claude.exe TUI-launch failure specifically was not
# re-tested against psmux after the _ssh_run fix, so whether that one was
# also just the quoting bug or a genuine psmux/ConPTY limitation is still
# unknown -- MSYS2 tmux was already installed on both machines by then (via
# `winget install MSYS2.MSYS2` + `pacman -S tmux` on winbox-b, already
# present on winbox-a) and simply kept, since it needs no PowerShell-quoting
# special case at all and is the same send-keys/capture-pane code already
# trusted for container/host/root; see tmux_exec below.
# The shared key at /opt/aigw-ssh lets every aigw-backend@<user> reach them as
# the one shared account these two machines have -- same all-users-share-
# one-account model as media-cli's Open WebUI key (the deployment notes),
# not a new privilege boundary tied to any one aigw user.
SSH_CONFIG_PATH = "/opt/aigw-ssh/config"
# ControlMaster socket directory (see _ssh_run) -- world-writable+sticky like
# /tmp because different aigw-backend@<user> processes (different Unix users)
# each need to create their own socket here; namespaced by uid so one user's
# ssh multiplexing can't be reused (and can't be broken) by another's.
SSH_CONTROL_DIR = "/run/aigw-ssh-mux"
SSH_MACHINES_CONFIG_PATH = "/etc/aigw/ssh_machines.json"
# Deployment-specific (which GPU/remote machines exist, at what paths), so
# this lives in a config file rather than a code literal -- see
# the deployment notes for why (this whole file is also published,
# minus this data, as part of haselab-net/aigw). Unlike WEBAUTHN_CONFIG_PATH
# in aigw-unlockd, nothing here is security-sensitive enough to warrant
# refusing to start over a missing/invalid file: a deployment with no
# remote machines to reach over ssh just has an empty SSH_MACHINES, and
# every ssh:<machine> preset/route simply has nothing to iterate over.
#
# Schema: {"<machine>": {"tmux": <abs path>, "bash": <abs path>,
# "claude": <abs path>, "claude_tui": <abs path, optional>, "drives":
# <bool, optional>}, ...}.
#   - "tmux"/"bash"/"claude" absolute, not bare names: a non-interactive
#     ssh command's PATH is not guaranteed to include the same directories
#     an interactive login shell would, and on Windows a bare "bash"/"tmux"
#     is ambiguous whenever more than one bash-like environment (MSYS2,
#     WSL, Cygwin, ...) is installed on the same machine.
#   - "claude_tui" overrides "claude" only for the interactive TUI presets
#     (claude-tui-<machine>/claude-login-<machine> -- see the SSH_MACHINES
#     loop below) -- for a machine that wants a wrapper around the real
#     binary there (a login notice, a startup shim, ...) without affecting
#     the one-shot machine-parsed calls (claude_auth_status_ssh/
#     claude_auth_logout_ssh) that still need the real binary's stdout to
#     be clean JSON/plain text.
#   - "drives" (default false): offers the drive+folder picker
#     (the deployment notes) on that machine's Claude preset -- set it
#     only for a Windows machine that exposes real drive letters, never
#     for a plain Linux box (no such concept there).
def _load_ssh_machines():
    try:
        with open(SSH_MACHINES_CONFIG_PATH) as f:
            raw = f.read()
    except OSError:
        print(f"[aigw-backend] {SSH_MACHINES_CONFIG_PATH} not found -- "
              "no ssh:<machine> presets configured", file=sys.stderr, flush=True)
        return {}
    try:
        return json.loads(raw)
    except json.JSONDecodeError as e:
        print(f"[aigw-backend] {SSH_MACHINES_CONFIG_PATH}: invalid JSON ({e}) -- "
              "no ssh:<machine> presets configured", file=sys.stderr, flush=True)
        return {}


SSH_MACHINES = _load_ssh_machines()


def _ssh_run(machine, remote_argv, timeout=15, redirect_devnull=False, connect_timeout=10):
    """Runs `ssh <machine> <remote_argv...>` via the shared /opt/aigw-ssh
    config.

    UNLIKE a local subprocess.run(argv) call, argv elements handed to ssh as
    separate arguments do NOT arrive at the far end as separate tokens: ssh
    joins every trailing argument with a single space into one string and
    hands THAT to the remote machine's shell (a real bash, on both these
    machines) for its own parsing -- so an unquoted "#S" is a bash comment
    marker (silently truncating the rest of the line), an unquoted "$PID" is
    a bash variable reference (silently expanding to "", since no such
    variable exists), and an unquoted multi-word string is re-split back into
    several words at every space. All three were measured 2026-08-14 as the
    actual cause of what first looked like a psmux (github.com/psmux/psmux)
    text-corruption bug -- switching to real MSYS2 tmux (see the SSH_MACHINES
    comment) did not fix it on its own, because the bug was here, one hop
    earlier, not in whichever program received the (by then already-mangled)
    text. shlex.quote()-ing every element before joining, exactly once here,
    is what actually fixes it -- every other function in this file builds
    `remote_argv` as an ordinary Python list, same as any local subprocess
    call, and never needs to know this quoting happens.

    ControlMaster/ControlPersist turns every call after the first into a
    reused, already-authenticated connection instead of a fresh double-hop
    (via the shared jump host) TCP+SSH handshake -- without it, polling a
    pane's contents every 0.3s (_watch_tmux_session) would be both far too
    slow and a lot of unwanted new connections against that jump host.

    Never raises: subprocess.run's own TimeoutExpired/OSError are caught here
    and turned into a synthetic failed CompletedProcess (returncode 1) that
    every caller already knows how to handle, since they already check
    `r.returncode != 0` the same way they would for a normal ssh failure.
    Without this, a slow/cold connection crashed the whole request with an
    uncaught exception and NO response at all -- measured 2026-08-14 on
    winbox-a's tmux server forking for the first time in a while (see
    tmux_exec's own extended timeout for "new-session" below): the client
    saw nothing happen for 15s, then nothing at all (no error, no success),
    because create_session's tmux_exec calls had never needed to expect an
    exception before ssh: locations existed. The remote command commonly
    keeps running and succeeds anyway even after this local timeout (this is
    exactly what the "new-session" cold-fork case looks like), so a caller
    that retries can end up with an orphaned tmux session/aigw meta.json from
    the first attempt -- a real but separate cleanup concern from this
    function's own job, which is only to never crash its caller."""
    remote_cmd = " ".join(shlex.quote(a) for a in remote_argv)
    if redirect_devnull:
        # See tmux_exec's "new-session" case: redirecting these away BEFORE
        # tmux forks a server is what stops that server (which inherits
        # them) from holding this ssh call's pipes open forever. Appended
        # after quoting, as raw shell syntax -- these three tokens are ours,
        # never derived from remote_argv/user input.
        remote_cmd += " </dev/null >/dev/null 2>&1"
    return _ssh_invoke(machine, remote_cmd, timeout=timeout, connect_timeout=connect_timeout)


def _ssh_invoke(machine, remote_cmd, timeout=15, text=True, connect_timeout=10):
    """Low-level half of _ssh_run: runs `ssh <machine> <remote_cmd>` where
    remote_cmd is already a complete, ready-to-execute shell command string
    (never raises, same synthetic-CompletedProcess-on-failure contract as
    _ssh_run -- see its docstring).

    _ssh_run builds remote_cmd by shlex.quote()-ing every argv element,
    which is the right default (arbitrary text can't smuggle in shell
    syntax) but also means it can never itself use shell features like `~`
    or glob expansion -- those need an unquoted string. Callers that want
    that (see claude_project_dir_key/_ssh_list_jsonl/_ssh_read_new below)
    build remote_cmd by hand and come straight here instead of through
    _ssh_run, and are responsible for only interpolating values that are
    already known-safe to place unquoted in a shell command (in practice:
    values sanitized down to [A-Za-z0-9-] first, never raw paths/input).

    text=False returns raw bytes in stdout/stderr instead of str -- for
    reading a slice of someone's actual conversation log, which is UTF-8
    but not guaranteed to end on a full multi-byte character at whatever
    byte offset a `tail -c` cut it at; the caller decodes once it has
    buffered up to the next newline, same as the local-file tailers already
    do for their own `.open("rb")` reads."""
    control_path = f"{SSH_CONTROL_DIR}/{os.getuid()}-%r@%h:%p"
    ssh_argv = ["ssh", "-F", SSH_CONFIG_PATH,
                "-o", f"ControlPath={control_path}", "-o", "ControlMaster=auto", "-o", "ControlPersist=10m",
                "-o", f"ConnectTimeout={connect_timeout}", machine, remote_cmd]
    try:
        return subprocess.run(ssh_argv, capture_output=True, text=text, timeout=timeout)
    except subprocess.TimeoutExpired:
        msg = f"ssh to {machine} timed out after {timeout}s (it may still be starting up -- try again in a moment)"
        empty, msg = (b"", msg.encode()) if not text else ("", msg)
        return subprocess.CompletedProcess(ssh_argv, 1, empty, msg)
    except OSError as e:
        msg = f"could not reach {machine}: {e}"
        empty, msg = (b"", msg.encode()) if not text else ("", msg)
        return subprocess.CompletedProcess(ssh_argv, 1, empty, msg)


# ssh_reachable() runs on every session-list page load and poll (GET
# /capabilities, list_untracked_tmux_sessions), not just once per genuine
# session start -- so unlike a real command's timeout, its own connect
# timeout should favor a fast "not here right now" over patience: a machine
# that's merely asleep and about to answer will just report unreachable for
# one poll and reachable on the next (which happen every few seconds anyway)
# rather than making every poll pay a long, uniform wait. The 240s patience
# for a genuine cold session start lives entirely in
# SSH_NEW_SESSION_POLL_TIMEOUT instead. See the deployment notes.
SSH_REACHABLE_CONNECT_TIMEOUT = 3
# How long a reachability result is trusted before re-checking -- a machine
# being on or off doesn't flip on sub-10-second timescales in practice, so
# this turns "every poll from every open tab pays its own SSH round trip"
# into "one real probe per machine per this window, everyone else reads the
# cache" (2026-08-23, see the deployment notes).
SSH_REACHABLE_CACHE_TTL = 10
_ssh_reachable_cache = {}  # machine -> (checked_at, bool)
_ssh_reachable_cache_lock = threading.Lock()


def ssh_reachable(machine):
    """Live probe -- same 'if it says yes it will work' philosophy as
    root_shell_allowed(), but the gate here is network reachability through a
    shared key rather than a per-user systemd unit. Cheap once the
    ControlMaster connection is warm; the first call after a while pays a
    (deliberately short, see SSH_REACHABLE_CONNECT_TIMEOUT) fresh handshake,
    cached for SSH_REACHABLE_CACHE_TTL so a burst of callers within that
    window shares one probe."""
    now = time.time()
    with _ssh_reachable_cache_lock:
        cached = _ssh_reachable_cache.get(machine)
        if cached is not None and now - cached[0] < SSH_REACHABLE_CACHE_TTL:
            return cached[1]
    try:
        r = _ssh_run(machine, ["true"], timeout=SSH_REACHABLE_CONNECT_TIMEOUT + 2,
                     connect_timeout=SSH_REACHABLE_CONNECT_TIMEOUT)
        result = r.returncode == 0
    except (subprocess.TimeoutExpired, OSError):
        result = False
    with _ssh_reachable_cache_lock:
        _ssh_reachable_cache[machine] = (now, result)
    return result


def reachable_ssh_machines():
    """SSH_MACHINES currently reachable, probed in parallel -- for GET
    /capabilities, which (unlike list_untracked_tmux_sessions, which already
    threads its own per-machine work) used to check each machine in
    sequence. With ssh_reachable()'s own cache this only matters on a cache
    miss, but a miss should still cost one machine's connect timeout, not
    the sum of both."""
    results = {}

    def _check(machine):
        results[machine] = ssh_reachable(machine)

    threads = [threading.Thread(target=_check, args=(machine,)) for machine in SSH_MACHINES]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    return [m for m in SSH_MACHINES if results[m]]


TMUX_PRESETS = {
    "shell": {"command": ["bash", "-l"], "location": "container"},
    "host-shell": {"command": ["bash", "-l"], "location": "host"},
    # HOME/USER/LOGNAME are set explicitly because the tmux client that asks
    # for this pane runs as the ordinary user -- the pane itself is root's,
    # and should look like it.
    "root-shell": {"command": ["bash", "-l"], "location": "root",
                   "env": ["HOME=/root", "USER=root", "LOGNAME=root"], "cwd": "/root"},
    # Not in the preset dropdown -- started by the login button (POST
    # /claude-auth/login). `claude auth login` prints a URL and waits for the
    # code to be pasted back, so unlike `auth status`/`auth logout` it can't
    # be a one-shot `sandbox exec`; it needs a real pane, and gets driven
    # from the ordinary chat view with the soft keyboard like any shell.
    # No special width: keeping the ~380-character OAuth URL on one line is
    # the watcher's job now, via `capture-pane -J` (see _watch_tmux_session)
    # -- a pane width cannot do it, because a tmux server with an attached
    # client sizes panes to that client regardless of -x.
    "claude-login": {"command": ["claude", "auth", "login"], "location": "container"},
    # The same flow for the other two places a Claude Code can be logged in
    # (see claude_auth_status_all / the deployment notes). Same shape, different
    # tmux server -- and no new privilege either way: "host" is this
    # service's own user, and "root" is the root tmux server that root-shell
    # already talks to, gated on the same root_shell_allowed(). Absolute
    # paths because these panes are not `bash -l` and have no
    # profile-provided PATH (see HOST_CLAUDE_BIN).
    "claude-login-host": {"command": [HOST_CLAUDE_BIN, "auth", "login"], "location": "host"},
    "claude-login-root": {"command": [ROOT_CLAUDE_BIN, "auth", "login"], "location": "root",
                          "env": ["HOME=/root", "USER=root", "LOGNAME=root"], "cwd": "/root"},
    # Claude Code's own interactive TUI, as opposed to the headless "claude"
    # preset. Viable only since the screen panel exists (see _latest_screen):
    # its selection menus redraw in place, which an append-only chat log
    # cannot show, so before that there was no way to see which option the
    # cursor was on. `--remote-control` is here and NOT on the headless
    # preset because it only takes effect on an interactive session -- with
    # `-p` it is accepted and silently ignored (measured 2026-08-02: a run
    # with it and one without were indistinguishable in `claude agents`, and
    # the name given was not used). A pane started this way is reachable both
    # from this chat and from claude.ai/code and the mobile app.
    # 100 columns rather than the 220 default: the TUI lays itself out to the
    # pane width, and 220 would force constant horizontal scrolling in the
    # screen panel on a phone.
    "claude-tui": {"command": ["claude"], "location": "container",
                   "width": 100, "remote_control": True},
}
# One shell + one Claude-TUI + one claude-auth-login preset per SSH_MACHINES
# entry, generated rather than hand-written per machine so a third machine is
# one SSH_MACHINES entry, not six more of these. No AIGW_OUTBOX for any of
# these: these machines share no filesystem with this host (unlike the
# container, which is bind-mounted), so there is nowhere for an outbox file
# to land. No resume either -- Claude Code's own conversation history for
# these lives on the remote machine's filesystem, which this process has no
# way to read except through a live shell into it. cwd is the one exception,
# and only for the Claude preset on a machine whose SSH_MACHINES entry sets
# "drives": True (winbox-a/winbox-b, not linuxbox) -- see CWD_PRESETS below
# and resolve_ssh_workdir (the deployment notes).
for _machine, _cfg in SSH_MACHINES.items():
    TMUX_PRESETS[f"shell-{_machine}"] = {"command": [_cfg["bash"], "-l"], "location": f"ssh:{_machine}"}
    # An interactive pane wants "claude_tui" when a machine defines one (see
    # linuxbox's own entry above) -- a wrapper around the real "claude" for
    # that machine, never the other way around. claude_auth_status_ssh/
    # claude_auth_logout_ssh below always use "claude" directly, since those
    # are one-shot machine-parsed calls a wrapper's extra stdout would break.
    _tui_claude = _cfg.get("claude_tui", _cfg["claude"])
    TMUX_PRESETS[f"claude-tui-{_machine}"] = {
        "command": [_tui_claude], "location": f"ssh:{_machine}",
        "width": 100, "remote_control": True,
    }
    TMUX_PRESETS[f"claude-login-{_machine}"] = {
        "command": [_tui_claude, "auth", "login"], "location": f"ssh:{_machine}",
    }
del _machine, _cfg, _tui_claude

# Every preset that runs Claude Code's interactive TUI (as opposed to a plain
# shell) -- one local, one per SSH machine. Anywhere the local code checked
# for the literal "claude-tui" (skip_permissions, _accept_workspace_trust_if_
# shown), it now checks membership in this set instead, so a new SSH_MACHINES
# entry doesn't also need a matching change scattered through create_session.
CLAUDE_TUI_PRESETS = {"claude-tui", *(f"claude-tui-{m}" for m in SSH_MACHINES)}

# The ssh: counterpart of "shell"/"host-shell"/"root-shell": a plain
# interactive shell on a machine's own tmux, with no `claude` involved until
# the user types it by hand. Kept as its own set (mirroring CLAUDE_TUI_
# PRESETS above) rather than a name pattern check, same reasoning -- a new
# SSH_MACHINES entry should not need a matching change scattered through
# create_session (the deployment notes).
SSH_SHELL_PRESETS = {f"shell-{m}" for m in SSH_MACHINES}

PRESETS = {"claude": None, **TMUX_PRESETS}
HEADLESS_PRESETS = {"claude"}

# Presets that take a working directory (~/sandhome-relative, see
# resolve_workdir) and an optional conversation to resume (resolve_resume_id).
# Both run Claude Code, so both care which project directory they start in and
# both accept `--resume <id>`; the plain shells do not. A drives-capable ssh
# machine's Claude preset (claude-tui-<machine>, the deployment notes)
# also takes a cwd -- resolved by resolve_ssh_workdir instead, against that
# machine's own drives/folders rather than ~/sandhome -- but deliberately
# never a resume; create_session checks that case separately, not by adding
# claude-tui-<machine> to this set.
#
# "claude" is no longer offered in the preset dropdown (2026-08-02, at the
# user's request -- the interactive TUI does everything it did, plus selection
# menus and Remote Control). It stays here, and in PRESETS, because sessions
# created before that removal must keep working: they still render, still
# accept messages, and still resume their own conversation.
CWD_PRESETS = {"claude", "claude-tui"}

ROOT_TMUX_SOCKET = f"/run/aigw-root-tmux/{getpass.getuser()}/sock"


def root_shell_allowed():
    """Whether this user has a root tmux server to talk to -- i.e. whether an
    administrator has enabled aigw-root-tmux@<user>.service for them. Being
    able to open the socket IS the permission, so this is both what the UI
    keys off and an honest answer: if it says yes, the button will work.

    Needs NO change for Phase 2b (the design notes): this still just
    reads whether the socket is there and this user can reach it. Under
    Phase 2a, aigw-unlockd is what makes that socket exist at all (running
    `systemctl start aigw-root-tmux@<user>` only inside an open unlock
    window) -- root_shell_allowed() staying a dumb os.access() check is
    exactly the point: the kernel-layer boundary (the design notes' table) is enforced
    entirely by unlockd/systemd, never by this function pretending to know
    about unlock state. What Phase 2b actually adds is the *application*
    layer half of that same table -- see require_unlock_if_outside_sandbox()
    below -- which is a separate, additional check, not a replacement for
    this one."""
    return os.access(ROOT_TMUX_SOCKET, os.R_OK | os.W_OK)


# ---------------------------------------------------------------------------
# Phase 2b: the application-layer passkey/unlock gate (the design notes
# the design notes, the design notes, the design notes). aigw-unlockd (root, the unlock daemon's own source tree) is the
# ONLY thing that ever decides whether a WebAuthn ceremony succeeded or
# whether a 15-minute unlock window is open -- this process talks to it over
# a plain Unix socket and, per the design notes' "gateway/backend は不透明なバイト
# 列を中継するだけ", never re-implements or second-guesses that verdict. See
# UnlockRequired below for why a bespoke exception type carries that verdict
# through this file's route handlers instead of ValueError/RuntimeError.
# ---------------------------------------------------------------------------
UNLOCKD_SOCK_PATH = "/run/aigw-unlockd.sock"
# Generous enough that a briefly slow root-owned daemon (first request after
# boot, a `_reconcile_orphaned_units()` sweep still running, see the unlock daemon's own
# the design notes) doesn't misfire as "unreachable", but short enough that a hung or
# deadlocked unlockd cannot make every host/root action on this backend hang
# right along with it -- see the module docstring's "fail closed on every
# kind of transport trouble" note on _unlockd_call below: whatever this
# timeout is, expiring it must mean "treat as locked", never "wait forever".
UNLOCKD_TIMEOUT = 5


def _unlockd_call(verb, **fields):
    """Sends one request to aigw-unlockd's newline-delimited-JSON socket
    (wire protocol: aigw-unlockd's own the design notes) and returns
    whatever it replies, verbatim, as a dict.

    Always fills in "user" as THIS process's own Unix user (getpass.getuser()
    -- the same identity ROOT_TMUX_SOCKET/BACKEND_SOCKET_PATH are already
    keyed on) and never lets a caller override it with something from the
    request body. aigw-backend runs as exactly one Unix user for its whole
    life (systemd `User=%i`), so there is only ever one honest answer to
    "whose unlock state is this" -- accepting a client-supplied "user" field
    here would let this user's own backend ask unlockd about (or, worse,
    later, lock/touch) some *other* user's window, which unlockd's own
    _require_peer_is_user_or_root() SO_PEERCRED check would deny anyway
    (this process's peer uid can never equal another user's uid) but there
    is no reason to rely on that second layer when simply never sending the
    wrong "user" in the first place is free.

    This function owns NO verdict of its own -- the design notes' "root 側で
    検証" -- so every field of a real unlockd reply (ok, options, expires_at,
    error, unlocked, ...) is handed back completely unexamined. The one
    exception is what happens when unlockd could not be reached at all
    (socket missing -- e.g. Phase 2a not deployed/started yet on this host;
    connection refused; a reply slower than UNLOCKD_TIMEOUT; a reply that
    isn't a JSON object): that is synthesized here as {"ok": False, "error":
    "..."} , the same shape a real denial from unlockd has, specifically so
    every caller's `if not resp.get("ok"):` already fails closed without a
    separate branch for "unlockd is unreachable" vs "unlockd said no" --
    losing the ability to ask is not a reason to let a host/root action
    through (design notes "Fail closed everywhere" -- an unreachable
    unlockd must never be mistaken for an open window)."""
    req = {"verb": verb, "user": getpass.getuser(), **fields}
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.settimeout(UNLOCKD_TIMEOUT)
            s.connect(UNLOCKD_SOCK_PATH)
            s.sendall((json.dumps(req) + "\n").encode("utf-8"))
            f = s.makefile("rb")
            raw = f.readline()
        finally:
            s.close()
        if not raw:
            raise OSError("aigw-unlockd closed the connection with no reply")
        resp = json.loads(raw)
        if not isinstance(resp, dict):
            raise ValueError("aigw-unlockd reply was not a JSON object")
        return resp
    except (OSError, ValueError) as e:
        log(f"aigw-unlockd call failed (verb={verb!r}): {e!r}")
        return {"ok": False, "error": "unlockd unreachable"}


class UnlockRequired(Exception):
    """Raised by require_unlock_if_outside_sandbox() when a sandbox-outside
    action is attempted with no open passkey unlock window. Deliberately its
    own type, not a ValueError/RuntimeError: every route below already
    catches one or both of those for its own, differently-coded failures
    (400 for a bad request, 502 for a backend-side execution failure), and a
    denial from this gate must always come back as 403 with
    {"unlock_required": true} -- the one thing the frontend keys off to run
    the WebAuthn retry (see app.js's withUnlockRetry) -- no
    matter which route raised it. Giving it a distinct type means each
    do_GET/do_POST branch that can raise it needs exactly one added `except
    UnlockRequired`, instead of risking it silently landing in a pre-existing
    `except ValueError`/`except RuntimeError` and coming back with the wrong
    status code and no unlock_required flag at all.

    Carries `tier` ("host" or "root", see _tier_for_location below) so
    Handler._unlock_required can put it in the 403 body -- app.js's
    withUnlockRetry needs to know which tier to ask aigw-unlockd's
    begin-assertion for (the original task brief: "The backend's 403 should say
    which tier is needed, and app.js should pass it to begin-assertion").
    """

    def __init__(self, message, tier):
        super().__init__(message)
        self.tier = tier


# Whitelist, not a blacklist (the design notes' explicit requirement): this
# function answers "is it PROVEN safe to skip the gate", not "does this look
# like host/root". The two safe shapes are enumerated; everything else --
# "host", "root", an ssh: machine this file doesn't recognize, a typo, a
# preset added later whose location string nobody taught this function about
# -- falls through to `return True` (unlock required) by construction, not
# by a maintainer remembering to add it to a deny-list. Getting this
# backwards (denylisting "host"/"root" and defaulting to "safe" for anything
# else) would silently reopen the gate for every future location this
# function has never seen; whitelisting the two provably-safe cases instead
# means a bug or an unanticipated new preset fails closed, not open.
def _location_requires_unlock(location):
    if location == "container":
        return False
    if (
        isinstance(location, str)
        and location.startswith("ssh:")
        and location.split(":", 1)[1] in SSH_MACHINES
    ):
        # the design notes: ssh:<machine> is deliberately OAuth-only. Gating
        # it here would be security theater -- the credentials this preset
        # uses are reachable from inside this same user's own sandbox
        # container anyway, so a passkey prompt in front of aigw's own ssh:
        # preset stops nobody. It only makes the convenient path (aigw) more
        # annoying than the equivalent inconvenient path (typing `ssh
        # winbox-a` inside a "shell" pane), which remains open regardless.
        # See that section for the full argument, and the deployment's own
        # notes for how those credentials are stored.
        return False
    return True


# Phase2d two-tier model (the original task brief): which credential/window tier
# authorises a given location. Only ever called after
# _location_requires_unlock(location) has already returned True (container
# and a recognized ssh:<machine> never reach this), so every location this
# function actually sees is either a known sandbox-outside location or an
# unrecognized one that fell through _location_requires_unlock's own
# whitelist. "root" needs a root-tier window; "host" needs (at least)
# host-tier. Anything else -- an unrecognized location string, a typo, a
# future preset nobody taught either function about -- fails closed to the
# STRICTEST tier, "root": since aigw-unlockd's _tier_satisfies() treats a
# host-tier window as insufficient for a "root" request, defaulting here to
# "root" instead of "host" means an unrecognized location can never be
# waved through by a mere host-tier window, only by the one credential
# class (root) that this whole system exists to gate hardest. Getting this
# default backwards -- falling back to "host" -- would silently let any
# future or malformed location ride on the weaker tier.
def _tier_for_location(location):
    if location == "root":
        return "root"
    if location == "host":
        return "host"
    return "root"


def require_unlock_if_outside_sandbox(location):
    """THE single choke point for the design notes' "sandbox 外の全経路"
    gate. Call this from every function that is about to do something
    outside this user's own sandbox container: as of this writing that is
    create_session, adopt_session, send_message, send_key, stop_session,
    resize_session, claude_auth_logout_scope, start_claude_login, and
    kill_all_chrome. One function, one call per caller, so a future
    "sandbox-outside" action either goes through here or is a reviewable
    omission instead of a silently-missing check re-derived by hand at each
    new call site (the design notes: "個別に条件を書くと必ず漏れる").

    Raises UnlockRequired (message safe to show the user) when the location
    needs an unlock window per _location_requires_unlock() above and none is
    open. A no-op (returns None) for "container" and a recognized "ssh:...".

    Deliberately calls aigw-unlockd's `touch` verb here, NOT `status`: touch
    is both the read ("ok": false means "not unlocked, or the window's
    absolute lifetime was reached") and the idle-extension side effect, in
    one round trip -- this is exactly "call touch once per actual
    sandbox-outside action" (the design notes' UI countdown requirement,
    aigw-unlockd's own verb_touch docstring: "The intended caller is
    aigw-backend, once per actual sandbox-outside action ... not a timer").
    Checking via a separate `status` call first and touching only after
    would (a) be a second round trip for no benefit, (b) open a check-then-
    touch race, and (c) risk some future call site copy-pasting the check
    half without the extend half. There is exactly one verb call here, and
    it does both jobs.

    Fails closed on every kind of trouble talking to aigw-unlockd -- see
    _unlockd_call's own docstring -- by treating "could not confirm unlocked"
    exactly like "confirmed locked". This is deliberately checked on every
    single gated call, not cached: a window that expired one second ago (the
    sweeper thread in aigw-unlockd, or a `lock` from another tab/device) must
    take effect on the very next action, not whenever this process next
    happens to refresh some local flag.

    Two-tier update (the original task brief): the tier this location needs
    (_tier_for_location) is sent to aigw-unlockd's `touch` verb, which
    denies (without extending or otherwise touching an existing window --
    see verb_touch's own docstring) whenever the currently open window's
    tier is insufficient, e.g. a host-tier window attempting a "root"
    location. UnlockRequired carries that same tier onward so the 403 body
    (Handler._unlock_required) can tell the frontend which tier's passkey
    ceremony to run -- a host-tier window plus a root action must prompt
    for root's own credential, not silently accept the weaker one."""
    if not _location_requires_unlock(location):
        return
    tier = _tier_for_location(location)
    resp = _unlockd_call("touch", tier=tier)
    if not resp.get("ok"):
        raise UnlockRequired(
            resp.get("error") or "root/host へのアクセスにはパスキーによるロック解除が必要です",
            tier=tier,
        )


# the deployment notes (2026-08-30, revision 2): this used to be TCP
# 127.0.0.1:25000+(uid-1000). The port number itself was never a secret
# (predictable from a uid anyone could look up with `id <user>`), and
# loopback TCP has no per-uid access control on Linux -- so despite this
# file's own docstring claiming aigw-gateway was "the sole caller", ANY
# local Unix user could open that port directly and drive this backend's
# full API as someone else, up to and including the "root-shell" preset.
# X-Aigw-On-Behalf-Of (see Handler._on_behalf_of below) trusted exactly that
# false premise.
#
# A Unix-domain socket path is what a loopback port can't be: subject to
# ordinary filesystem permissions. BACKEND_SOCKET_DIR (/etc/tmpfiles.d/
# aigw-backend.conf creates it, mode 1777 like /tmp/SSH_CONTROL_DIR above --
# every aigw-backend@<user> is a different Unix user and needs to create its
# own file here, and the sticky bit stops one from deleting another's) is
# shared with aigw-backend-proxy@.socket's own activation socket
# (/run/aigw-backend/<port>.sock -- see that unit), which is why this one
# has a "-backend" suffix the two can never collide on: a port number is all
# digits, a username must start with a letter or underscore. UnixHTTPServer.
# server_bind() below chmods this file 0600, owner only -- unlike the
# activation socket (owner "aigw", so only aigw-gateway/root can reach it),
# nothing needs *group* access here: the only thing that ever connects to
# this one besides this user's own processes is aigw-proxy-handler, which
# runs as root and so bypasses file permissions entirely (root doesn't need
# to be let in by a group bit). See this file's own module docstring for why
# that -- and not a chmod-group-"aigw"-and-let-aigw-gateway-connect-directly
# design -- is what this settled on.
BACKEND_SOCKET_DIR = "/run/aigw-backend"
BACKEND_SOCKET_PATH = f"{BACKEND_SOCKET_DIR}/{getpass.getuser()}-backend.sock"

# A *second*, much more restricted listener, reachable from this user's own
# container over the docker0 bridge (like the headful-Chrome CDP proxy). Not
# used by the "claude" preset itself -- since that now runs headlessly (see
# _run_claude_headless_turn), this process already knows synchronously, in
# its own memory, the exact moment a turn finishes, and calls
# send_push_notification() directly with no HTTP round-trip needed. This
# listener exists for any *other* tool running inside the container (a future
# non-headless AI CLI with its own completion webhook/hook, a long-running
# shell command, etc.) that wants to signal "notify the user now" from
# inside, where 127.0.0.1 means the container's own loopback, not the host's.
# Only exposes POST /sessions/<id>/notify, nothing else from the main API --
# and since 2026-09-17 it also refuses any peer that is not this user's own
# container (see notify_peer_allowed below), so another container on the same
# bridge cannot even do the one thing it used to be able to do here, trigger
# a spurious push notification. Session content was never reachable.
NOTIFY_PORT = 23000 + (os.getuid() - 1000)
DOCKER0_ADDR = "172.17.0.1"

# docker0 does not isolate containers from each other, so binding there means
# every container on this host can reach this port, not just this user's own.
# Since 2026-09-17 the listener checks the peer address against this user's
# own container IP and refuses everything else, so the "at worst a spurious
# push" caveat above is now "nothing at all" for a stranger's container.
#
# The lookup is `sandbox ip`, which is slow enough (and auto-starts the
# container) that it must not run once per request: the answer is cached, and
# a mismatch only re-checks every NOTIFY_PEER_REFRESH_SEC seconds, so a
# container that is not ours cannot turn this into a `sandbox ip` amplifier.
# Fails closed -- if the IP cannot be determined, nothing is accepted.
NOTIFY_PEER_REFRESH_SEC = 30
_notify_peer = {"ip": None, "ts": 0.0}
_notify_peer_lock = threading.Lock()


def notify_peer_allowed(peer_ip):
    """True only when peer_ip is this user's own container (see above)."""
    with _notify_peer_lock:
        if _notify_peer["ip"] is not None and peer_ip == _notify_peer["ip"]:
            return True
        now = time.monotonic()
        if now - _notify_peer["ts"] < NOTIFY_PEER_REFRESH_SEC:
            return False
        _notify_peer["ts"] = now
        try:
            _notify_peer["ip"] = container_ip()
        except Exception as e:
            log(f"[notify] own container IP unavailable, refusing {peer_ip}: {e}")
            _notify_peer["ip"] = None
            return False
        return peer_ip == _notify_peer["ip"]

# session_id -> list of queue.Queue (one per connected SSE client)
_subscribers = {}
_subscribers_lock = threading.Lock()

# session_id -> the tmux pane's current visible text, as of the last poll.
#
# This exists because an append-only chat log fundamentally cannot show an
# *in-place* redraw, and Claude Code's selection menus are exactly that:
# pressing Down rewrites two rows in the middle of the pane, leaving the row
# count and the last row untouched. _watch_tmux_session's settle heuristic
# only ever re-examines the last row, so the phone kept showing the cursor on
# the first option no matter how many arrow keys were sent -- the keys landed
# correctly (verified against `tmux capture-pane`), the UI just never said so.
# Rather than teach that heuristic to track redraws (which would mean
# un-committing bubbles and printing the same menu twice), the current screen
# is kept here as a separate, always-truthful view the UI can show on demand.
_latest_screen = {}
_latest_screen_lock = threading.Lock()

# session_id -> list of lines that have scrolled off this session's pane
# over time, oldest first (the deployment notes,
# 2026-09-01) -- built by _watch_tmux_session itself, poll by poll, since
# tmux's own scrollback cannot serve this for a fullscreen program in the
# alternate screen (claude-tui, or `claude` run by hand). Read by
# screen_history_page for the screen panel's "scroll up past the live
# tail" gesture; capped at SCREEN_BACKLOG_MAX_LINES per session.
_screen_backlog = {}
_screen_backlog_lock = threading.Lock()

# session_id -> next event sequence number (1-indexed)
_next_seq = {}
_seq_lock = threading.Lock()

_watchers_started = set()
_watchers_lock = threading.Lock()

_transcript_tailers_started = set()
_transcript_tailers_lock = threading.Lock()

_shell_claude_watchers_started = set()
_shell_claude_watchers_lock = threading.Lock()

# session_id -> True while a "shell"/"host-shell"/"root-shell"/"attach" pane's
# foreground process is `claude` (see _watch_shell_claude). Checked by
# _watch_tmux_session to suspend its own row-count bubbling for exactly that
# stretch, the same way it is permanently suspended for "claude-tui".
_claude_foreground = {}
_claude_foreground_lock = threading.Lock()

# (proj_dir_str, claude_session_id) -> the aigw session_id that has claimed
# it as "my own Claude Code conversation" -- shared by _tail_claude_transcript
# and _watch_shell_claude, the two places that guess which on-disk .jsonl a
# pane's own conversation is (there is no notion of "this pid wrote this
# file" to check instead; Claude Code never tells aigw-backend that). Without
# this, two aigw sessions in the same cwd (e.g. two "claude-tui" panes) could
# independently "discover" and bind to the SAME file -- reported 2026-09-10
# ("viewerとanimeのログが同じになってます", recurring per the user -- exact
# trigger never pinned down from static reading alone, since neither known
# in-process race (duplicate watcher thread, backend restart) matched the
# timestamps on the one incident caught live). This registry does not
# require finding that trigger: it makes the SYMPTOM (two sessions sharing
# one file) structurally impossible regardless of cause -- whichever
# discovery loop claims a filename first keeps it, everyone else moves on to
# another candidate or keeps waiting, exactly as if that file had never
# appeared for them.
_claimed_transcripts = {}
_claimed_transcripts_lock = threading.Lock()


def _claim_transcript(proj_dir, filename, session_id):
    """Atomically claims (proj_dir, filename) for session_id if unclaimed.
    Returns True if this call is the (or already was the) owner, False if
    someone else already holds it."""
    key = (str(proj_dir), filename)
    with _claimed_transcripts_lock:
        holder = _claimed_transcripts.get(key)
        if holder is None:
            _claimed_transcripts[key] = session_id
            return True
        return holder == session_id


def log(msg):
    print(f"[aigw-backend] {msg}", file=sys.stderr, flush=True)


def sandbox_exec(args, timeout=15):
    """Run `sandbox exec -- <args>` (non-interactive docker exec into the
    user's own devbox container). Never raw docker -- see that CLI's own
    documentation for the privilege boundary it enforces."""
    return subprocess.run(
        ["sandbox", "exec", "--", *args],
        capture_output=True, text=True, timeout=timeout,
    )


def container_ip():
    """Docker-bridge IP of this user's own devbox container (auto-starting
    it if needed), via `sandbox ip` -- never raw docker, same privilege
    boundary as everything else here. Used by aigw-gateway's /sandbox/port<N>
    reverse proxy (see that CLI's `ip` case for why no ports are
    published and a direct bridge IP is needed instead)."""
    r = subprocess.run(["sandbox", "ip"], capture_output=True, text=True, timeout=15)
    if r.returncode != 0 or not r.stdout.strip():
        raise RuntimeError(r.stderr.strip() or "sandbox ip failed")
    return r.stdout.strip()


def session_dir(session_id):
    return SESSIONS_DIR / session_id


def load_meta(session_id):
    p = session_dir(session_id) / "meta.json"
    if not p.exists():
        return None
    return json.loads(p.read_text())


def save_meta(session_id, meta):
    p = session_dir(session_id) / "meta.json"
    p.write_text(json.dumps(meta))


def resolve_session_access(session_id, on_behalf_of):
    """The single check every sessions/<id>/* handler makes before doing
    anything (the deployment notes): loads meta, and -- only when aigw-gateway has
    marked this request as being relayed for someone other than this
    backend's own user -- requires that user to be in shared_with. Returns
    (meta, None) on success, or (None, (code, body)) for the caller to
    return directly. Not-found and not-shared both come back as plain
    "no such session": a session id a stranger can't see should not be
    distinguishable from one that doesn't exist."""
    if not SESSION_ID_RE.match(session_id):
        return None, (404, {"error": "no such session"})
    meta = load_meta(session_id)
    if meta is None:
        return None, (404, {"error": "no such session"})
    if on_behalf_of is not None and on_behalf_of not in meta.get("shared_with", []):
        return None, (404, {"error": "no such session"})
    return meta, None


def share_session(session_id, username):
    # No separate username-format check: getpwnam is itself the check that
    # matters (a malformed string simply won't resolve to a real account),
    # and reimplementing adm-adduser's username regex here would just be a
    # second copy to keep in sync for no extra safety.
    if not username:
        raise ValueError("invalid username")
    try:
        pwd.getpwnam(username)
    except KeyError:
        raise ValueError("no such user")
    if username == getpass.getuser():
        raise ValueError("cannot share with yourself")
    meta = load_meta(session_id)
    if meta is None:
        raise ValueError("no such session")
    shared_with = meta.setdefault("shared_with", [])
    if username not in shared_with:
        shared_with.append(username)
        save_meta(session_id, meta)
    return meta


def unshare_session(session_id, username):
    meta = load_meta(session_id)
    if meta is None:
        raise ValueError("no such session")
    shared_with = meta.get("shared_with", [])
    if username in shared_with:
        shared_with.remove(username)
        save_meta(session_id, meta)
    return meta


def list_tmux_sessions():
    """Set of live tmux session names inside the user's container, or empty
    set if the tmux server isn't running at all (e.g. nothing ever started)."""
    try:
        r = sandbox_exec(["tmux", "list-sessions", "-F", "#S"])
    except subprocess.TimeoutExpired:
        return set()
    if r.returncode != 0:
        return set()
    return {line for line in r.stdout.splitlines() if line}


def list_host_tmux_sessions():
    """Set of live tmux session names in *this backend's own* host-level
    tmux server -- i.e. sessions the user started directly on this host
    (over SSH, say), outside the sandbox/devbox container entirely. This
    crosses no new privilege boundary: aigw-backend@<user>.service already
    runs as that literal Unix user (systemd `User=%i`), so it already has
    exactly the same OS-level access to that user's own host tmux server
    that a normal shell for that user would -- discovered as a real gap
    when a user's actual long-running sessions turned out to live here,
    not inside devbox-<user> (which "attach" originally assumed exclusively)."""
    try:
        r = subprocess.run(["tmux", "list-sessions", "-F", "#S"], capture_output=True, text=True, timeout=15)
    except subprocess.TimeoutExpired:
        return set()
    if r.returncode != 0:
        return set()
    return {line for line in r.stdout.splitlines() if line}


def list_root_tmux_sessions():
    """Set of live session names on this user's dedicated *root* tmux server
    (see ROOT_TMUX_SOCKET). Separate from the user's own host tmux server,
    and from root's personal one, on purpose -- aigw's root panes live on
    their own socket and can reach neither.

    Returns None, not merely an empty set, when this user's window is
    currently locked (root_shell_allowed() is False): since 2026-08-31's
    "sever access, don't kill the server" (the deployment notes
    not-kill), a locked window does not mean the server has stopped, only
    that this process cannot currently reach its socket to ask. Callers MUST
    NOT treat None the same as "confirmed nothing running" -- see
    list_sessions()'s own handling of this, which is exactly why this
    distinction exists (2026-08-31, so an existing root-shell session still
    shows up as reconnectable in the session list while locked, instead of
    looking falsely ended)."""
    if not root_shell_allowed():
        return None
    try:
        r = tmux_exec("root", ["list-sessions", "-F", "#S"])
    except subprocess.TimeoutExpired:
        return set()
    if r.returncode != 0:
        return set()
    return {line for line in r.stdout.splitlines() if line}


def list_ssh_tmux_sessions(location):
    """Like list_host_tmux_sessions, but for a `ssh:<machine>` location --
    live tmux session names on that machine, or empty if unreachable."""
    try:
        r = tmux_exec(location, ["list-sessions", "-F", "#S"])
    except (subprocess.TimeoutExpired, OSError):
        return set()
    if r.returncode != 0:
        return set()
    return {line for line in r.stdout.splitlines() if line}


def live_tmux_names(location):
    if location == "host":
        return list_host_tmux_sessions()
    if location == "root":
        return list_root_tmux_sessions()
    if location.startswith("ssh:"):
        return list_ssh_tmux_sessions(location)
    return list_tmux_sessions()


# How long to keep polling for an ssh:<machine> tmux session to appear after
# its own `new-session` call timed out, before finally giving up (see
# create_session's use of this). Measured 2026-08-14 on winbox-a, repeatedly:
# a cold MSYS2/Cygwin server fork can still be in flight past 3 minutes even
# with tmux_exec's own extended 45s timeout and redirect_devnull already
# applied -- the fork is not actually hung (it does eventually finish, and
# killing the client that started it -- what a shorter timeout does -- does
# NOT stop it, confirmed by the session showing up minutes after its
# originating ssh process had already been killed for timing out), just much
# slower than any fixed wait on the original request could reasonably cover.
# Comfortably under nginx's /agents/ location's own `proxy_read_timeout`
# (bumped to 360s alongside this, see the deployment notes) --
# without that headroom nginx would 504 the phone before this ever finishes
# polling, which looks exactly like the failure this exists to avoid.
SSH_NEW_SESSION_POLL_TIMEOUT = 240
SSH_NEW_SESSION_POLL_INTERVAL = 3


def _wait_for_ssh_session(location, session_id):
    """Polls list-sessions (never forks a server itself, so immune to the
    cold-fork hang this exists to wait out) until session_id appears or
    SSH_NEW_SESSION_POLL_TIMEOUT elapses. "As long as the process is alive,
    keep waiting" in spirit -- there is no cheap way to check the remote
    tmux.exe process itself is still alive without another SSH round trip
    that could hang the same way, so a generous bounded poll is the practical
    version of that: a session that is ever going to appear at all is
    expected to do so well within this window, and one that never does was a
    genuine failure either way."""
    deadline = time.time() + SSH_NEW_SESSION_POLL_TIMEOUT
    while time.time() < deadline:
        if session_id in live_tmux_names(location):
            return True
        time.sleep(SSH_NEW_SESSION_POLL_INTERVAL)
    return False


def tmux_exec(location, tmux_args, timeout=15):
    """Runs `tmux <tmux_args>` (tmux_args excludes the leading "tmux" itself)
    against one of the tmux-or-tmux-alike servers a session can live in:

      container - this user's own devbox-<user>, via sandbox_exec (the
                  existing privilege boundary, never raw docker)
      host      - this host, as this same process's own user (see
                  list_host_tmux_sessions)
      root      - the root tmux server run by aigw-root-tmux@<user>.service.
                  Still an ordinary tmux client running as this user; what
                  makes its panes root is that the *server* is root. If that
                  unit isn't enabled for this user, the socket doesn't exist
                  and this simply fails.
      ssh:<machine> - a GPU machine in SSH_MACHINES, talking to its real
                  MSYS2 tmux over the shared SSH key (see SSH_MACHINES and
                  _ssh_run). Not this user's own rights -- like "root", every
                  aigw user who can reach this backend at all shares the same
                  single shared account on that machine (see the SSH_MACHINES
                  comment for why that's an accepted, not accidental, choice).

    Only "root" and "ssh:<machine>" yield more than this user's own rights;
    see the TMUX_PRESETS comment."""
    if location == "root":
        return subprocess.run(
            ["tmux", "-S", ROOT_TMUX_SOCKET, *tmux_args],
            capture_output=True, text=True, timeout=timeout,
        )
    if location == "host":
        return subprocess.run(["tmux", *tmux_args], capture_output=True, text=True, timeout=timeout)
    if location.startswith("ssh:"):
        machine = location.split(":", 1)[1]
        remote_argv = [SSH_MACHINES[machine]["tmux"], *tmux_args]
        # Only "new-session" can make MSYS2 tmux fork a brand-new SERVER
        # process (the very first session on that machine, or the first
        # since a reboot/kill -- every later call just talks to the
        # already-running server over its socket and returns immediately
        # regardless of this). On MSYS2/Cygwin that forked server inherits
        # this SSH exec's stdout/stderr pipes and never closes them, so the
        # ssh client hangs waiting for a channel-close that never comes
        # (measured 2026-08-14: a first-ever new-session on winbox-a hung
        # >20s here while the session was in fact created fine, confirmed by
        # a second call reporting "duplicate session"). redirect_devnull
        # fixes it by redirecting them away before tmux forks; the cost is
        # losing the exact stderr text on a (rare, immediately-failing, so
        # never actually the hang case) new-session failure -- the exit
        # code, which is all every caller here actually branches on, still
        # comes through correctly.
        is_new_session = bool(tmux_args) and tmux_args[0] == "new-session"
        if is_new_session:
            # A cold MSYS2/Cygwin server fork (see the comment above) has been
            # measured taking longer than the usual 15s default even with
            # redirect_devnull applied (2026-08-14, winbox-a, after its tmux
            # server had exited from being idle) -- callers pass their own
            # timeout for everything else, but this one case gets a floor of
            # its own regardless, since 15s was demonstrably not enough and
            # every other tmux_exec call (send-keys, capture-pane, ...) never
            # forks a server so never needs it.
            timeout = max(timeout, 45)
        return _ssh_run(machine, remote_argv, timeout=timeout, redirect_devnull=is_new_session)
    return sandbox_exec(["tmux", *tmux_args], timeout=timeout)


def list_sessions(on_behalf_of=None):
    """on_behalf_of is set only when aigw-gateway is relaying a request for
    someone other than this backend's own user (the deployment notes) -- in that
    case this returns only the sessions that user has actually been shared
    with, never the owner's full list. None (the default, used for every
    normal "my own sessions" call) returns everything, unchanged."""
    if not SESSIONS_DIR.exists():
        return []
    # Lazily fetched, only if some session actually needs it (the root one
    # costs a sudo call, the ssh: ones cost a network round trip -- and on a
    # machine with no tmux server currently running, "list-sessions" alone
    # costs ~2s of MSYS2/Cygwin client startup just to say so, measured
    # 2026-08-20, see the deployment notes).
    live_container = None
    live_host = None
    live_root = None
    root_checked = False  # separate from live_root itself being None -- see below
    live_ssh = {}  # location -> set of names
    out = []
    for d in sorted(SESSIONS_DIR.iterdir()):
        if not d.is_dir():
            continue
        meta = load_meta(d.name)
        if meta is None:
            continue
        if on_behalf_of is not None and on_behalf_of not in meta.get("shared_with", []):
            continue
        location = meta.get("tmux_location")
        if meta.get("preset") in HEADLESS_PRESETS:
            # No persistent tmux session between turns for headless presets --
            # "alive" here just means "not explicitly stopped", not "a
            # process is currently running" (that's normal/expected while
            # idle between messages).
            meta["alive"] = not meta.get("stopped", False)
        elif meta.get("stopped"):
            # Already confirmed dead (explicit stop, or the watcher's own
            # dead-pane detection) -- skip the live round trip entirely
            # rather than re-derive "alive" from a name match. A stopped
            # session's tmux_name can otherwise get reused later by some
            # unrelated live session on the same server (tmux's default
            # auto-numbered names -- "0", "1" -- are especially prone to
            # this, see list_untracked_tmux_sessions), which without this
            # check would flip a long-dead session back to showing "alive"
            # in the list even though opening it shows its real, ended
            # content (see the deployment notes).
            meta["alive"] = False
        elif location == "host":
            if live_host is None:
                live_host = list_host_tmux_sessions()
            meta["alive"] = meta.get("tmux_name", d.name) in live_host
        elif location == "root":
            if not root_checked:
                live_root = list_root_tmux_sessions()  # None if currently locked
                root_checked = True
            if live_root is None:
                # Locked: cannot reach the server to ask, but per 2026-08-31's
                # "sever access, don't kill the server" it is very likely
                # still running. Show it as reconnectable rather than
                # falsely ended (user request, 2026-08-31) -- attaching still
                # goes through require_unlock_if_outside_sandbox and prompts
                # for a fresh passkey regardless of what this says.
                meta["alive"] = True
            else:
                meta["alive"] = meta.get("tmux_name", d.name) in live_root
        elif location and location.startswith("ssh:"):
            if location not in live_ssh:
                live_ssh[location] = list_ssh_tmux_sessions(location)
            meta["alive"] = meta.get("tmux_name", d.name) in live_ssh[location]
        else:
            if live_container is None:
                live_container = list_tmux_sessions()
            meta["alive"] = meta.get("tmux_name", d.name) in live_container
        out.append(meta)
        ensure_watcher(d.name)
    return out


def list_untracked_tmux_sessions():
    """Live tmux sessions -- both inside the user's own devbox container AND
    directly on the host as that same user (see list_host_tmux_sessions) --
    that aren't already tracked by a non-stopped aigw session, available to
    "attach" to. Returns a list of {"name", "location"} dicts rather than
    bare names, since a container session and a host session could
    plausibly share the same name (tmux's default auto-numbered names, e.g.
    "0", are especially prone to this) and downstream code needs to know
    which of the two tmux servers a given name actually belongs to."""
    tracked = set()  # {(location, name)}
    if SESSIONS_DIR.exists():
        for d in SESSIONS_DIR.iterdir():
            if not d.is_dir():
                continue
            meta = load_meta(d.name)
            if meta and not meta.get("stopped"):
                tracked.add((meta.get("tmux_location", "container"), meta.get("tmux_name", d.name)))

    result = []
    for name in sorted(list_tmux_sessions()):
        if ("container", name) not in tracked:
            result.append({"name": name, "location": "container"})
    for name in sorted(list_host_tmux_sessions()):
        if ("host", name) not in tracked:
            result.append({"name": name, "location": "host"})
    # One thread per machine: reachability + list-sessions each cost a real
    # SSH round trip (and, on MSYS2/Cygwin with no tmux server currently up,
    # ~2s of client startup on top of that), so probing SSH_MACHINES in
    # sequence adds their costs instead of taking the slowest one. See
    # the deployment notes.
    ssh_names = {}  # machine -> sorted names, or [] if unreachable

    def _probe(machine):
        location = f"ssh:{machine}"
        ssh_names[machine] = sorted(list_ssh_tmux_sessions(location)) if ssh_reachable(machine) else []

    threads = [threading.Thread(target=_probe, args=(machine,)) for machine in SSH_MACHINES]
    for t in threads:
        t.start()
    for t in threads:
        t.join()
    for machine in SSH_MACHINES:
        location = f"ssh:{machine}"
        for name in ssh_names[machine]:
            if (location, name) not in tracked:
                result.append({"name": name, "location": location})
    return result


# Session names a real tmux session can have; deliberately excludes
# whitespace and ";" -- tmux's own command-line lexer treats a standalone
# ";" argv token as a command separator (see the send_key comment below),
# and while an already-tokenized argv list (what sandbox_exec always uses)
# isn't re-split on whitespace, there's no reason to accept anything that
# isn't a plausible tmux session name in the first place.
TMUX_NAME_RE = re.compile(r"^[^\s;]{1,100}$")


def resize_session(session_id, cols, rows=None):
    """Resizes an existing session's tmux window to a new width and/or
    height -- for a pane whose size was only ever set once, at creation
    (create_session's own `-x`/`-y`), but no longer matches the screen
    looking at it: an adopted pane that was never sized for a phone at all,
    or an aigw session created on some other, differently-sized device and
    opened again here later (the deployment notes, 2026-08-15 at the
    user's request; extended to height 2026-08-31,
    the deployment notes). `-x`/`-y` are independent tmux
    resize-window flags (verified against `tmux resize-window` -- neither
    implies or requires the other), so whichever of cols/rows is not given
    (or does not clamp to anything sane) is simply left off the command and
    that axis is untouched -- unlike the pre-2026-08-31 version of this
    function, which always re-sent a flat PANE_ROWS for height because
    height was a single global constant back then, not a per-call value.

    A no-op if the session/pane is already gone, or neither dimension
    clamps to anything sane -- this is always called opportunistically
    (opening the screen panel, adopting a pane), never as the one required
    step of a user-visible action, so there is nothing to surface a
    failure to."""
    meta = load_meta(session_id)
    if meta is None:
        return
    cols = _clamp_pane_cols(cols)
    rows = _clamp_pane_rows(rows)
    if cols is None and rows is None:
        return
    tmux_name = meta.get("tmux_name", session_id)
    location = meta.get("tmux_location", "container")
    # the design notes' table lists resize alongside messages/keys/stop as a
    # sandbox-outside action for a host/root session -- it does, after all,
    # run a tmux command against the host/root tmux server exactly like
    # those do. Deliberately raises (UnlockRequired) rather than treating a
    # closed window as just another "pane already gone" no-op case above:
    # those no-op early-returns are for conditions where doing nothing is
    # the obviously safe, unsurprising choice; a closed unlock window is a
    # security decision, not a housekeeping one, and callers (the /resize
    # route, adopt_session below) need to actually see the denial, not have
    # it silently swallowed into "cols was already fine, I guess".
    require_unlock_if_outside_sandbox(location)
    args = ["resize-window", "-t", tmux_name]
    if cols is not None:
        args += ["-x", str(cols)]
    if rows is not None:
        args += ["-y", str(rows)]
    tmux_exec(location, args)


# How many lines a screen-panel "scroll up past the live tail" fetch
# returns per page (the deployment notes, 2026-09-01) --
# same shape as HISTORY_PAGE_LIMIT for the chat log's events_page.
SCREEN_BACKLOG_PAGE_LINES = 200

# Total lines kept per session in _screen_backlog before the oldest get
# dropped (the deployment notes) -- an in-memory bound,
# not a tmux one: unlike the 2026-08-31 `-S -`/capture_screen_history this
# replaces, nothing here is limited by tmux's own history-limit, so this is
# the only cap. Generous but not unbounded -- a `claude` session left open
# for hours doing constant work could otherwise grow this without limit.
SCREEN_BACKLOG_MAX_LINES = 5000


def screen_history_page(session_id, before, limit=SCREEN_BACKLOG_PAGE_LINES):
    """Pages backward through _screen_backlog -- the lines _watch_tmux_
    session has itself recorded scrolling off this session's pane over
    time (the deployment notes, 2026-09-01) -- for the
    screen panel's "scroll up past the live tail" gesture. `before` is how
    many backlog lines (counting from the live end backward) the caller has
    already loaded, exactly like events_page's own `before`/seq cursor;
    0 means "the page immediately preceding the live tail".

    Unlike the capture-pane-based approach this replaces, this works
    identically for a plain shell/attach pane *and* a fullscreen program in
    the alternate screen (claude-tui, or `claude` run by hand) -- tmux's own
    scrollback was never usable for the latter (alternate-screen history is
    not recorded at all, `man tmux` capture-pane's "-a" note), which is
    exactly the case this whole mechanism exists for; a plain shell also
    benefits since this is not bounded by tmux's own history-limit or by
    however tall the pane happens to be sized right now.

    Returns (lines, has_more) -- (None, False) if the session is unknown to
    _screen_backlog (never polled, or already ended and cleaned up)."""
    with _screen_backlog_lock:
        backlog = _screen_backlog.get(session_id)
        if backlog is None:
            return None, False
        end = len(backlog) - max(0, before)
        start = max(0, end - limit)
        return list(backlog[start:end]), start > 0


def adopt_session(tmux_name, location, label, cols=None, rows=None):
    """Starts watching an *existing* tmux session (one the user created by
    hand, not via create_session) as a new aigw session, instead of
    launching a new pane. No `tmux new-session`/`pipe-pane` call at all --
    ensure_watcher dispatches non-headless sessions (both "shell" and
    "attach") to _watch_tmux_session, which polls `tmux capture-pane`
    instead of tailing a pipe-pane log (see that function's docstring for
    why).
    `location` is "container" (inside devbox-<user>), "host" (this user's own
    host-level tmux server, see list_host_tmux_sessions), or "ssh:<machine>"
    (a GPU machine in SSH_MACHINES) -- whichever list_untracked_tmux_sessions
    reported this name under.

    `cols`/`rows`, if given, resize the adopted pane to the phone's current
    size (see resize_session) -- an adopted pane's size was never chosen
    with this screen in mind the way create_session's own `-x`/`-y` is, and
    was the concrete complaint that prompted adding this at all (2026-08-15:
    "後から Attachする場合などに横に広すぎる場合がある"; `rows` followed the
    same reasoning 2026-08-31, the deployment notes)."""
    if location not in ("container", "host") and not (
        location.startswith("ssh:") and location.split(":", 1)[1] in SSH_MACHINES
    ):
        raise ValueError("invalid location")
    # the design notes' table lists this explicitly: adopting an existing
    # *host* tmux pane is exactly as much a sandbox-outside action as
    # create_session's "host-shell" preset is, and must be gated the same
    # way, before live_tmux_names()/ensure_watcher() below ever touch it.
    # ("root" never reaches here at all -- the location-shape check just
    # above only accepts container/host/ssh:<machine>, matching the fact
    # that nothing ever publishes a root pane as attach-able in the first
    # place.)
    require_unlock_if_outside_sandbox(location)
    if not tmux_name or not TMUX_NAME_RE.match(tmux_name):
        raise ValueError("invalid tmux session name")
    if tmux_name not in live_tmux_names(location):
        raise ValueError("no such live tmux session")
    session_id = uuid.uuid4().hex[:12]
    sdir = session_dir(session_id)
    (sdir / "outbox").mkdir(parents=True)
    (sdir / "output.log").touch()
    (sdir / "events.jsonl").touch()
    meta = {
        "id": session_id,
        "label": label or tmux_name,
        "preset": "attach",
        "tmux_name": tmux_name,
        "tmux_location": location,
        "created_ts": time.time(),
        "stopped": False,
        "ended_ts": None,
        "claude_session_id": None,
        "archived": False,
    }
    save_meta(session_id, meta)
    if cols is not None or rows is not None:
        resize_session(session_id, cols, rows)
    ensure_watcher(session_id)
    meta["alive"] = True
    return meta


# ---- Claude Code authentication inside the container --------------------
#
# The headless "claude" preset only works if Claude Code is logged in *inside
# devbox-<user>*, which was previously invisible from the phone: a logged-out
# container just made every turn fail with an opaque error, and the only fix
# was an SSH session. `claude auth status --json` and `claude auth logout`
# are non-interactive, so they run straight through `sandbox exec`; login is
# interactive and goes through the "claude-login" tmux preset instead.
#
# All three run inside the user's own container as that user, so this adds no
# privilege of any kind -- it is the same command they would type in
# `sandbox shell`, and the credentials it reads and writes are the container's
# own (~/sandhome/.claude), never the host's.
CLAUDE_AUTH_TIMEOUT = 60

# The root check (claude_auth_status_root) polls a pane instead of reading a
# subprocess's output, so "not answering" and "not answering yet" look the
# same to it and it can only give up on the clock. Much shorter than
# CLAUDE_AUTH_TIMEOUT: the three checks run one after another behind a single
# request that a phone is waiting on, and a healthy root check resolves in
# well under a second.
ROOT_AUTH_TIMEOUT = 10


def claude_auth_status():
    """`claude auth status --json` from inside the container. Errors are
    returned as data, not raised: "the container won't answer" is itself the
    status the UI needs to show."""
    try:
        r = sandbox_exec(["claude", "auth", "status", "--json"], timeout=CLAUDE_AUTH_TIMEOUT)
    except (subprocess.TimeoutExpired, OSError) as e:
        return {"error": f"could not ask the container: {e}"}
    return _parse_claude_auth_output(r.stdout, r.stderr, r.returncode)


def claude_auth_logout():
    try:
        r = sandbox_exec(["claude", "auth", "logout"], timeout=CLAUDE_AUTH_TIMEOUT)
    except (subprocess.TimeoutExpired, OSError) as e:
        raise RuntimeError(f"could not ask the container: {e}")
    if r.returncode != 0:
        raise RuntimeError(((r.stderr or "").strip() or (r.stdout or "").strip()
                            or f"exit {r.returncode}")[:500])
    return (r.stdout or "").strip()[:500]


def claude_auth_logout_host():
    """`claude auth logout` on the host, as this same user -- the counterpart
    of claude_auth_status_host, and the same privilege: this process already
    runs as that user (see that function)."""
    try:
        r = subprocess.run(
            [HOST_CLAUDE_BIN, "auth", "logout"],
            capture_output=True, text=True, timeout=CLAUDE_AUTH_TIMEOUT,
            cwd=os.path.expanduser("~"),
        )
    except (subprocess.TimeoutExpired, OSError) as e:
        raise RuntimeError(f"could not run on host: {e}")
    if r.returncode != 0:
        raise RuntimeError(((r.stderr or "").strip() or (r.stdout or "").strip()
                            or f"exit {r.returncode}")[:500])
    return (r.stdout or "").strip()[:500]


def claude_auth_logout_root():
    """`claude auth logout` as root, through the root tmux server -- same
    route, and same privilege boundary, as claude_auth_status_root and the
    "root-shell" preset (the deployment notes)."""
    if not root_shell_allowed():
        raise RuntimeError("root shell is not enabled for this user")
    text = _root_tmux_capture(f"{ROOT_CLAUDE_BIN} auth logout",
                              lambda t: t or None, ROOT_AUTH_TIMEOUT)
    if text is None:
        raise RuntimeError("no answer from the root pane")
    return text[:500]


def _parse_claude_auth_output(out, err, returncode):
    out = (out or "").strip()
    try:
        status = json.loads(out)
    except ValueError:
        return {"error": ((err or "").strip() or out or f"exit {returncode}")[:500]}
    return status if isinstance(status, dict) else {"error": out[:500]}


def claude_auth_status_host():
    """`claude auth status --json` on the host itself, as this same user --
    this process (aigw-backend@<user>.service) already runs as that user with
    their real $HOME (systemd sets it from User=%i), so this is no different
    a privilege than the "host-shell" preset already has: same command they'd
    type in that pane, just non-interactive. Reads ~/.claude, never sandhome.

    Absolute path (HOST_CLAUDE_BIN), not bare "claude": this runs under
    systemd's own minimal PATH, unlike an actual host-shell pane (`bash -l`)."""
    try:
        r = subprocess.run(
            [HOST_CLAUDE_BIN, "auth", "status", "--json"],
            capture_output=True, text=True, timeout=CLAUDE_AUTH_TIMEOUT,
            cwd=os.path.expanduser("~"),
        )
    except (subprocess.TimeoutExpired, OSError) as e:
        return {"error": f"could not run on host: {e}"}
    return _parse_claude_auth_output(r.stdout, r.stderr, r.returncode)


def claude_auth_status_root():
    """`claude auth status --json` as root, through the same root tmux server
    the "root-shell" preset already talks to (the deployment notes) -- a plain tmux
    client command, not a new escalation: this process's own privileges never
    change, root-ness comes entirely from the server being root. Runs in a
    throwaway detached session, killed when done either way. -x 500 keeps the
    JSON line from being hard-wrapped by capture-pane, same reason
    "claude-login" uses width=800. Returns None outright if this user has no
    root-shell access -- distinct from {"error": ...}, which means the check
    itself failed.

    The pane is tall and the capture reaches into scrollback because the
    answer is a ~9-line pretty-printed JSON object: with the 5-line pane and
    visible-region-only capture this first had, every poll saw a truncated
    fragment, json.loads never succeeded, and the whole /claude-auth request
    sat there until the timeout -- which is what "確認中…" that never resolves
    looked like from the phone. ROOT_AUTH_TIMEOUT is separately short for the
    same reason: this loop is the one part of the auth panel that can only
    fail by waiting."""
    if not root_shell_allowed():
        return None

    def as_dict(text):
        try:
            parsed = json.loads(text)
        except ValueError:
            return None
        return parsed if isinstance(parsed, dict) else None

    try:
        out = _root_tmux_capture(f"{ROOT_CLAUDE_BIN} auth status --json",
                                 as_dict, ROOT_AUTH_TIMEOUT)
    except (subprocess.TimeoutExpired, OSError) as e:
        return {"error": f"could not ask root: {e}"}
    return out if out is not None else {"error": "no answer from the root pane"}


def _root_tmux_capture(shell_command, ready, timeout):
    """Run one command as root in a throwaway pane on the root tmux server and
    poll `capture-pane` until `ready(text)` returns something other than None
    -- that value is the result (None if it never does). Polling a pane is the
    only way to read root's output from here: we drive that server as an
    ordinary tmux client, so there is no pipe of ours to read and no process
    of ours to wait on.

    -y 50 and a capture that reaches into scrollback because the answers are
    multi-line. Reading only the visible region of a short pane means every
    poll sees a truncated fragment that can never satisfy `ready`, which is
    exactly how the status check first shipped (see claude_auth_status_root).
    The command outlives itself by `sleep 10` so that a slow start cannot make
    the session vanish before the first poll; the session is killed either way
    on the way out."""
    name = f"authcheck-{uuid.uuid4().hex[:8]}"
    try:
        r = tmux_exec("root", [
            "new-session", "-d", "-s", name, "-x", "500", "-y", "50",
            "--", "sh", "-c", f"{shell_command}; sleep 10",
        ])
        if r.returncode != 0:
            raise OSError((r.stderr or "").strip() or "could not start the root pane")
        deadline = time.time() + timeout
        while time.time() < deadline:
            time.sleep(0.3)
            cap = tmux_exec("root", ["capture-pane", "-p", "-J", "-S", "-200", "-t", name])
            value = ready((cap.stdout or "").strip())
            if value is not None:
                return value
        return None
    finally:
        tmux_exec("root", ["kill-session", "-t", name])


def claude_auth_status_ssh(machine):
    """`claude auth status --json` on a GPU machine, via a single plain SSH
    exec -- no psmux/pane involved at all, unlike the root scope's
    _root_tmux_capture dance. root needs a throwaway pane because there is no
    "run one command and read its stdout" primitive over a raw tmux client
    socket; SSH already *is* exactly that primitive, so this is simpler than
    root's version, not a Windows-specific complication. Returns None if the
    machine isn't reachable right now -- distinct from {"error": ...}, same
    convention as claude_auth_status_root."""
    if not ssh_reachable(machine):
        return None
    try:
        r = _ssh_run(machine, [SSH_MACHINES[machine]["claude"], "auth", "status", "--json"],
                     timeout=CLAUDE_AUTH_TIMEOUT)
    except (subprocess.TimeoutExpired, OSError) as e:
        return {"error": f"could not ask {machine}: {e}"}
    return _parse_claude_auth_output(r.stdout, r.stderr, r.returncode)


def claude_auth_logout_ssh(machine):
    if not ssh_reachable(machine):
        raise RuntimeError(f"{machine} is not reachable over SSH right now")
    try:
        r = _ssh_run(machine, [SSH_MACHINES[machine]["claude"], "auth", "logout"],
                     timeout=CLAUDE_AUTH_TIMEOUT)
    except (subprocess.TimeoutExpired, OSError) as e:
        raise RuntimeError(f"could not ask {machine}: {e}")
    if r.returncode != 0:
        raise RuntimeError(((r.stderr or "").strip() or (r.stdout or "").strip()
                            or f"exit {r.returncode}")[:500])
    return (r.stdout or "").strip()[:500]


def claude_auth_status_all():
    result = {
        "container": claude_auth_status(),
        "host": claude_auth_status_host(),
        "root": claude_auth_status_root(),
    }
    for machine in SSH_MACHINES:
        result[f"ssh:{machine}"] = claude_auth_status_ssh(machine)
    return result


# ---- headful-Chrome cleanup ("Kill Chrome" on the 設定 page) ---------------
#
# Left running (the deployment notes), each user's chrome-debug@<user>.service
# is only ever reaped automatically after 30 minutes idle (chromedbg-reap-idle)
# -- these two give an immediate manual alternative for when that is too slow
# and the host is visibly heavier for it in the meantime.

def kill_own_chrome():
    """Stop this user's own chrome-debug@<user>.service. Restarted
    automatically on next CDP access (chromedbg-proxy-handler) -- this is a
    "throw it away, let it come back clean" action, not a permanent disable.
    Uses the same self-elevating sudo + $SUDO_USER pattern as aigw-set-email
    (/etc/sudoers.d/aigw): the wrapper can only ever stop the invoking user's
    own instance, never anyone else's."""
    try:
        r = subprocess.run(
            ["sudo", "/usr/local/sbin/chromedbg-kill-own"],
            capture_output=True, text=True, timeout=15,
        )
    except (subprocess.TimeoutExpired, OSError) as e:
        raise RuntimeError(str(e))
    if r.returncode != 0:
        raise RuntimeError((r.stderr or r.stdout or f"exit {r.returncode}").strip()[:500])


def kill_all_chrome():
    """Stop every user's chrome-debug@<user>.service, through the root tmux
    server -- same privilege boundary as root-shell/claude_auth_*_root
    (the deployment notes): this process's own privileges never change, root-ness
    comes entirely from that server being root. Gated on root_shell_allowed()
    same as those, both here and (redundantly, for the UI) on the frontend.

    the design notes' table: "chrome/kill scope=all" runs through the root
    pane, so it needs the same passkey gate as any other root action -- the
    "self" scope (kill_own_chrome, this user's own container-adjacent
    chrome-debug@<user>) never reaches this function at all and is
    correctly ungated."""
    if not root_shell_allowed():
        raise RuntimeError("root shell is not enabled for this user")
    require_unlock_if_outside_sandbox("root")
    text = _root_tmux_capture(
        "systemctl stop 'chrome-debug@*.service' && echo __OK__ || echo __FAIL__",
        lambda t: t if ("__OK__" in t or "__FAIL__" in t) else None,
        15,
    )
    if text is None:
        raise RuntimeError("no answer from the root pane")
    if "__OK__" not in text:
        raise RuntimeError("systemctl stop failed on the root pane")


# How long a login already in flight is still worth handing back instead of
# starting over. Each `claude auth login` run mints its own PKCE
# code_challenge/state, so a code obtained from one pane's URL and pasted into
# another pane fails -- with a bare "Login failed: Request failed with status
# code 400" that reads exactly like "you copied the code wrong" (measured
# 2026-08-02, when pressing the login button three times left three panes and
# two of the three attempts failed for this reason and nothing else). Hence:
# never more than one login pane, reused while its URL is plausibly still
# completable, replaced rather than duplicated once it is stale.
CLAUDE_LOGIN_MAX_AGE = 10 * 60

# The places a Claude Code can be signed in, as the API names them: scope ->
# (login preset, chat label). Each has its own pane, so "only one login at a
# time" below is per scope, not global -- logging the container in has
# nothing to do with a root (or winbox-a, or winbox-b) login already in
# flight.
CLAUDE_LOGIN_SCOPES = {
    "container": ("claude-login", "Claude ログイン"),
    "host": ("claude-login-host", "Claude ログイン (host)"),
    "root": ("claude-login-root", "Claude ログイン (root)"),
    **{f"ssh:{m}": (f"claude-login-{m}", f"Claude ログイン ({m})") for m in SSH_MACHINES},
}


def start_claude_login(scope="container"):
    """POST /claude-auth/login: hand back the session the user should paste
    their code into -- the login already running if there is a fresh one,
    otherwise a new one -- but never a second concurrent one."""
    if scope not in CLAUDE_LOGIN_SCOPES:
        raise ValueError(f"unknown scope: {scope}")
    # the design notes' table: POST /claude-auth/login {"scope": "host"|"root"}
    # needs the gate. Placed after the membership check above (so a garbage
    # scope value gets a plain "unknown scope" 400 rather than being masked
    # by a passkey prompt it could never satisfy) but before every other
    # check/side effect below -- `scope` doubles exactly as `location` means
    # everywhere else in this file ("container"/"host"/"root"/"ssh:<machine>"),
    # so it can be handed to require_unlock_if_outside_sandbox() unchanged.
    require_unlock_if_outside_sandbox(scope)
    if scope == "root" and not root_shell_allowed():
        raise ValueError("root shell is not enabled for this user")
    if scope.startswith("ssh:") and not ssh_reachable(scope.split(":", 1)[1]):
        raise ValueError(f"{scope.split(':', 1)[1]} is not reachable over SSH right now")
    preset, label = CLAUDE_LOGIN_SCOPES[scope]
    live = [m for m in list_sessions()
            if m.get("preset") == preset and m.get("alive") and not m.get("stopped")]
    live.sort(key=lambda m: m.get("created_ts", 0), reverse=True)
    reuse = live[0] if live and time.time() - live[0].get("created_ts", 0) < CLAUDE_LOGIN_MAX_AGE else None
    for m in live:
        if reuse is None or m["id"] != reuse["id"]:
            stop_session(m["id"])
    if reuse is not None:
        append_event(reuse["id"], {
            "type": "system",
            "text": "進行中のログインがあるので、それを開きました。"
                    "このペインに出ている URL をブラウザで開き、そこで表示されたコードを送信してください"
                    "(別のペインの URL で取ったコードは使えません)。",
        })
        return reuse
    return create_session(preset, label)


def claude_auth_logout_scope(scope):
    """POST /claude-auth/logout. Logging out is a one-shot command everywhere
    (only *login* needs a pane to paste a code into -- the deployment notes),
    so all three scopes answer inline with whatever the command printed."""
    if scope not in ("container", "host", "root") and not (
        scope.startswith("ssh:") and scope.split(":", 1)[1] in SSH_MACHINES
    ):
        raise ValueError(f"unknown scope: {scope}")
    # the design notes' table: POST /claude-auth/logout {"scope":
    # "host"|"root"} needs the gate, same as .../login above -- validated
    # (membership check just above) before gated, for the same "don't mask
    # a plain input error behind a passkey prompt" reason.
    require_unlock_if_outside_sandbox(scope)
    if scope == "container":
        return claude_auth_logout()
    if scope == "host":
        return claude_auth_logout_host()
    if scope == "root":
        return claude_auth_logout_root()
    return claude_auth_logout_ssh(scope.split(":", 1)[1])


# ---- working directory + resumable conversations (headless "claude" only) --
#
# Two things a phone user could otherwise not express when starting a Claude
# conversation:
#
#   cwd     - which project directory `claude -p` runs in. Without it every
#             conversation starts at the container's $HOME (~/sandhome) and
#             the agent has to be pointed at the code by hand, every time.
#   resume  - continue a Claude Code conversation that *already exists* in
#             that directory (`--resume <id>`) -- including ones started by
#             hand in a terminal, not only ones this backend created. (The
#             per-message `--resume` in _run_claude_headless_turn continues
#             the conversation this aigw session already owns; this is about
#             adopting one that predates the aigw session.)
#
# Directories are named *relative to ~/sandhome* on the wire. That directory
# is bind-mounted into the container at the same absolute path and is $HOME
# there, so a single relative name means the same thing on both sides -- and
# confining it to that subtree keeps this preset inside exactly the sandbox
# its container already defines (unlike host-shell, the host's real $HOME is
# deliberately not reachable from here).

# The UI walks the tree one level at a time (breadcrumb + "open a subfolder"
# picker) rather than being handed a flattened list of every directory, so
# there is no depth limit: any directory under ~/sandhome is reachable. Only
# the *width* of one level is capped, as a guard against a directory with
# thousands of entries -- an unusable dropdown either way.
SUBDIR_LIMIT = 500


def list_subdirs(abs_cwd):
    """Immediate subdirectories of one directory, by bare name, sorted.
    Dot-directories are left out: ~/sandhome's are tool state (`.claude`,
    `.aigw`, `.npm`, ...), never a project someone points an agent at.
    Symlinks are followed but, like every other path here, only kept if they
    stay inside ~/sandhome -- offering a choice resolve_workdir would then
    refuse would be worse than not offering it."""
    root = SANDHOME.resolve()
    out = []
    try:
        entries = sorted(os.scandir(abs_cwd or SANDHOME), key=lambda e: e.name)
    except OSError:
        return []
    for e in entries:
        if e.name.startswith("."):
            continue
        try:
            if not e.is_dir():
                continue
            if e.is_symlink():
                target = Path(e.path).resolve()
                if target != root and root not in target.parents:
                    continue
        except OSError:
            continue
        out.append(e.name)
        if len(out) >= SUBDIR_LIMIT:
            break
    return out


def resolve_workdir(rel):
    """Validate a client-supplied working directory and return it as an
    absolute path, or None to mean "wherever the container puts us" (which is
    ~/sandhome). Anything resolving outside ~/sandhome is rejected -- `..`,
    an unrelated absolute path, a symlink pointing out of the tree -- so this
    can never place an agent somewhere the sandbox itself doesn't reach."""
    if not rel or not rel.strip():
        return None
    rel = rel.strip()
    if "\x00" in rel:
        raise ValueError("invalid working directory")
    if rel.startswith("~/"):
        rel = rel[2:]
    elif rel.startswith("/"):
        # An absolute path is only meaningful if it is already the one this
        # subtree is mounted at; anything else would silently be reinterpreted
        # as a relative path ("/etc" -> ~/sandhome/etc), which is a confusing
        # way to say "rejected".
        try:
            rel = str(Path(rel).relative_to(SANDHOME))
        except ValueError:
            raise ValueError(f"working directory must be under {SANDHOME}")
    rel = rel.strip("/")
    # The UI labels these "sandhome/<x>"; accept that spelling back, but only
    # when it isn't the name of a real directory of its own.
    if rel.startswith("sandhome/") and not (SANDHOME / rel).is_dir():
        rel = rel[len("sandhome/"):]
    if not rel or rel == "sandhome":
        return None
    root = SANDHOME.resolve()
    target = (SANDHOME / rel).resolve()
    if target != root and root not in target.parents:
        raise ValueError(f"working directory must be under {SANDHOME}")
    if not target.is_dir():
        raise ValueError(f"no such directory: {rel}")
    return str(target)


# Optional, deployment-supplied site routes (the deployment notes):
# project-docs is the one aigw-backend route this applies to -- see
# aigw_site_routes.py's own docstring. A deployment with no such module
# just doesn't have this file; the one call site that checks it
# (do_GET's project-docs delegation) falls through to a 404 when it's None.
try:
    import aigw_site_routes
except ImportError:
    aigw_site_routes = None


class _SiteContext:
    """What aigw_site_routes needs from this file, handed over explicitly
    rather than imported back -- this file has no .py extension and isn't
    meant to be imported."""

    def __init__(self):
        self.resolve_workdir = resolve_workdir
        self.list_subdirs = list_subdirs
        self.sandhome = SANDHOME


SITE_CTX = _SiteContext()


# ---- drive/folder picker for a drives-capable ssh machine (the deployment notes) ----
#
# winbox-a/winbox-b only (SSH_MACHINES[machine]["drives"]) -- linuxbox is a
# real Linux box with one filesystem root, so it has no "drive" to choose and
# never reaches these. Paths here are MSYS2 posix form ("/d/Projects/foo",
# same convention SSH_MACHINES' own "claude"/"bash" entries already use for
# these two machines), sent straight to `tmux new-session -c` -- MSYS2's tmux
# resolves them the same way it resolves its own launch command's path.

_SSH_DRIVE_LETTER_RE = re.compile(r"^[a-z]$")


def list_ssh_drives(machine):
    """Fixed filesystem drive letters currently present on a drives-capable
    ssh machine, lowercase, sorted -- each is a real mount point at
    `/<letter>` in that machine's MSYS2 environment. `wmic logicaldisk` (the
    obvious one-liner) no longer exists on current Windows builds (confirmed
    absent on winbox-a, 2026-09-15); PowerShell's Get-PSDrive is not."""
    r = _ssh_run(machine, [
        "powershell", "-NoProfile", "-Command",
        "Get-PSDrive -PSProvider FileSystem | Select-Object -ExpandProperty Name",
    ])
    if r.returncode != 0:
        return []
    return sorted(
        line.strip().lower() for line in r.stdout.splitlines()
        if re.fullmatch(r"[A-Za-z]", line.strip())
    )


def list_ssh_subdirs(machine, path):
    """Immediate subdirectories of one directory on a drives-capable ssh
    machine, by bare name, sorted, dot-directories left out -- same shape and
    reasoning as list_subdirs() above, just over ssh (`ls -1p`, a trailing
    "/" marks a directory) instead of os.scandir(). No symlink-containment
    check: unlike ~/sandhome there is no single root to stay inside (a shell
    on this machine already hands the caller its whole filesystem -- see
    resolve_ssh_workdir)."""
    r = _ssh_run(machine, ["ls", "-1p", "--", path])
    if r.returncode != 0:
        return []
    out = []
    for line in r.stdout.splitlines():
        if not line.endswith("/") or line.startswith("."):
            continue
        out.append(line[:-1])
        if len(out) >= SUBDIR_LIMIT:
            break
    return sorted(out)


def resolve_ssh_workdir(machine, path):
    """Validates a client-supplied working directory for a drives-capable ssh
    machine and returns it unchanged (a posix MSYS2 path, e.g.
    "/d/Projects/foo"), or None for "no directory chosen yet" (the pane then
    starts wherever its own login shell would land).

    Unlike resolve_workdir there is no single sandbox root to contain this
    to: picking this machine's Claude preset already hands the caller that
    Windows account's whole filesystem, the same as any other ssh:<machine>
    preset. So this only rejects shapes that could never be a real path (not
    a genuine containment boundary) -- missing leading "/", a first segment
    that isn't a single drive letter, or a "."/".."/empty segment further in,
    which would otherwise silently collapse into some other directory than
    the one shown in the picker."""
    if not path or not path.strip():
        return None
    path = path.strip()
    if "\x00" in path or not path.startswith("/"):
        raise ValueError("cwd must be an absolute MSYS2 path (e.g. /d/Projects)")
    segments = path.split("/")[1:]
    if not segments or not _SSH_DRIVE_LETTER_RE.match(segments[0]):
        raise ValueError("cwd must start with a drive letter (e.g. /d)")
    if any(not seg or seg in (".", "..") for seg in segments[1:]):
        raise ValueError("cwd must not contain empty or '..' segments")
    return path


# project-docs (the deployment notes) moved out to the optional
# aigw_site_routes module (the deployment notes) -- see
# handle_backend_get() there, and the SITE_CTX/aigw_site_routes import
# below (near resolve_workdir/list_subdirs). It isn't a generic feature:
# it shells out to a per-project vendored binary discovered on this
# host's own filesystem.
#
# claude.ai org seat admin (the deployment notes) was ToS-disabled
# 2026-08-28 (ai-design#claude-admin-tier-tos) and both its routes were
# already dead code with nothing calling run_claude_admin_tier() at all --
# deleted outright rather than moved, since there was no live feature left
# to give an extension point to.


def claude_project_dir(abs_cwd, home=None):
    """Where Claude Code keeps the conversation logs for one working
    directory: `$HOME/.claude/projects/<cwd, every non-alphanumeric character
    replaced by "-">/<conversation-id>.jsonl`. Inside the container $HOME is
    ~/sandhome -- the very directory this process is looking at -- so listing
    resumable conversations is an ordinary directory read here, with no
    `sandbox exec` round-trip. That default is `home`'s default too, since
    every caller except _watch_shell_claude/_resolve_claude_conversation is
    container-only (see _claude_home_for_location for why those two pass
    something else for "root"/"host")."""
    key = re.sub(r"[^A-Za-z0-9]", "-", abs_cwd or str(SANDHOME))
    return (home or SANDHOME) / ".claude" / "projects" / key


def _claude_home_for_location(location):
    """The real $HOME a `claude` process sees for a given tmux_location --
    claude_project_dir()'s own SANDHOME default is correct only for
    "container" (see its docstring: $HOME is bind-mounted to sandhome
    there). "root"'s pane runs as literal root (aigw-root-tmux@<user>.
    service, see the deployment notes), so its logs land in /root/.claude/
    projects instead -- readable by this backend's own uid only via the
    read-only ACL bridge aigw-root-tmux-grant sets up on that path
    (the deployment notes); without it, a root-shell
    session's replies never reach the chat log (the raw tmux screen mirror
    still worked, since that reads the pane content over the tmux protocol,
    not the filesystem). "host" runs as this very backend's own OS user
    directly, so its real $HOME (not the container's mounted sandhome) is
    just HOME."""
    if location == "root":
        return Path("/root")
    if location == "host":
        return HOME
    return SANDHOME


def _remote_claude_project_dir_key(machine, posix_cwd):
    """The same [A-Za-z0-9-] key claude_project_dir() builds, but for a
    `claude` process actually running on an ssh: machine (winbox-a/
    winbox-b) instead of this host.

    Both machines are MSYS2 (confirmed 2026-08-15: `uname -a` on winbox-a's
    /usr/bin/bash itself reports "Msys", not WSL -- the WSL install
    SSH_MACHINES' comment warns about is a second, unused bash on the same
    box), so `posix_cwd` (tmux's own pane_current_path, e.g.
    "/c/Users/alice/foo") is MSYS2's own path rendering, not the one Claude
    Code -- a native Windows Node.js process -- sees as its own cwd. `claude
    --version` confirmed real, current `claude` on both. What its own
    ~/.claude/projects/<key> naming is built from was confirmed empirically
    by listing existing project dirs there (e.g. "C--Users-alice" next to a
    pane whose cwd was /c/Users/alice): Windows' own path form, "-"
    substituted for every non-alphanumeric character exactly like
    claude_project_dir() -- and since ":"/"/" and ":"/"\\" both collapse to
    the same "-"-separated key, `cygpath -w` (forward slashes) and Claude
    Code's own os.homedir()-based rendering (backslashes) land on an
    identical key without needing to match separator style, only which
    characters count as "alphanumeric".

    Returns None if the remote cygpath call itself fails (machine
    unreachable, etc.) -- callers treat that the same as "nothing to show
    yet", not as an error, matching claude_project_dir()'s own OSError
    handling at each call site."""
    r = _ssh_run(machine, ["/usr/bin/cygpath", "-w", posix_cwd], timeout=10)
    if r.returncode != 0:
        return None
    return re.sub(r"[^A-Za-z0-9]", "-", r.stdout.strip())


def _ssh_list_jsonl(machine, key):
    """Remote equivalent of `[(p.name, p.stat().st_mtime) for p in
    proj_dir.iterdir() if p.suffix == '.jsonl']` for _remote_claude_project_
    dir_key(machine, ...)'s directory -- one ssh round trip, using `find`
    instead of the local Path methods _tail_claude_transcript/
    _watch_shell_claude otherwise use, since that directory is on the
    machine's own filesystem, not this host's.

    key is safe to interpolate unquoted into the shell command below
    because it was already sanitized down to [A-Za-z0-9-] by
    _remote_claude_project_dir_key -- never call this with any other
    string. `~` needs real shell expansion (MSYS2's $HOME, "/c/Users/
    alice"), which is exactly what _ssh_run's own argv-by-argv shlex.quote()
    forecloses -- see _ssh_invoke's docstring -- so this goes through
    _ssh_invoke directly with a hand-built command instead.

    The returned names are filtered through CLAUDE_CONV_ID_RE (passkey/root
    the design review, 2026-08-30) before going back to the caller.
    _resolve_claude_conversation's remote branch stores the newest one
    verbatim as conv["claude_session_id"], which list_subagents' own remote
    branch then interpolates unquoted (`base = f"...{conv['claude_session_
    id']}..."`) into a further ssh command string -- the exact same shape of
    value that same function already refuses to trust for a subagent id
    (`if not CLAUDE_CONV_ID_RE.match(agent_id): continue  # defense in depth
    before the unquoted path below`). Both machines behind SSH_MACHINES
    share one account, so this was never a privilege-boundary bug
    (nothing to escalate *to* on a single-account box) -- only an
    inconsistency between validating the same kind of value in one place
    and not the other. Filtering here, at the one place a remote `find`
    result enters the process, means every caller (list_subagents, the
    session-tailing loop in the watcher) gets the same guarantee instead of
    each one re-deriving it."""
    # /usr/bin/find, not bare "find": Windows' own System32\find.exe (a
    # totally different program, DOS's in-file text search) shadows it --
    # measured 2026-08-15, same PATH-ordering class of bug SSH_MACHINES'
    # own comment already pins bash/tmux/claude against, just hitting a
    # command none of those needed before. stat/tail/cat below do not
    # collide with any Windows-native command of the same name (checked
    # empirically), so only this one needs the absolute path.
    cmd = f"/usr/bin/find $HOME/.claude/projects/{key} -maxdepth 1 -name '*.jsonl' -printf '%T@ %f\\n' 2>/dev/null"
    r = _ssh_invoke(machine, cmd, timeout=10)
    if r.returncode != 0:
        return []
    out = []
    for line in r.stdout.splitlines():
        try:
            mtime_s, name = line.split(" ", 1)
        except ValueError:
            continue
        # name is "<conv-id>.jsonl" from a remote `find -name '*.jsonl'` --
        # matches the `*.jsonl` glob but is otherwise whatever bytes the
        # remote filesystem happens to hold. Reject anything whose stem
        # isn't a well-formed conversation id (see this docstring above)
        # rather than silently passing it through as a plausible-looking
        # entry that later code trusts more than it should.
        conv_id = name[:-len(".jsonl")] if name.endswith(".jsonl") else name
        if not CLAUDE_CONV_ID_RE.match(conv_id):
            continue
        try:
            out.append((name, float(mtime_s)))
        except ValueError:
            continue
    return out


def _ssh_read_new(machine, key, filename, offset):
    """Remote equivalent of the local tailers' `size = target_path.stat().
    st_size; ...; f.seek(offset); chunk = f.read(size - offset)`. Returns
    (new_bytes, current_size); current_size is None if the file couldn't be
    examined at all (deleted, machine unreachable) -- treat that like the
    local code's `except OSError: continue`, not like an error.

    filename must be a bare `<conversation-id>.jsonl` from _ssh_list_jsonl's
    own listing -- validated against CLAUDE_CONV_ID_RE before ever reaching
    the shell command string below (that listing is this process's own,
    never outside input, but the check costs nothing and matches how
    resolve_resume_id already gates a conversation id before use). One
    round trip: `stat` for the current size and `tail -c` for the new bytes
    both run in the same remote command, since a session's chat log is
    tailed multiple times a second and a second ssh hop per poll would
    double the already-noticeable double-hop latency for no reason.

    text=False on the underlying _ssh_invoke call: this is someone's actual
    conversation text (UTF-8), and `tail -c +N` cuts at a byte offset with
    no regard for multi-byte character boundaries, so decoding must wait
    until the caller has buffered up to the next newline -- exactly like
    the local tailers' own `.open("rb")` reads."""
    conv_id = filename[:-len(".jsonl")] if filename.endswith(".jsonl") else filename
    if not CLAUDE_CONV_ID_RE.match(conv_id):
        return b"", None
    path = f"$HOME/.claude/projects/{key}/{filename}"
    cmd = f'sz=$(stat -c%s "{path}" 2>/dev/null) || exit 1; echo "$sz"; tail -c +{offset + 1} "{path}" 2>/dev/null'
    r = _ssh_invoke(machine, cmd, timeout=10, text=False)
    if r.returncode != 0:
        return b"", None
    try:
        first_nl = r.stdout.index(b"\n")
    except ValueError:
        return b"", None
    try:
        size = int(r.stdout[:first_nl])
    except ValueError:
        return b"", None
    return r.stdout[first_nl + 1:], size


CLAUDE_CONV_ID_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{7,63}$")
# How far into a conversation log to read looking for something to label it
# with. The first user message is near the top and these files can reach tens
# of megabytes, so this never reads a whole one.
CONV_SUMMARY_SCAN_BYTES = 256 * 1024


def _user_message_text(obj):
    content = (obj.get("message") or {}).get("content")
    if isinstance(content, list):
        content = " ".join(
            c.get("text", "") for c in content
            if isinstance(c, dict) and c.get("type") == "text"
        )
    if not isinstance(content, str):
        return ""
    text = " ".join(content.split())
    # Slash-command envelopes and harness-injected preambles are byte-for-byte
    # identical across conversations, so they can't tell two of them apart.
    if not text or text.startswith("<") or text.startswith("Caveat:"):
        return ""
    return text


def _conversation_summary(path):
    """A short human label for one conversation log: its stored summary if it
    has one, else the first real user message, else "" (the UI falls back to
    the timestamp)."""
    read = 0
    try:
        with path.open("r", errors="replace") as f:
            for line in f:
                read += len(line)
                if read > CONV_SUMMARY_SCAN_BYTES:
                    break
                try:
                    obj = json.loads(line)
                except ValueError:
                    continue
                if obj.get("type") == "summary" and obj.get("summary"):
                    return str(obj["summary"])[:120]
                if obj.get("type") == "user":
                    text = _user_message_text(obj)
                    if text:
                        return text[:120]
    except OSError:
        pass
    return ""


def _claude_session_labels():
    """{claude_session_id: label} across every aigw session this user has
    (any preset, any cwd, alive or not) -- so the "続きから" resume list can
    show the name given to a conversation *in aigw*, not just Claude Code's
    own auto-generated summary (2026-08-29, at the user's request: "aigw で
    設定した名前も表示できませんか"). Cheap (plain meta.json reads, no tmux/
    live round trips, same directory listing list_sessions() already does),
    so this is just recomputed on every call rather than cached -- a session
    renamed a moment ago should show up immediately, not go stale."""
    labels = {}
    if not SESSIONS_DIR.exists():
        return labels
    for d in SESSIONS_DIR.iterdir():
        if not d.is_dir():
            continue
        meta = load_meta(d.name)
        if meta is None:
            continue
        cid = meta.get("claude_session_id")
        label = meta.get("label")
        if cid and label:
            labels[cid] = label
    return labels


def list_claude_conversations(abs_cwd, limit=40):
    """Claude Code conversations already recorded for `abs_cwd`, newest
    first -- the candidates for `--resume`."""
    try:
        files = [p for p in claude_project_dir(abs_cwd).iterdir() if p.suffix == ".jsonl"]
    except OSError:
        return []
    out = []
    for p in files:
        try:
            out.append({"id": p.stem, "mtime": p.stat().st_mtime, "path": p})
        except OSError:
            continue
    out.sort(key=lambda e: e["mtime"], reverse=True)
    del out[limit:]
    aigw_labels = _claude_session_labels()
    for e in out:
        e["aigw_label"] = aigw_labels.get(e["id"])
        e["summary"] = _conversation_summary(e.pop("path"))
    return out


def resolve_resume_id(abs_cwd, resume_id):
    """Check that a requested conversation id really is one of `abs_cwd`'s
    own logs before it is ever passed to `claude --resume`."""
    if not resume_id:
        return None
    if not CLAUDE_CONV_ID_RE.match(resume_id):
        raise ValueError("invalid conversation id")
    if not (claude_project_dir(abs_cwd) / f"{resume_id}.jsonl").is_file():
        raise ValueError("no such conversation in that directory")
    return resume_id


MIN_PANE_COLS = 20
MAX_PANE_COLS = 500
MIN_PANE_ROWS = 10
MAX_PANE_ROWS = 1000

# Fallback pane height for a TMUX_PRESETS session (create_session's "-y")
# when no client-supplied row count is available (see _clamp_pane_rows) --
# e.g. a session created by something other than the PWA. Was a flat 300
# for every session regardless of caller until 2026-08-31; see that date's
# comment on SCREEN_LINES below for why a fixed height that size was itself
# the bug, not just this fallback's value. 50 is not a measurement of
# anything -- it is simply "closer to an ordinary terminal than 300 was",
# picked the same way the pre-2026-08-03 default was.
PANE_ROWS = 50


def _clamp_pane_cols(cols):
    """A client-supplied column count (see the deployment notes), or None
    if absent/nonsense -- caller falls back to the preset's own default."""
    try:
        cols = int(cols)
    except (TypeError, ValueError):
        return None
    if cols < MIN_PANE_COLS or cols > MAX_PANE_COLS:
        return None
    return cols


def _clamp_pane_rows(rows):
    """Same shape as _clamp_pane_cols, for the client-measured row count
    (the deployment notes, 2026-08-31) -- None if absent/nonsense,
    caller falls back to PANE_ROWS."""
    try:
        rows = int(rows)
    except (TypeError, ValueError):
        return None
    if rows < MIN_PANE_ROWS or rows > MAX_PANE_ROWS:
        return None
    return rows


# The one-time "do you trust this folder" gate Claude Code shows before its
# normal chat UI, the first time it runs in a given directory -- distinct
# from (and not skipped by) --dangerously-skip-permissions, which only
# covers tool-use confirmations *inside* an already-trusted conversation.
TRUST_DIALOG_MARKER = "Yes, I trust this folder"
# Once past the gate (whether just accepted here or already trusted before),
# this status line is always present -- used as "stop polling, there is
# nothing more to accept" so an already-trusted directory does not pay the
# full timeout on every single session creation.
TUI_READY_MARKER = "bypass permissions on"
TRUST_DIALOG_POLL_INTERVAL = 0.3
TRUST_DIALOG_POLL_TIMEOUT = 8


def _accept_workspace_trust_if_shown(location, tmux_name):
    """Without this, a brand-new session's very first message can vanish
    with no visible cause: the trust dialog discards typed text outright
    (it is a selection menu, not a text field) and the Enter that follows it
    confirms whatever is highlighted -- "1. Yes, I trust this folder" is the
    default -- instead of submitting anything. This is the same failure mode
    the deployment notes already documented for a modal appearing
    *mid-conversation* (screen panel lets the user see and route around it
    with 送信/実行), except here it is the *first* message, sent the moment
    a session is created -- nobody has any reason to check the screen panel
    for a conversation they have not started yet, so the modal always wins.

    Accepting it here is not a new grant of trust: `resolve_workdir` already
    confines every directory a "claude-tui" session can start in to the
    user's own $HOME/sandhome, and skip_permissions already defaults this
    preset to --dangerously-skip-permissions on the same reasoning
    (the deployment notes) -- nothing done inside the container
    exceeds what the user's own account could already do.

    Polls rather than assuming a fixed delay, and does nothing beyond the
    single Enter if the marker never appears (already trusted, or an
    unusually slow start) -- capped by TRUST_DIALOG_POLL_TIMEOUT so a
    session create request cannot hang indefinitely on this."""
    deadline = time.time() + TRUST_DIALOG_POLL_TIMEOUT
    while time.time() < deadline:
        r = tmux_exec(location, ["capture-pane", "-p", "-t", tmux_name])
        if r.returncode == 0:
            if TRUST_DIALOG_MARKER in r.stdout:
                tmux_exec(location, ["send-keys", "-t", tmux_name, "Enter"])
                return
            if TUI_READY_MARKER in r.stdout:
                return  # already past the gate -- nothing to accept
        time.sleep(TRUST_DIALOG_POLL_INTERVAL)


def create_session(preset, label, cwd=None, resume=None, skip_permissions=True, cols=None, rows=None):
    if preset not in PRESETS:
        raise ValueError(f"unknown preset: {preset}")
    # the design notes: gate as early as this function can possibly know
    # where it's about to run -- before the cwd/resume validation below,
    # before root_shell_allowed()/ssh_reachable(), and well before any side
    # effect (mkdir'ing the session directory, save_meta, the tmux calls
    # further down). A hand-crafted request for a host/root preset must
    # never get further than this line without an open unlock window; the
    # UI already hides these presets in that case (applyCapabilities()),
    # same "belt and suspenders" spirit as the root_shell_allowed() check
    # a few lines below.
    location = TMUX_PRESETS[preset]["location"] if preset in TMUX_PRESETS else "container"
    require_unlock_if_outside_sandbox(location)
    # A drives-capable ssh machine's Claude preset (winbox-a/winbox-b, never
    # linuxbox -- see SSH_MACHINES' own "drives" field) also takes a cwd, from
    # that machine's own drives/folders rather than ~/sandhome -- see
    # resolve_ssh_workdir and the deployment notes.
    ssh_drive_machine = None
    if preset in CLAUDE_TUI_PRESETS and location.startswith("ssh:"):
        candidate = location.split(":", 1)[1]
        if SSH_MACHINES.get(candidate, {}).get("drives"):
            ssh_drive_machine = candidate
    if resume and preset not in CWD_PRESETS:
        # No notion of a prior conversation outside the two local Claude
        # presets -- the plain shells have none, and a drives-capable ssh
        # machine's Claude preset has no way to list its own remote
        # conversation history (see CWD_PRESETS' own comment).
        raise ValueError(f"resume only applies to the {'/'.join(sorted(CWD_PRESETS))} presets")
    if cwd and not (preset in CWD_PRESETS or ssh_drive_machine):
        # The plain shells get their directory from the pane itself (`sandbox
        # exec`'s own workdir, or TMUX_PRESETS' "cwd") and have no notion of a
        # working directory to pick, so silently ignoring this would be worse
        # than saying so.
        raise ValueError(
            f"cwd only applies to the {'/'.join(sorted(CWD_PRESETS))} presets, "
            "or a drives-capable ssh machine's Claude preset"
        )
    if ssh_drive_machine:
        abs_cwd = resolve_ssh_workdir(ssh_drive_machine, cwd)
        resume_id = None
    else:
        abs_cwd = resolve_workdir(cwd)
        resume_id = resolve_resume_id(abs_cwd, resume)
    # Pre-assign the Claude Code conversation id itself, before `claude` ever
    # runs, instead of guessing which on-disk .jsonl in the (possibly shared)
    # project directory belongs to this pane after the fact -- see aigw-
    # design#shell-claude-tail-cross-session-claim for the incident this
    # closes (two root-shell sessions in the same cwd, one silently locked
    # onto the other's conversation forever), and the deployment notes
    # tail-resumable-retry for a second, independent way the same guessing
    # can wedge a session shut permanently. Only for a genuinely NEW
    # conversation (resume_id already names an existing, unambiguous file)
    # and only where this process can inject the id directly:
    # CLAUDE_TUI_PRESETS (aigw launches `claude`/`_tui_claude` itself for
    # all of these, local or ssh:<machine> alike, so this is a plain extra
    # flag on inner_command either way) and the interactive shells --
    # "shell"/"host-shell"/"root-shell" locally, SSH_SHELL_PRESETS
    # ("shell-<machine>") over ssh: -- where aigw does not launch `claude`
    # itself, so the id is instead handed to a shell function so a bare
    # `claude` picks it up transparently (see
    # _inject_claude_session_id_wrapper). Originally restricted to non-ssh:
    # locations altogether, on the assumption that MSYS2's real bash/tmux
    # would mangle the function-body text `send-keys` types in -- verified
    # live 2026-09-16 against both winbox-a and winbox-b (`type claude` came
    # back byte-for-byte intact) that this was never actually true: it is
    # the exact same `_ssh_run`/shlex.quote path (the deployment notes,
    # fixed 2026-08-14) already relied on for every other ssh: tmux call,
    # and the id itself (hex digits and hyphens only) never needed quoting
    # in the first place. Still not "attach" (adopt_session, not this
    # function -- there is no moment before the pane existed to inject
    # anything into).
    assigned_claude_session_id = None
    if resume_id is None and (
            preset in CLAUDE_TUI_PRESETS or
            preset in ("shell", "host-shell", "root-shell") or
            preset in SSH_SHELL_PRESETS):
        assigned_claude_session_id = str(uuid.uuid4())
    if preset == "root-shell" and not root_shell_allowed():
        # The UI already hides the option (GET /capabilities). Without the
        # socket the tmux call below would fail anyway; this is just the
        # clean error for a hand-crafted request.
        raise ValueError("root shell is not enabled for this user (aigw-root-tmux@<user>.service)")
    if preset in TMUX_PRESETS and TMUX_PRESETS[preset]["location"].startswith("ssh:"):
        machine = TMUX_PRESETS[preset]["location"].split(":", 1)[1]
        if not ssh_reachable(machine):
            # The UI already hides options for unreachable machines (GET
            # /capabilities' ssh_machines) -- same shape as the root-shell
            # check above, just network-reachability instead of a socket.
            raise ValueError(f"{machine} is not reachable over SSH right now")
    session_id = uuid.uuid4().hex[:12]
    sdir = session_dir(session_id)
    (sdir / "outbox").mkdir(parents=True)
    (sdir / "output.log").touch()
    (sdir / "events.jsonl").touch()
    # tmux_name is kept separate from the aigw session id (they happen to be
    # equal for panes we create, but not for adopted ones), and tmux_location
    # says which of the two tmux servers -- container or host -- it lives in;
    # send_message/send_key/stop_session/list_sessions all key off these two.
    # (`location` itself was already computed above, before the unlock gate.)
    meta = {
        "id": session_id,
        "label": label or preset,
        "preset": preset,
        "tmux_name": session_id,
        "tmux_location": location,
        "created_ts": time.time(),
        "stopped": False,
        "ended_ts": None,
        # Pre-seeding this with a conversation the user picked is the whole
        # mechanism behind "resume": the very first turn then runs with
        # `--resume <id>` exactly the way every later turn does.
        # assigned_claude_session_id (see its own comment above) fills this
        # the same way for a brand-new conversation whose id this process
        # picked itself -- _watch_shell_claude/_tail_claude_transcript/
        # _resolve_claude_conversation all already treat a present
        # claude_session_id as "known, don't guess" regardless of which of
        # the two actually put it here.
        "claude_session_id": resume_id or assigned_claude_session_id,
        "resumed_from": resume_id,
        "cwd": abs_cwd,
        # Only meaningful for "claude-tui" (see the inner_command build below);
        # recorded for every preset anyway so meta.json always shows what was
        # actually asked for, not just what took effect.
        "skip_permissions": bool(skip_permissions),
        "archived": False,
    }
    save_meta(session_id, meta)

    if preset in HEADLESS_PRESETS:
        # Headless mode: nothing to start yet. The first POST /messages drives
        # the first turn (see _run_claude_headless_turn); there is no
        # per-session process between turns -- one `claude -p` subprocess is
        # started per message and exits when that turn is done.
        ensure_watcher(session_id)  # still tails outbox/ for images
        meta["alive"] = True
        return meta

    # AIGW_OUTBOX tells whatever is running in this pane where to drop a file
    # to have it shown as an image/attachment in the chat -- a vendor-agnostic
    # convention (see the outbox handling in _watch_tmux_session), not a protocol
    # specific to any one tool. `env VAR=value cmd` (not `tmux -e`, which
    # needs a newer tmux than what's guaranteed here) keeps this portable.
    # The session directory lives under ~/sandhome, which is bind-mounted into
    # the container at the *same absolute path*, so this one AIGW_OUTBOX value
    # is correct for a host pane and a container pane alike.
    outbox_path = str(sdir / "outbox")
    spec = TMUX_PRESETS[preset]
    inner_command = list(spec["command"])
    # Opt-out (default on) skip of Claude Code's own tool-use/trust
    # confirmations, for the claude-tui presets only -- the plain shells
    # have no such prompts, and the headless "claude" preset already
    # hardcodes this unconditionally in _run_claude_headless_turn (see
    # the deployment notes), so this only ever changes behavior for the
    # interactive TUI presets.
    if preset in CLAUDE_TUI_PRESETS and skip_permissions:
        inner_command.append("--dangerously-skip-permissions")
    if spec.get("remote_control"):
        inner_command.append(f"--remote-control={remote_control_name(meta)}")
    if resume_id:
        # Interactive `--resume <id>` picks up that conversation directly
        # rather than opening the picker, same as the headless path.
        inner_command += ["--resume", resume_id]
    elif assigned_claude_session_id and preset in CLAUDE_TUI_PRESETS:
        # The interactive shells can't take a flag here -- aigw never invokes
        # `claude` for them, the user does, by hand, whenever they feel like
        # it (see _inject_claude_session_id_wrapper instead, called after the
        # pane exists further down). Every CLAUDE_TUI_PRESETS member, local
        # or ssh:<machine> alike, launches `claude`/`_tui_claude` itself via
        # this same inner_command -- a linuxbox `claude` notice wrapper
        # included, since it `exec`s straight into the real `claude` with
        # "$@" untouched.
        inner_command += ["--session-id", assigned_claude_session_id]
    # AIGW_OUTBOX tells whatever is running in this pane where to drop a file
    # to have it shown as an image/attachment in the chat -- a vendor-agnostic
    # convention (see the outbox handling in _watch_tmux_session), not a
    # protocol specific to any one tool. `env VAR=value cmd` (not `tmux -e`,
    # which needs a newer tmux than what's guaranteed here) keeps this
    # portable. The session directory lives under ~/sandhome, which is
    # bind-mounted into the container at the *same absolute path*, so this
    # one AIGW_OUTBOX value is correct for a host pane and a container pane
    # alike -- but not for an ssh:<machine> pane, which shares no filesystem
    # with this host at all, so there is nowhere for an outbox file to land;
    # those get inner_command completely unwrapped. Deliberately not reused
    # to also carry AIGW_SESSION_ID for SSH_SHELL_PRESETS: unlike "tmux"/
    # "bash"/"claude", SSH_MACHINES has no per-machine "env" path, and a bare
    # "env" here would need PATH lookup on whatever launched the tmux
    # server -- exactly the class of bug winbox-b already hit once for a
    # bare, non-absolute command (the deployment notes' PATH-missing-
    # msys64 incident). Simpler to not need an "env" binary at all: this id
    # goes to the pane via `export` typed by _inject_claude_session_id_
    # wrapper itself, a shell builtin in the already-confirmed-reachable
    # bash, instead.
    if location.startswith("ssh:"):
        command = inner_command
    else:
        env_pairs = [f"AIGW_OUTBOX={outbox_path}"]
        if assigned_claude_session_id and preset in ("shell", "host-shell", "root-shell"):
            # Read back by the shell function _inject_claude_session_id_
            # wrapper defines further down, once the pane exists.
            env_pairs.append(f"AIGW_SESSION_ID={assigned_claude_session_id}")
        command = ["env", *env_pairs, *spec.get("env", []), *inner_command]
    # Precedence: the directory the user picked, else the preset's own fixed
    # one (root-shell), else -- for host panes only -- their home, because a
    # host pane would otherwise inherit this systemd service's cwd ("/").
    # Container panes need no fallback: `sandbox exec` starts them in
    # ~/sandhome already (that is the sandbox CLI's own default). abs_cwd
    # is the same string on both sides of the bind mount, so it is correct
    # for either location.
    # None for ssh:<machine>, UNLESS ssh_drive_machine picked one above (a
    # posix MSYS2 path like "/d/Projects/foo", equally valid to hand tmux's
    # `-c` on that machine) -- every other ssh:<machine> preset still has
    # cwd/resume rejected above, so this stays None for those, same as before.
    cwd = abs_cwd or spec.get("cwd") or (os.path.expanduser("~") if location == "host" else None)
    start_dir = ["-c", cwd] if cwd else []
    # The client measures how many monospace columns its own screen actually
    # fits and sends that at creation time (see the deployment notes) --
    # applies to every TMUX_PRESETS entry alike. This only ever sets the
    # *initial* size: `window-size` is still the tmux default ("latest"), so
    # a real terminal attaching later (SSH into host-shell/root-shell, say)
    # still gets to resize the window to its own size as normal -- the screen
    # panel just scrolls horizontally from that point on rather than trying
    # to hold the phone's width against a real client's own terminal.
    width = str(_clamp_pane_cols(cols) or spec.get("width", 220))
    # Same idea as width, one paragraph up, but for height -- see
    # the deployment notes (2026-08-31) for why a client-measured
    # row count matters here at all, not just for horizontal fit.
    height = str(_clamp_pane_rows(rows) or PANE_ROWS)
    # Three tmux calls rather than one, so that the pane outlives the program
    # running in it (`remain-on-exit`). Without it, whatever a program prints
    # immediately before exiting was unreachable: the tmux session vanished
    # with the process, so the watcher's very next capture-pane just failed
    # and the last screen was gone. `claude auth login` is the case that
    # forced this -- its entire answer, success or "Login failed: ...", is
    # printed on the way out (measured 2026-08-02), so the chat only ever
    # showed "session ended" and every login looked like it had failed.
    #
    # remain-on-exit is a *window* option, so it can only be set once the
    # window exists -- and setting it right after `new-session -- <real
    # command>` is a race that the programs we most care about win: each
    # `sandbox exec` costs ~100ms, and a program that dies instantly is
    # exactly the one whose error must not be lost. So the pane is created
    # running `cat` (prints nothing, never exits on its own), the option is
    # set, and only then is the real command respawned into that same pane.
    # This is unchanged for ssh:<machine>: MSYS2 tmux's own `cat` plays
    # exactly the same role there (see the deployment notes for why
    # these run real MSYS2 tmux rather than psmux, tried first).
    r = tmux_exec(location, ["new-session", "-d", "-s", session_id, "-x", width, "-y", height, *start_dir, "--", "cat"])
    if r.returncode != 0 and location.startswith("ssh:"):
        # A cold MSYS2/Cygwin tmux-server fork can still be starting up well
        # past tmux_exec's own extended timeout for this call (measured
        # 2026-08-14, winbox-a: over 90s in one case) -- it is not hung, just
        # slow, and does eventually finish. Rather than treat our own wait's
        # timeout as the final answer, keep polling for the session to
        # actually appear (see _wait_for_ssh_session) before giving up.
        if _wait_for_ssh_session(location, session_id):
            r = subprocess.CompletedProcess(r.args, 0, r.stdout, "")
    if r.returncode != 0:
        # Best-effort cleanup so a failed attempt never leaves a stray
        # session behind: for ssh:<machine>, "failed" can mean our own local
        # wait timed out (a cold tmux-server fork -- see tmux_exec/_ssh_run)
        # while the remote new-session succeeded anyway, so kill whatever
        # might actually exist under this name before removing our own
        # meta.json/session dir (session_dir(session_id) was created earlier
        # in this function). Without this, the caller saw no session (the
        # exception below is all that reaches them), but a later session
        # list could show this id's ghost meta.json, or list_untracked_
        # tmux_sessions could show an orphaned real tmux session with no
        # aigw record at all pointing back to it -- either way, confusing
        # (measured 2026-08-14: exactly this, from a create_session call
        # that raised on a 15s timeout while the remote fork kept going).
        tmux_exec(location, ["kill-session", "-t", session_id])
        shutil.rmtree(sdir, ignore_errors=True)
        raise RuntimeError(f"failed to start tmux session: {r.stderr.strip()}")
    tmux_exec(location, ["set-option", "-t", session_id, "remain-on-exit", "on"])
    r = tmux_exec(location, ["respawn-pane", "-k", "-t", session_id, *start_dir, "--", *command])
    if r.returncode != 0:
        tmux_exec(location, ["kill-session", "-t", session_id])
        shutil.rmtree(sdir, ignore_errors=True)
        raise RuntimeError(f"failed to start tmux session: {r.stderr.strip()}")

    if preset in CLAUDE_TUI_PRESETS:
        _accept_workspace_trust_if_shown(location, session_id)
    elif assigned_claude_session_id and (
            preset in ("shell", "host-shell", "root-shell") or preset in SSH_SHELL_PRESETS):
        _inject_claude_session_id_wrapper(
            location, session_id,
            session_id_value=assigned_claude_session_id if preset in SSH_SHELL_PRESETS else None)

    # No pipe-pane here: output is read via _watch_tmux_session's
    # capture-pane polling (see its docstring), same as an adopted session.
    ensure_watcher(session_id)
    meta["alive"] = True
    return meta


def _inject_claude_session_id_wrapper(location, tmux_name, session_id_value=None):
    """Defines a `claude` shell function in a freshly-spawned "shell"/
    "host-shell"/"root-shell"/SSH_SHELL_PRESETS ("shell-<machine>") pane
    that transparently adds `--session-id "$AIGW_SESSION_ID"` to a bare
    `claude` invocation -- see the deployment notes
    claim for why guessing which on-disk .jsonl belongs to which pane after
    the fact is unreliable once two panes share a cwd.

    session_id_value: only needed for SSH_SHELL_PRESETS. The local presets
    already have AIGW_SESSION_ID exported into the pane's environment
    before this function's caller even runs (create_session's own `env`
    prefix on the command that starts the pane) -- a shell *variable*
    survives that fine, only a shell *function* does not reliably cross an
    `export -f` (disabled by default on modern bash), which is why the
    function body still has to be typed in here regardless. ssh:<machine>
    panes get no such `env` prefix at all (create_session's own comment on
    why: no per-machine "env" path exists in SSH_MACHINES, and a bare "env"
    would need PATH lookup on whatever launched the tmux server -- exactly
    the class of bug winbox-b already hit once for a bare, non-absolute
    command, the deployment notes), so for those this instead types an
    `export AIGW_SESSION_ID=...` line first, a plain shell builtin needing
    no new binary or path at all.

    Skips the override when the user's own invocation already passes
    --session-id/-r/--resume, so a deliberate manual resume of a different,
    specific conversation is never silently overridden.

    Safe to call with no delay after respawn-pane/new-session returns: a pty
    queues keystrokes typed before the foreground program has issued its
    first read() (ordinary terminal type-ahead), so this does not need to
    wait for the login shell to finish starting up -- verified against a
    real `bash -l` pane, immediately after respawn-pane, with no sleep at
    all. This is a property of the *target* machine's own pty layer, not of
    however the tmux command reached it, so it holds just the same for an
    ssh:<machine> pane: by the time the ssh round trip carrying `new-session`
    returns, that machine's tmux has already synchronously forked the pane's
    shell and its pty exists, queuing ready and waiting -- confirmed live
    2026-09-16 against both winbox-a and winbox-b's MSYS2 bash panes, no
    corruption or drop from the injected text (both the `export` line and
    the function body below).

    `clear` afterward just keeps the one-time setup line(s) off the screen
    the user is about to look at; it has no effect on `_watch_shell_claude`'s
    own foreground detection either way (`bash` -- or MSYS2 bash reporting
    the same via `_is_claude_foreground`'s path-tail match -- not `claude`,
    throughout)."""
    if session_id_value is not None:
        tmux_exec(location, ["send-keys", "-t", tmux_name,
                              f"export AIGW_SESSION_ID={shquote(session_id_value)}", "Enter"])
    func = (
        'claude() { case " $* " in '
        '*" --session-id "*|*" -r "*|*" --resume "*) command claude "$@";; '
        '*) command claude --session-id "$AIGW_SESSION_ID" "$@";; '
        'esac; }'
    )
    tmux_exec(location, ["send-keys", "-t", tmux_name, func, "Enter"])
    tmux_exec(location, ["send-keys", "-t", tmux_name, "clear", "Enter"])


def shquote(s):
    # Minimal single-quote shell-escaping for one-liners handed to `sh -c`
    # (see _run_claude_headless_turn). Paths/text here are always our own
    # session-id-derived values or the message text itself, never arbitrary
    # unrelated user input.
    return "'" + s.replace("'", "'\\''") + "'"


# How long a single headless `claude -p` turn is allowed to run before we
# kill it. Generous on purpose -- a real agentic turn (reading files, running
# commands) can legitimately take a while; this is a backstop against a truly
# hung process, not a soft budget.
CLAUDE_TURN_TIMEOUT = 30 * 60

# session_id -> subprocess.Popen, present only while a headless claude
# invocation for that session is in flight (used by stop_session and to
# reject overlapping messages -- `--resume` on the same session id must be
# serialized, not run concurrently).
_claude_running = {}
_claude_running_lock = threading.Lock()


def _kill_claude_container_process(session_id):
    """Kill the actual claude process inside the container's pid namespace
    (see the pid_file comment in _run_claude_headless_turn for why this,
    rather than killing the local `sandbox exec` client, is required).
    `kill` is a shell builtin, not a standalone binary, on this minimal
    Debian image -- `docker exec ... kill ...` fails with "executable file
    not found"; go through `sh -c` instead."""
    pid_file = session_dir(session_id) / "claude.pid"
    if not pid_file.exists():
        return
    pid = pid_file.read_text().strip()
    if pid.isdigit():
        r = sandbox_exec(["sh", "-c", f"kill -9 {pid}"])
        if r.returncode != 0:
            log(f"failed to kill claude pid {pid} for {session_id}: {r.stderr.strip()}")


def _kill_after_timeout(proc, session_id, timeout):
    time.sleep(timeout)
    if proc.poll() is None:
        proc.kill()
        _kill_claude_container_process(session_id)
        log(f"claude turn for {session_id} killed after {timeout}s timeout")


def remote_control_name(meta):
    """Name for a pane's `--remote-control` session (the "claude-tui" preset),
    so it is recognisable as one of this user's aigw conversations in
    claude.ai/code and the mobile app. Labels are free text (Japanese, spaces,
    anything), so only [A-Za-z0-9-] survives; the aigw session id is appended
    because two conversations may share a label."""
    label = re.sub(r"[^A-Za-z0-9-]+", "-", meta.get("label") or "").strip("-")[:24]
    return f"aigw-{label}-{meta['id'][:6]}" if label else f"aigw-{meta['id']}"


# `--remote-control` is deliberately NOT passed here -- it belongs to the
# "claude-tui" preset. Measured 2026-08-02: with `-p` the flag is accepted
# (exit 0, normal result, no warning) but has no observable effect -- two
# concurrent runs, one with it and one without, were indistinguishable in
# `claude agents --json`, and the name given was not used. Even if it did
# register, a headless turn is one short-lived process per message, so any
# entry would appear and vanish per message rather than being a session to
# drive (see the deployment notes).
def _run_claude_headless_turn(session_id, text):
    """Runs one turn of a headless Claude Code conversation: `claude
    --dangerously-skip-permissions -p "<text>" --output-format stream-json
    [--resume <prior-session-id>]`, via `sandbox exec` (never raw docker).
    No TUI, no tmux pane -- just a subprocess we read JSON lines from, which
    is what makes this fit an append-only chat log at all (see the PRESETS
    comment for why the interactive TUI can't). Runs in its own thread so
    POST /messages returns immediately; the eventual result is appended as a
    normal agent_output event and triggers a push notification directly
    (no need to round-trip through the notify HTTP listener -- we already
    know synchronously, in this same process, the exact moment the turn
    finishes)."""
    sdir = session_dir(session_id)
    meta = load_meta(session_id)
    if meta is None:
        return
    outbox_path = str(sdir / "outbox")

    # Recording our own PID *inside the container's pid namespace* (via a
    # tiny `sh -c 'echo $$ > pidfile; exec ...'` wrapper -- `exec` replaces
    # the shell without changing pid, so $$ ends up being claude's own pid)
    # is what makes stop/timeout actually work. Without it, killing the local
    # `sandbox exec` client (a `docker exec` wrapper) only kills that local
    # client -- the real process keeps running inside the container, orphaned
    # under PID 1, invisible and unkillable from here. Discovered by testing:
    # `stop` appeared to work but the container-side claude process was still
    # alive minutes later.
    pid_file = sdir / "claude.pid"
    # `sandbox exec` (docker exec) drops us at the container's own workdir,
    # ~/sandhome; a session created with a working directory cd's from there.
    # The path is the same string on both sides of the bind mount, and was
    # validated to be inside ~/sandhome at create_session time
    # (resolve_workdir) -- but it can still have been renamed or deleted
    # since, so failing here has to be visible rather than silently running
    # the turn in the wrong place.
    inner = ""
    if meta.get("cwd"):
        msg = shquote("aigw: cannot enter working directory " + meta["cwd"])
        inner += f"cd {shquote(meta['cwd'])} || {{ echo {msg} >&2; exit 1; }}; "
    inner += (
        f"echo $$ > {shquote(str(pid_file))}; exec env AIGW_OUTBOX={shquote(outbox_path)} "
        f"claude --dangerously-skip-permissions "
        f"-p {shquote(text)} --output-format stream-json --verbose"
    )
    if meta.get("claude_session_id"):
        inner += f" --resume {shquote(meta['claude_session_id'])}"

    try:
        proc = subprocess.Popen(
            ["sandbox", "exec", "--", "sh", "-c", inner],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
        )
    except OSError as e:
        append_event(session_id, {"type": "system", "text": f"failed to start claude: {e}"})
        return

    with _claude_running_lock:
        _claude_running[session_id] = proc
    threading.Thread(target=_kill_after_timeout, args=(proc, session_id, CLAUDE_TURN_TIMEOUT), daemon=True).start()

    # Marker file (not just the in-memory _claude_running dict) so that
    # aigw-reap-idle -- a separate root-run process with no visibility into
    # this process's memory -- can tell not to stop aigw-backend@<user> right
    # now: doing so would SIGKILL this whole cgroup, including this very
    # `sandbox exec -- claude ...` child process, abruptly killing a
    # possibly-long-running turn.
    busy_marker = sdir / "busy"
    busy_marker.touch()

    result_text = None
    new_claude_session_id = None
    cost_usd = None
    try:
        for line in proc.stdout:
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            obj_type = obj.get("type")
            if obj_type == "system" and obj.get("subtype") == "init":
                new_claude_session_id = obj.get("session_id")
            elif obj_type == "result":
                result_text = obj.get("result")
                new_claude_session_id = obj.get("session_id", new_claude_session_id)
                cost_usd = obj.get("total_cost_usd")
        proc.wait(timeout=30)
    except Exception as e:
        log(f"claude turn error for {session_id}: {e}")
    finally:
        with _claude_running_lock:
            _claude_running.pop(session_id, None)
        busy_marker.unlink(missing_ok=True)
        pid_file.unlink(missing_ok=True)

    if new_claude_session_id and new_claude_session_id != meta.get("claude_session_id"):
        meta["claude_session_id"] = new_claude_session_id
        save_meta(session_id, meta)

    if result_text:
        append_event(session_id, {"type": "agent_output", "text": result_text, "cost_usd": cost_usd})
        send_push_notification(session_id, result_text[:200])
    else:
        stderr_tail = ""
        try:
            stderr_tail = (proc.stderr.read() or "")[-2000:]
        except Exception:
            pass
        append_event(session_id, {
            "type": "system",
            "text": f"claude produced no result (exit {proc.returncode}). {stderr_tail}".strip(),
        })



def send_message(session_id, text, submit=True, from_user=None):
    """`submit` is what the composer's 実行 button means and 送信 does not:
    whether an Enter follows the literal text. Splitting the two is the only
    way to reach a pane that is *not* waiting on a text prompt -- a Claude
    Code selection menu, say, where the text is discarded and the Enter would
    confirm whatever option happens to be highlighted (see the deployment notes). It
    also covers the other direction: text with no Enter, so that Tab
    completion or a program's own multi-key sequence can be driven from the
    composer instead of the soft keyboard.

    Empty text with submit=True is a bare Enter, exactly what the soft
    keyboard's Enter sends -- and, like it, is not written to the chat log:
    a keystroke is not a message. Headless presets have no pane and no keys,
    so `submit` does not apply to them (the caller is rejected earlier)."""
    meta = load_meta(session_id)
    location = meta.get("tmux_location", "container") if meta else "container"
    # Gated BEFORE the chat log is touched (the design notes), not after: the
    # headless "claude" preset is exempted here (it always runs in this
    # user's own container, tmux_location notwithstanding -- it has no tmux
    # pane at all) because the branch below returns before ever reaching a
    # tmux_exec() call. Gating after append_event() below would have let a
    # denied message still show up in the chat log as if it had been sent --
    # exactly the "実行/送信 was ignored" failure mode fixed 2026-08-29 for
    # the tmux-command-failed case, reopened here for the passkey-gate case
    # if the ordering were wrong.
    if not (meta and meta.get("preset") == "claude"):
        require_unlock_if_outside_sandbox(location)
    if text:
        event = {"type": "user_message", "text": text}
        if not submit:
            # Absent on every event written before this existed, and on every
            # ordinary send since -- so the frontend reads "missing" as True.
            event["submit"] = False
        if from_user:
            # Only ever set for a shared collaborator (the deployment notes), never
            # for the owner's own messages -- renderEvent() uses this to
            # show who actually typed a given line in a co-worked session.
            event["from"] = from_user
        append_event(session_id, event)
    if meta and meta.get("preset") == "claude":
        with _claude_running_lock:
            already_running = session_id in _claude_running
        if already_running:
            append_event(session_id, {
                "type": "system",
                "text": "Claude is still working on the previous message -- please wait for it to finish.",
            })
            return
        threading.Thread(target=_run_claude_headless_turn, args=(session_id, text), daemon=True).start()
        return
    tmux_name = meta.get("tmux_name", session_id) if meta else session_id
    # (`location` was already computed, and gated, at the top of this
    # function.)
    # Both send-keys calls' results used to be discarded outright -- a
    # transient tmux/container hiccup (the container briefly overloaded, the
    # pane already gone, ...) made `tmux send-keys` fail with a nonzero
    # returncode, but the event above had already been written to the chat
    # log and this function returned normally regardless, so the caller
    # (below) always answered 202 {"ok": true}. From the phone this looked
    # exactly like "実行/送信 was ignored": the bubble appears, nothing ever
    # reaches the pane, and there is nothing telling the user to retry
    # (reported 2026-08-29). Raising here lets the do_POST route answer with
    # a real error instead, which the frontend already knows how to show
    # (the deployment notes) -- the same alert-and-
    # restore-the-text path added 2026-08-17 for the network-error case.
    if text:
        r = tmux_exec(location, ["send-keys", "-t", tmux_name, "-l", "--", text])
        if r.returncode != 0:
            raise RuntimeError(f"tmux send-keys failed: {(r.stderr or r.stdout).strip()}")
    if submit:
        r = tmux_exec(location, ["send-keys", "-t", tmux_name, "Enter"])
        if r.returncode != 0:
            raise RuntimeError(f"tmux send-keys (Enter) failed: {(r.stderr or r.stdout).strip()}")


# A software keyboard for the tmux/shell preset needs to send tmux *key
# names* (Up, C-c, M-Left, ...), not literal text -- so this is deliberately
# a separate endpoint rather than reusing send_message's `-l` literal-text
# path. We never pass an arbitrary client-supplied string straight through to
# `tmux send-keys` without `-l`: tmux's own command-line syntax treats a bare
# `;` as a command separator (e.g. `send-keys Up \; kill-session`), so an
# unvalidated key name would be a command-injection vector into tmux itself.
#
# Instead of an ever-growing literal allowlist (a terminal can send a LOT --
# every Ctrl/Alt+letter-or-digit combo, every named key), we accept a
# *base* key plus ctrl/alt modifier flags and construct the tmux key name
# ourselves ("C-" / "M-" prefixes, tmux's own modifier notation, combinable)
# from strictly-validated parts only. This covers "anything a real terminal
# can send" (every Ctrl/Alt combo with a letter, digit, or named key) without
# ever concatenating unvalidated client input into the command.
BASE_KEY_RE = re.compile(r"^[a-z0-9]$")
NAMED_BASE_KEYS = {
    "Up", "Down", "Left", "Right", "Home", "End", "PageUp", "PageDown",
    "Tab", "BTab", "Escape", "Enter", "BSpace", "DC", "IC", "Space",
    "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12",
}


def send_key(tmux_name, location, base, ctrl=False, alt=False, shift=False):
    # the design notes: a software-keyboard keystroke into a host/root pane is
    # exactly as much a sandbox-outside action as typing a whole message
    # into one (send_message) -- gate first, before any of the key-name
    # validation/construction below, since none of that matters if this call
    # is going to be denied anyway.
    require_unlock_if_outside_sandbox(location)
    # Ctrl+Shift+<letter> vs Ctrl+<letter> need to be genuinely distinguishable
    # (not every terminal/app tells them apart, but tmux's own key table does,
    # via case): for a single letter, shift is expressed by the letter's case
    # (tmux's own convention -- "C-A" is bound distinctly from "C-a"), not a
    # prefix. Named keys have no case, so shift uses tmux's "S-" prefix there
    # instead (e.g. "S-Left" for shift-selecting text left one word).
    if BASE_KEY_RE.match(base):
        letter = base.upper() if (shift and base.isalpha()) else base
        key = ("C-" if ctrl else "") + ("M-" if alt else "") + letter
    elif base in NAMED_BASE_KEYS:
        key = ("C-" if ctrl else "") + ("S-" if shift else "") + ("M-" if alt else "") + base
    else:
        raise ValueError(f"key not allowed: {base}")
    tmux_exec(location, ["send-keys", "-t", tmux_name, key])


def stop_session(session_id):
    meta = load_meta(session_id)
    if meta and meta.get("preset") == "claude":
        with _claude_running_lock:
            proc = _claude_running.get(session_id)
        if proc and proc.poll() is None:
            proc.kill()  # local sandbox-exec/docker-exec client
        _kill_claude_container_process(session_id)  # the actual claude process
    else:
        tmux_name = meta.get("tmux_name", session_id) if meta else session_id
        location = meta.get("tmux_location", "container") if meta else "container"
        # the design notes: stopping a host/root pane is a sandbox-outside
        # action -- gate before the actual kill-session below. The "claude"
        # branch above never reaches here (it always runs in this user's own
        # container), so this is the only place in this function that ever
        # touches a location other than "container".
        require_unlock_if_outside_sandbox(location)
        tmux_exec(location, ["kill-session", "-t", tmux_name])
    meta = load_meta(session_id)
    if meta:
        meta["stopped"] = True
        meta["alive"] = False
        meta["ended_ts"] = time.time()
        save_meta(session_id, meta)
    append_event(session_id, {"type": "session_ended"})


def delete_session(session_id):
    """Permanently remove a session's conversation history. Force-stops it
    first (safe/idempotent even if already stopped) so deleting a still-live
    session doesn't leave an orphaned tmux session or claude subprocess
    behind."""
    meta = load_meta(session_id)
    if meta and not meta.get("stopped"):
        stop_session(session_id)
    shutil.rmtree(session_dir(session_id), ignore_errors=True)
    with _subscribers_lock:
        _subscribers.pop(session_id, None)
    with _seq_lock:
        _next_seq.pop(session_id, None)
    with _latest_screen_lock:
        _latest_screen.pop(session_id, None)
    with _screen_backlog_lock:
        _screen_backlog.pop(session_id, None)
    with _watchers_lock:
        _watchers_started.discard(session_id)


def rename_session(session_id, label):
    """Just the display label -- everything else about the session (tmux
    pane, conversation history, preset) is untouched. `label` is free text
    the same way create_session's own "名前(任意)" field already is (no
    charset restriction: it's never used to build a path or a shell
    command, only ever echoed back in JSON/HTML, which escape_html already
    covers on the frontend)."""
    meta = load_meta(session_id)
    if meta is None:
        raise ValueError("no such session")
    label = label.strip()
    if not label:
        raise ValueError("label must not be empty")
    meta["label"] = label
    save_meta(session_id, meta)
    return meta


def archive_session(session_id, archived):
    """Hides (archived=True) or restores (False) a session in the list --
    a display flag next to "label", same as rename_session above. Touches
    nothing else: tmux pane, conversation history and preset are all
    untouched, and a still-alive session can be archived without being
    stopped (the deployment notes)."""
    meta = load_meta(session_id)
    if meta is None:
        raise ValueError("no such session")
    meta["archived"] = bool(archived)
    save_meta(session_id, meta)
    return meta


def _load_next_seq(session_id):
    events_path = session_dir(session_id) / "events.jsonl"
    if not events_path.exists():
        return 1
    n = 0
    with events_path.open("r") as f:
        for _ in f:
            n += 1
    return n + 1


OUTBOX_MODEL3D_SUFFIXES = {"glb", "gltf"}
OUTBOX_IMAGE_SUFFIXES = {"png", "jpg", "jpeg", "gif", "webp", "bmp", "svg"}


def outbox_attachment_kind(filename):
    """What a file dropped in a session's outbox/ actually is, for the chat
    log to render appropriately: an inline image, a tappable 3D-model
    viewer, or (anything else -- e.g. a batch media job's zip) a plain
    attachment link. Detected from the extension only -- outbox files come
    from whatever tool produced them (media-cli's generators, or
    any other AI CLI writing to $AIGW_OUTBOX) with no Content-Type of their
    own to trust, the same reasoning response_filename in lm_tool.py
    already uses on the other end of this same convention.

    Added 2026-08-15 alongside the "attachment" event type below -- before
    this, EVERY outbox file was unconditionally announced as an "image"
    event, so a generated .glb (see the deployment notes) just rendered
    as a broken <img> with no way to actually see it."""
    suffix = filename.rsplit(".", 1)[-1].lower() if "." in filename else ""
    if suffix in OUTBOX_IMAGE_SUFFIXES:
        return "image"
    if suffix in OUTBOX_MODEL3D_SUFFIXES:
        return "model3d"
    return "file"


# ---- Chat -> session attachments ("inbox", 2026-09-08) ---------------------
#
# The mirror image of outbox above: outbox is a tool inside the session
# dropping a file for the *chat* to show; this is the *user*, on their phone,
# handing a photo to whatever is running in the session. There is no protocol
# for that beyond "the file exists somewhere Read() can reach, and the
# session was told its path" -- Claude Code (or any other CLI in a pane) has
# no notion of a chat attachment, only file paths in its prompt. So this
# saves the upload and hands back an absolute path *as seen from that
# session's own location*; the frontend inserts that path as literal text
# into the composer, and the existing send flow (send_message/tmux send-keys,
# or the headless turn's own prompt argument) does the rest unchanged -- no
# new wire protocol into the pane itself.
INBOX_DIR_NAME = "aigw-inbox"  # relative to $HOME on an ssh:<machine> box, mirroring ~/sandhome/.aigw/<id>/inbox locally
MAX_INBOX_BYTES = 15 * 1024 * 1024  # decoded size -- comfortably above a phone photo, small enough a mis-picked video doesn't wedge a request/the ssh transfer


def session_inbox_dir(session_id):
    d = session_dir(session_id) / "inbox"
    d.mkdir(parents=True, exist_ok=True)
    return d


def _sanitize_inbox_filename(name):
    """Basename only, and only the OUTBOX_NAME_RE charset -- the client-
    supplied filename must never be able to steer where this lands (path
    traversal) or collide with shell/path syntax on the ssh:<machine> leg
    below, which shells the filename through a real remote bash."""
    base = os.path.basename(name or "") or "upload"
    base = re.sub(r"[^A-Za-z0-9._-]", "_", base)[:200]
    return base or "upload"


def save_inbox_attachment(session_id, meta, filename, data):
    """Writes an uploaded attachment where the session's own pane can Read()
    it and returns the absolute path AS SEEN FROM THAT PANE.

    container/host/root share one filesystem (same trick create_session's
    AIGW_OUTBOX already relies on -- ~/sandhome is bind-mounted into the
    container at the identical absolute path), so the host-side path this
    function writes to is already correct there, unchanged.

    ssh:<machine> shares no filesystem with this host at all (the deployment notes
    machines-arch), so the file is scp'd over into ~/aigw-inbox/<session-id>/
    on that machine, and the answer is the Windows-style path `cygpath -w`
    reports back -- the remote Claude Code is a native Windows build
    (claude.exe under MSYS2 tmux, not WSL), so a POSIX-style /c/Users/...
    path in the prompt would not resolve for it."""
    safe_name = _sanitize_inbox_filename(filename)
    stamped_name = f"{int(time.time() * 1000)}_{safe_name}"
    location = meta.get("tmux_location", "container")
    if location.startswith("ssh:"):
        machine = location.split(":", 1)[1]
        tmp_path = None
        try:
            with tempfile.NamedTemporaryFile(delete=False) as tf:
                tf.write(data)
                tmp_path = tf.name
            remote_dir = f"{INBOX_DIR_NAME}/{session_id}"
            r = _ssh_run(machine, ["mkdir", "-p", remote_dir], timeout=15)
            if r.returncode != 0:
                raise RuntimeError(f"could not create the inbox directory on {machine}")
            remote_rel = f"{remote_dir}/{stamped_name}"
            # scp/sftp resolve a relative remote path against the login
            # user's home, same as `_ssh_run`'s remote bash starts there --
            # so remote_rel means the same directory on both sides below.
            # Same ControlPath/ControlMaster/ControlPersist as _ssh_invoke,
            # so this reuses that already-warm connection instead of paying
            # for a second double-hop handshake.
            control_path = f"{SSH_CONTROL_DIR}/{os.getuid()}-%r@%h:%p"
            scp = subprocess.run(
                ["scp", "-F", SSH_CONFIG_PATH,
                 "-o", f"ControlPath={control_path}", "-o", "ControlMaster=auto", "-o", "ControlPersist=10m",
                 "-o", "ConnectTimeout=10", tmp_path, f"{machine}:{remote_rel}"],
                capture_output=True, timeout=60,
            )
            if scp.returncode != 0:
                raise RuntimeError((scp.stderr or scp.stdout or b"scp failed").decode(errors="replace")[:500])
            # -a: absolute. Without it, cygpath only swaps separators
            # (aigw-inbox/x/y -> aigw-inbox\x\y) rather than resolving
            # against $HOME the way scp/sftp themselves just did for the
            # upload above -- a relative path here would only Read()
            # correctly if Claude's own process cwd happened to match,
            # which nothing guarantees (measured 2026-09-08: without -a this
            # came back as "aigw-inbox\\<id>\\<file>" instead of
            # "C:\\Users\\alice\\aigw-inbox\\<id>\\<file>").
            r = _ssh_run(machine, ["cygpath", "-w", "-a", remote_rel], timeout=15)
            if r.returncode != 0 or not r.stdout.strip():
                raise RuntimeError(f"uploaded to {machine} but could not resolve its Windows-side path")
            return r.stdout.strip()
        except (subprocess.TimeoutExpired, OSError) as e:
            raise RuntimeError(str(e))
        finally:
            if tmp_path:
                os.unlink(tmp_path)
    else:
        path = session_inbox_dir(session_id) / stamped_name
        path.write_bytes(data)
        return str(path)


# Marks an outbox file as this backend's own immutable snapshot (see
# _freeze_outbox_snapshot) rather than something a session dropped -- the
# watcher loops skip anything with this prefix so they never try to
# "announce" their own snapshots as if they were new attachments.
FROZEN_SNAPSHOT_PREFIX = "_frozen_"


def _freeze_outbox_snapshot(outbox, name, mtime):
    """Copies outbox/`name` (currently at `mtime`) to an immutable sibling
    file inside outbox/, so that a tool overwriting `name` later (e.g. a
    visualization script that always writes diagram.png, or a 3D-generation
    tool re-run with the same output name) can never change what an
    *already-announced* chat attachment displays. Applied to every
    attachment kind (image, model3d, file) at the user's request even
    though it doubles disk usage per overwrite -- see
    the deployment notes for the tradeoff (a
    repeatedly-overwritten multi-hundred-MB .glb costs one full copy per
    version, forever, since outbox/ is never cleaned up).

    Returns the frozen file's name (to put in the "attachment" event
    instead of `name`); reuses an existing snapshot if this exact (name,
    mtime) was already frozen, e.g. by a previous watcher run before a
    backend restart."""
    frozen_name = f"{FROZEN_SNAPSHOT_PREFIX}{int(mtime * 1_000_000)}_{name}"
    frozen_path = outbox / frozen_name
    if not frozen_path.exists():
        shutil.copy2(outbox / name, frozen_path)
    return frozen_name


def _scan_outbox_for_attachments(session_id, outbox, seen_files):
    """One poll's worth of outbox/ scanning, shared by _watch_session
    (headless presets) and _watch_tmux_session (everything else) -- both
    used to carry this identical block inline. Extracted 2026-09-01, at
    the user's request for a codebase health pass: this exact mechanism
    is also the single most bug-prone spot in either watcher's history
    (the deployment notes, #outbox-seen-files-same-name,
    #outbox-overwrite-immutable-snapshot, three separate fixes inside ten
    days) -- two copies meant a fix applied to one call site and missed
    at the other was a real, not just theoretical, risk.

    Mutates `seen_files` in place (a (name, mtime) set both callers
    already own and pass by reference, same as before extraction) and
    calls append_event directly for each newly-seen file; nothing is
    returned."""
    if not outbox.exists():
        return
    for p in outbox.iterdir():
        if p.is_file() and not p.name.startswith(FROZEN_SNAPSHOT_PREFIX):
            key = (p.name, p.stat().st_mtime)
            if key not in seen_files:
                seen_files.add(key)
                kind = outbox_attachment_kind(p.name)
                announce_name = _freeze_outbox_snapshot(outbox, p.name, key[1])
                append_event(session_id, {
                    "type": "attachment", "filename": announce_name,
                    "kind": kind,
                    "mtime": key[1],
                    "source_filename": p.name,
                })


def append_event(session_id, event):
    with _seq_lock:
        if session_id not in _next_seq:
            _next_seq[session_id] = _load_next_seq(session_id)
        seq = _next_seq[session_id]
        _next_seq[session_id] += 1
    event = {"seq": seq, "ts": time.time(), **event}
    line = json.dumps(event)
    with (session_dir(session_id) / "events.jsonl").open("a") as f:
        f.write(line + "\n")
    with _subscribers_lock:
        for q in _subscribers.get(session_id, []):
            q.put(event)
    return event


def events_page(session_id, before=None, limit=50):
    """A page of settled events.jsonl history, newest-first-selected but
    returned oldest-first (like the file itself) -- for the chat UI's lazy
    history load (the deployment notes): showing only the last
    couple of screens on open, then fetching further back only once the user
    actually scrolls up, instead of replaying a whole (possibly thousands of
    lines) conversation through SSE every time a session is opened.

    No `before`: the last `limit` events (the initial "tail"). With
    `before=<seq>`: the `limit` events immediately preceding that seq (an
    older page). `has_more` tells the client whether an even-older page
    still exists, so it can stop trying once the top of the conversation is
    reached."""
    events_path = session_dir(session_id) / "events.jsonl"
    try:
        raw_lines = events_path.read_text().splitlines()
    except OSError:
        raw_lines = []
    events = []
    for raw in raw_lines:
        try:
            events.append(json.loads(raw))
        except ValueError:
            continue
    if before is not None:
        events = [e for e in events if e.get("seq", 0) < before]
    has_more = len(events) > limit
    return events[-limit:] if limit else events, has_more


def _already_announced_attachments(session_id):
    """(filename, mtime) pairs this session has already emitted an
    "attachment"/"image" event for, read back from events.jsonl -- the seed
    for a freshly (re)started watcher's in-memory seen_files, so a backend
    restart doesn't make it rediscover every file still sitting in outbox/
    (nothing ever deletes them, since GET /sessions/<id>/files/<filename>
    keeps serving them) and re-announce them all as new. See
    the deployment notes.

    Keyed on mtime as well as filename (not filename alone) so that a tool
    which always writes to the same output filename -- e.g. a visualization
    script overwriting diagram.png on every run -- gets announced again when
    it does, instead of being silently invisible forever after the first
    time (see the deployment notes). Events recorded
    before that fix carry no "mtime" field; for those, seal in the file's
    current on-disk mtime as the baseline so only a *future* overwrite (not
    the one already announced) triggers a fresh announcement.

    The name half of the key is the outbox file the watcher actually
    scanned (`source_filename`), not the possibly-frozen `filename` an image
    event displays (see _freeze_outbox_snapshot) -- otherwise, after a
    restart, the loop's `(p.name, p.stat().st_mtime)` over the live outbox/
    file would never match a seen_files entry keyed by the frozen name, and
    every image would be re-frozen and re-announced on every restart.
    Events from before frozen snapshots existed have no `source_filename`,
    where `filename` itself was always the source."""
    keyed = set()
    names_no_mtime = set()
    events_path = session_dir(session_id) / "events.jsonl"
    if not events_path.exists():
        return keyed
    with events_path.open("r") as f:
        for line in f:
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if ev.get("type") in ("attachment", "image") and ev.get("filename"):
                src_name = ev.get("source_filename") or ev["filename"]
                if "mtime" in ev:
                    keyed.add((src_name, ev["mtime"]))
                else:
                    names_no_mtime.add(src_name)
    if names_no_mtime:
        outbox = session_dir(session_id) / "outbox"
        for name in names_no_mtime:
            try:
                keyed.add((name, (outbox / name).stat().st_mtime))
            except OSError:
                pass  # file no longer on disk -- nothing to seal against
    return keyed


def push_ephemeral(session_id, event):
    """Send an event to connected SSE clients *without* recording it in
    events.jsonl. Used for the live screen: it changes on every keystroke and
    is a snapshot of right now, so persisting it would bloat the conversation
    log with thousands of superseded frames and replay them all on reload.
    A client that connects later fetches the current screen via
    GET /sessions/<id>/screen instead of replaying these."""
    with _subscribers_lock:
        subs = list(_subscribers.get(session_id, []))
    for q in subs:
        q.put({"ts": time.time(), **event})


def ensure_watcher(session_id):
    with _watchers_lock:
        if session_id in _watchers_started:
            return
        _watchers_started.add(session_id)
    meta = load_meta(session_id)
    if meta and meta.get("stopped"):
        # Already ended -- nothing left to poll for (no more output, no more
        # outbox files, no pane to capture), so no watcher/tailer thread is
        # needed at all. Without this, every one of this backend's restarts
        # spun one up anyway for every already-stopped session it had ever
        # seen, and its outbox-scan loop below re-announced every attachment
        # that session ever received as a fresh "attachment" event on its
        # first pass (a real, persisted duplicate in events.jsonl, not just a
        # display glitch) -- see the deployment notes.
        return
    # Headless presets (claude) have no tmux pane to poll -- only
    # outbox-watching applies to them, which _watch_session still handles.
    # Everything else is a real tmux pane ("shell" or an adopted "attach"
    # session alike), watched the same way via capture-pane polling.
    headless = meta and meta.get("preset") in HEADLESS_PRESETS
    target = _watch_session if headless else _watch_tmux_session
    t = threading.Thread(target=target, args=(session_id,), daemon=True)
    t.start()
    # "claude-tui" additionally gets its chat-log content from Claude Code's
    # own conversation log rather than from the capture-pane watcher above
    # (see _tail_claude_transcript) -- a second, independent thread, not a
    # replacement for it, since the tmux watcher above still owns the screen
    # panel and dead-pane detection either way.
    if meta and meta.get("preset") == "claude-tui":
        ensure_transcript_tailer(session_id)
    elif meta and meta.get("preset") not in HEADLESS_PRESETS:
        # "shell"/"host-shell"/"root-shell"/"attach": no fixed cwd or fixed
        # "this pane runs claude" the way "claude-tui" has, so this watches
        # for the user running `claude` interactively *inside* the pane by
        # hand (see _watch_shell_claude) and switches the chat log over to
        # the same transcript-tailing approach only while that's happening.
        ensure_shell_claude_watcher(session_id)


def ensure_transcript_tailer(session_id):
    with _transcript_tailers_lock:
        if session_id in _transcript_tailers_started:
            return
        _transcript_tailers_started.add(session_id)
    t = threading.Thread(target=_tail_claude_transcript, args=(session_id,), daemon=True)
    t.start()


def ensure_shell_claude_watcher(session_id):
    with _shell_claude_watchers_lock:
        if session_id in _shell_claude_watchers_started:
            return
        _shell_claude_watchers_started.add(session_id)
    t = threading.Thread(target=_watch_shell_claude, args=(session_id,), daemon=True)
    t.start()


def _watch_session(session_id):
    sdir = session_dir(session_id)
    log_path = sdir / "output.log"
    outbox = sdir / "outbox"
    offset = 0
    seen_files = _already_announced_attachments(session_id)
    last_liveness_check = 0.0
    try:
        while True:
            time.sleep(0.7)

            if log_path.exists():
                size = log_path.stat().st_size
                if size > offset:
                    with log_path.open("rb") as f:
                        f.seek(offset)
                        chunk = f.read(size - offset)
                    offset = size
                    text = clean_terminal_text(chunk.decode("utf-8", errors="replace"))
                    if text.strip("\n"):
                        append_event(session_id, {"type": "agent_output", "text": text})

            _scan_outbox_for_attachments(session_id, outbox, seen_files)

            now = time.time()
            if now - last_liveness_check > 5:
                last_liveness_check = now
                meta = load_meta(session_id)
                # Headless sessions have no persistent tmux session to go
                # check -- between turns that's normal, not "ended", so this
                # auto-stop-on-death check only applies to tmux presets.
                if meta and not meta.get("stopped") and meta.get("preset") not in HEADLESS_PRESETS:
                    if session_id not in list_tmux_sessions():
                        meta["stopped"] = True
                        meta["alive"] = False
                        meta["ended_ts"] = time.time()
                        save_meta(session_id, meta)
                        append_event(session_id, {"type": "session_ended"})
                        return
    except Exception as e:  # watcher must never crash the process
        log(f"watcher for {session_id} exiting on error: {e}")


# How far back into scrollback each poll looks, so that output printed
# faster than TMUX_POLL_INTERVAL between two polls doesn't scroll off the
# visible pane and get missed entirely before we ever see it.
TMUX_CAPTURE_HISTORY_LINES = 1000
# Finer than the old pipe-pane tailer's 0.7s: this drives the settled/
# live-tail split below, so a shorter interval means each "settled" chunk is
# smaller and the live tail updates more smoothly.
TMUX_POLL_INTERVAL = 0.3

# Fallback for how many trailing rows of the capture make up the "current
# screen" view, used only if a poll's own #{pane_height} (read live below,
# _watch_tmux_session) can't be parsed. Before 2026-08-31 this was the only
# such value, hardcoded equal to the also-hardcoded PANE_ROWS -- correct as
# long as every pane really was that height, which stopped being true once
# create_session/resize_session started sizing panes per-client
# (the deployment notes). Reading the live height instead of
# trusting this constant is what actually matters now; this fallback only
# covers a poll where that reading itself failed.
SCREEN_LINES = PANE_ROWS

# tmux's own marker line, added to a pane whose program has exited while
# `remain-on-exit` keeps the pane around (see create_session). Recognising it
# is how the watcher learns both *that* the pane died and *with what status*,
# at no extra cost: the line is already in the capture it just took, so no
# second `tmux` call per poll. It is tmux's own wording and not localised.
PANE_DEAD_RE = re.compile(r"^Pane is dead \(status (\d+)[,)].*$")


def _screen_lines_scrolled_off(prev_lines, new_lines):
    """Which of prev_lines are no longer anywhere in new_lines -- i.e. have
    permanently scrolled off the top of the pane between these two polls,
    and belong in _screen_backlog before they are lost for good
    (the deployment notes, 2026-09-01).

    Finds the *first* (leftmost) matching block between the two line lists
    via difflib and returns everything in prev_lines before it -- not
    find_longest_match(), which for a pane whose bottom few lines (a
    static composer border, say) happen to repeat identically poll after
    poll can anchor on *that* instead of on genuine top-of-pane content
    that also carried over, wrongly claiming the latter scrolled off too
    (measured: with prev=[A,B,C,tick1,sep,prompt,sep,footer1] and
    new=[B,C,new,tick2,sep,prompt,sep,footer2], find_longest_match() picks
    the 3-line "sep,prompt,sep" block over the 2-line "B,C" one and
    misreports B and C as gone). The first matching block is instead
    exactly the earliest point of correspondence between the two frames --
    for a program that only ever scrolls its content upward (the case this
    exists for, per the user's own observation that only the bottom rows
    of a `claude` pane are ever live), that is always the right boundary,
    and duplicating a few still-visible lines into the backlog on the rare
    redraw that isn't a pure scroll is a harmless, not a correctness, cost.

    A pane that was cleared (`clear`, or any redraw sharing nothing with
    the previous frame) has no matching block at all -- falls back to
    "the whole previous frame scrolled off", since none of it survived
    into the new one either way."""
    if not prev_lines or new_lines == prev_lines:
        return []
    matcher = difflib.SequenceMatcher(None, prev_lines, new_lines, autojunk=False)
    for block in matcher.get_matching_blocks():
        if block.size > 0:
            return prev_lines[:block.a]
    return list(prev_lines)


def _watch_tmux_session(session_id):
    """Watches a real tmux pane -- both the "shell" preset (a pane this
    backend created) and an adopted "attach" session (one the user started
    by hand, see adopt_session) alike -- by polling `tmux capture-pane`
    rather than tailing a pipe-pane log. capture-pane returns tmux's own
    already-resolved plain-text rendering of the pane (no escape codes at
    all without `-e`), which is exactly what lets this work for a
    fullscreen, cursor-redrawing program (an interactively-run `claude`,
    say -- indistinguishable to tmux from any other program in the pane,
    whether launched by this backend's "shell" preset or typed by hand)
    without the garbled output raw pipe-pane byte tailing would produce for
    the same kind of program (see the PRESETS/TMUX_PRESETS module
    docstring). This used to be "attach"-preset-only (_watch_attached_
    session); unified onto "shell" too once a user hit exactly this
    garbling running `claude` interactively inside a shell-preset session.

    `committed_lines` holds rows already emitted as permanent agent_output
    bubbles; `pending_line` is the one row not yet committed (normally the
    pane's current last line -- a spinner, an in-progress response, the
    input box). The rule for promoting pending_line to committed is by
    *position*, not content: once capture-pane reports MORE rows than
    `len(committed_lines) + 1`, whatever is sitting at the old pending
    slot(s) has something newer printed after it and is therefore settled,
    regardless of whether its own text happened to change in the meantime.
    This is the fix for an earlier version of this function that compared
    old vs. new *tail content* directly: for the extremely common case of
    output growing exactly one line per poll, the newest line is always
    simultaneously "the only new line" and "the last line", so it could
    never be promoted -- each line just silently overwrote the previous
    line's live bubble instead of ever settling into the permanent log.
    Comparing row *counts* against the committed baseline instead fixes
    that regardless of polling cadence relative to output rate.

    This is a heuristic, not a proper terminal emulation: a program that
    clears and redraws a large chunk of already-scrolled-past screen (rather
    than simply printing more lines) would show up as a big one-time flush
    of "settled" text rather than being reconstructed frame-by-frame. That
    trade-off is deliberate -- see the aigw-gateway/nginx WebSocket-support
    gap documented in the deployment notes for why a real
    byte-accurate terminal (xterm.js) was decided against for this feature.
    """
    meta = load_meta(session_id)
    if meta is None:
        return
    tmux_name = meta.get("tmux_name", session_id)
    location = meta.get("tmux_location", "container")
    preset = meta.get("preset")
    sdir = session_dir(session_id)
    outbox = sdir / "outbox"
    seen_files = _already_announced_attachments(session_id)
    committed_lines = []
    pending_line = None
    prev_lines = []
    last_liveness_check = 0.0
    try:
        while True:
            time.sleep(TMUX_POLL_INTERVAL)

            _scan_outbox_for_attachments(session_id, outbox, seen_files)

            # -J joins lines the pane wrapped, so what comes back is what the
            # program printed rather than what happened to fit. Without it a
            # long line arrives pre-broken and there is no way to tell those
            # newlines from real ones -- which silently destroys the single
            # most important line of the login flow, the ~380-character OAuth
            # URL, since a link broken across bubbles is not tappable.
            # Widening the pane cannot fix this: `window-size latest` means a
            # tmux server the user is attached to sizes panes to *their*
            # terminal (measured: 120 columns on the host server, whatever
            # -x said). -J also keeps trailing spaces, hence the rstrip.
            #
            # Chained onto the same call (";" is tmux's own multi-command
            # separator, parsed by the tmux client itself -- there is no
            # shell in between to need "\;") rather than a second tmux_exec:
            # a `display-message` reading tmux's own #{pane_dead} directly,
            # the authoritative source, since relying solely on "Pane is
            # dead (status N)" text appearing in the capture turned out not
            # to be reliable -- measured 2026-08-29, a pane whose process
            # was killed rather than exiting normally left #{pane_dead}=1
            # with no such text anywhere in scrollback, so aigw kept
            # reporting the session "alive" forever. The one extra
            # display-message costs nothing extra client-side (same single
            # subprocess/docker-exec round trip either way).
            # A single slow poll (the container briefly under heavy load,
            # say) must not permanently kill this watcher -- nothing ever
            # restarts it within this process's lifetime otherwise (see
            # ensure_watcher's _watchers_started), so one transient timeout
            # used to mean this session's screen/dead-detection silently
            # stopped forever until the whole aigw-backend service was
            # restarted (measured 2026-08-29: a real container CPU spike
            # timed this out and the session looked frozen for hours).
            # Anything other than a timeout is still a genuine bug and
            # still fatal to this thread, via the existing outer handler.
            try:
                r = tmux_exec(location, [
                    "capture-pane", "-p", "-J", "-S", f"-{TMUX_CAPTURE_HISTORY_LINES}", "-t", tmux_name,
                    # "|" not " ": #{pane_dead_status} is the empty string
                    # (not "0") on a live pane, and a plain str.split() with
                    # no separator collapses that run of two spaces into one
                    # delimiter -- silently shifting #{pane_height} into
                    # dead_fields[1] instead of [2] (measured 2026-08-31,
                    # while adding pane_height: a live pane's screen was
                    # coming back at SCREEN_LINES/50 lines regardless of its
                    # real height). Same fix the deployment notes
                    # already made for the same class of bug with a literal
                    # tab (which tmux silently mangles into "_" instead --
                    # "|" has neither problem: not whitespace, not touched).
                    ";", "display-message", "-p", "-t", tmux_name,
                    "#{pane_dead}|#{pane_dead_status}|#{pane_height}",
                ])
            except subprocess.TimeoutExpired:
                log(f"tmux capture-pane for {session_id} timed out; skipping this poll")
                continue
            if r.returncode == 0:
                stdout = r.stdout[:-1] if r.stdout.endswith("\n") else r.stdout
                capture_text, _, dead_line = stdout.rpartition("\n")
                dead_fields = dead_line.split("|")
                pane_dead = bool(dead_fields) and dead_fields[0] == "1"
                pane_dead_status = int(dead_fields[1]) if len(dead_fields) > 1 and dead_fields[1].isdigit() else None
                # This session's *actual current* pane height, not the
                # global default -- sessions have been sized individually
                # since 2026-08-31 (create_session/resize_session, both take
                # a `rows` now), so a global SCREEN_LINES constant would be
                # wrong for any pane the client didn't happen to size the
                # same as PANE_ROWS. Read alongside pane_dead in the same
                # display-message call rather than a separate one, same
                # cost-avoidance reasoning as pane_dead's own comment above.
                pane_height = (int(dead_fields[2]) if len(dead_fields) > 2 and dead_fields[2].isdigit()
                               else SCREEN_LINES)

                new_lines = [l.rstrip() for l in clean_terminal_text(capture_text).split("\n")]
                while new_lines and new_lines[-1] == "":
                    new_lines.pop()  # tmux pads short panes to full height

                # A pane we created keeps existing after its program exits
                # (create_session's remain-on-exit), and tmux marks it as
                # such on the last line. Take that marker off before any of
                # the line bookkeeping below -- it is tmux's own annotation,
                # not pane output, and it is reported through session_ended's
                # exit_status instead of as a chat bubble.
                dead_status = None
                if new_lines:
                    m = PANE_DEAD_RE.match(new_lines[-1])
                    if m:
                        dead_status = int(m.group(1))
                        new_lines.pop()
                        while new_lines and new_lines[-1] == "":
                            new_lines.pop()
                # No marker text, but tmux itself says the pane is dead --
                # fall back to #{pane_dead_status} (0 if even that is blank,
                # i.e. genuinely unknown, since some exit status beats
                # reporting this session as still alive forever).
                if dead_status is None and pane_dead:
                    dead_status = pane_dead_status if pane_dead_status is not None else 0

                # Record whatever just permanently scrolled off the top of
                # this pane into _screen_backlog, before it is gone for
                # good (the deployment notes,
                # 2026-09-01). Independent of committed_lines/pending_line
                # below (which stop updating entirely while claude is in
                # the foreground -- this must not) and of prev_lines'
                # *other* use in the settle-confirmation check further
                # down; both read prev_lines, neither writes it, so sharing
                # it here is safe.
                if prev_lines and new_lines != prev_lines:
                    scrolled_off = _screen_lines_scrolled_off(prev_lines, new_lines)
                    if scrolled_off:
                        with _screen_backlog_lock:
                            backlog = _screen_backlog.setdefault(session_id, [])
                            backlog.extend(scrolled_off)
                            if len(backlog) > SCREEN_BACKLOG_MAX_LINES:
                                del backlog[:len(backlog) - SCREEN_BACKLOG_MAX_LINES]

                # The live screen, derived from this same capture rather than
                # a second `capture-pane` call -- one docker exec every 0.3s
                # is already the expensive part of this loop, and doubling it
                # to fetch the visible region separately buys nothing: the
                # tail of the scrollback *is* the visible region for anything
                # that redraws in place, which is the only case this view
                # exists for. Sliced to this poll's own pane_height, not a
                # fixed SCREEN_LINES (2026-08-31, the deployment notes).
                screen_text = "\n".join(new_lines[-pane_height:])
                with _latest_screen_lock:
                    changed = _latest_screen.get(session_id) != screen_text
                    if changed:
                        _latest_screen[session_id] = screen_text
                if changed:
                    push_ephemeral(session_id, {"type": "screen", "text": screen_text})

                if dead_status is not None:
                    # The program is gone, so nothing here can change again:
                    # everything still uncommitted -- crucially including the
                    # pending row, which is where a parting message such as
                    # "Login failed: ..." lands -- settles now, in one bubble.
                    # This replaces the settle heuristic for this poll rather
                    # than running after it, so the same text is not emitted
                    # twice.
                    final = "\n".join(l for l in new_lines[len(committed_lines):] if l.strip())
                    if final:
                        append_event(session_id, {"type": "agent_output", "text": final})
                    meta = load_meta(session_id)
                    if meta and not meta.get("stopped"):
                        meta["stopped"] = True
                        meta["alive"] = False
                        meta["ended_ts"] = time.time()
                        save_meta(session_id, meta)
                    append_event(session_id, {"type": "session_ended", "exit_status": dead_status})
                    # Only for panes we started: an adopted ("attach") pane
                    # belongs to the user, and if *they* turned remain-on-exit
                    # on, they meant to keep it around to look at.
                    if meta and meta.get("preset") != "attach":
                        tmux_exec(location, ["kill-session", "-t", tmux_name])
                    if meta and meta.get("preset", "").startswith("claude-login"):
                        # A login pane is single-purpose and single-use
                        # (the deployment notes -- a fresh code always
                        # needs a fresh pane anyway), so once it exits there is
                        # nothing left to look at or resume. Removing it here
                        # rather than leaving a permanent "Claude ログイン"
                        # entry in the session list for every login ever
                        # performed is what the user asked for (2026-08-15).
                        # Safe to do from inside this session's own watcher
                        # thread: delete_session()'s stop_session() call is a
                        # no-op (meta.stopped is already True above), and the
                        # "Login failed: ..."/success line just went out as
                        # this same poll's agent_output event, so a client
                        # watching this session's SSE stream still sees it
                        # before the record disappears out from under them.
                        delete_session(session_id)
                    return

                # "claude-tui" has its own, far more reliable source for chat
                # bubbles -- _tail_claude_transcript reads Claude Code's own
                # on-disk conversation log instead of guessing from rendered
                # pixels (see that function's docstring for why this
                # row-count heuristic could never really work for it: the
                # pane redraws a fixed-height viewport rather than growing,
                # so content routinely never reaches the "settled" state
                # below). Skipping this block leaves committed_lines/
                # pending_line untouched, which only matters to the
                # dead-pane fallback above -- an acceptable one-time full-
                # screen dump on an abnormal exit, not a live chat feed.
                #
                # The same is true, only temporarily, whenever _watch_shell_
                # claude has noticed the user running `claude` interactively
                # inside a "shell"/"host-shell"/"root-shell"/"attach" pane by
                # hand -- suspended for exactly that stretch, resumed the
                # poll after it exits (the row-count reset that follows is
                # the same "pane shrank" recovery already used for a bare
                # `clear`, not special-cased here).
                if preset != "claude-tui" and not _claude_foreground.get(session_id):
                    baseline_len = len(committed_lines) + (1 if pending_line is not None else 0)

                    if not new_lines:
                        committed_lines, pending_line = [], None
                    elif len(new_lines) > baseline_len:
                        # At least one row has newer content after it -- settle
                        # everything from the old baseline up to (excluding) the
                        # new last row, but only once a second capture has agreed
                        # on those rows. A capture taken while the program is
                        # mid-write can show a row tmux has not yet flagged as
                        # wrapped, i.e. the first half of a longer line, and
                        # committing that puts a permanently broken fragment in
                        # the log -- measured as a wrapped OAuth URL arriving in
                        # pieces on roughly one pane start in eight. Deferring
                        # costs one poll (0.3s), and the dead-pane branch above
                        # flushes whatever is still uncommitted either way.
                        settle_to = len(new_lines) - 1
                        confirmed = all(i < len(prev_lines) and prev_lines[i] == new_lines[i]
                                        for i in range(len(committed_lines), settle_to))
                        if confirmed:
                            newly_settled = new_lines[len(committed_lines):settle_to]
                            settled_text = "\n".join(l for l in newly_settled if l.strip())
                            if settled_text:
                                append_event(session_id, {"type": "agent_output", "text": settled_text})
                            committed_lines = new_lines[:settle_to]
                        new_pending = new_lines[-1]
                        if new_pending.strip() and new_pending != pending_line:
                            append_event(session_id, {"type": "live_tail", "text": new_pending})
                        pending_line = new_pending
                    elif len(new_lines) == baseline_len and new_lines and new_lines[-1] != pending_line:
                        # Same row count as last poll -- only the pending row's
                        # own content changed in place (e.g. a growing streamed
                        # line, or a spinner).
                        pending_line = new_lines[-1]
                        if pending_line.strip():
                            append_event(session_id, {"type": "live_tail", "text": pending_line})
                    elif len(new_lines) < baseline_len:
                        # Pane shrank (e.g. the program cleared the screen) --
                        # no reliable baseline anymore; restart the heuristic
                        # fresh from this capture rather than guessing.
                        committed_lines = new_lines[:-1]
                        pending_line = new_lines[-1]
                        if pending_line.strip():
                            append_event(session_id, {"type": "live_tail", "text": pending_line})
                    # else: identical row count and unchanged pending content --
                    # genuinely idle, nothing to do.

                prev_lines = new_lines

            now = time.time()
            if now - last_liveness_check > 5:
                last_liveness_check = now
                meta = load_meta(session_id)
                if meta is None or meta.get("stopped"):
                    # Stopped from somewhere else (the stop button, or the
                    # dead-pane branch above on a previous backend run).
                    # Nothing can change again -- and list_sessions calls
                    # ensure_watcher for *every* session directory, so
                    # staying in the loop would cost one `sandbox exec` every
                    # 0.3s per long-dead session for the life of the process.
                    return
                live_names = live_tmux_names(location)
                # live_tmux_names("root") returns None, not an empty set,
                # while this user's window is locked (2026-08-31, "sever
                # access, don't kill the server" -- see list_root_tmux_
                # sessions's own docstring): the pane is very likely still
                # there, this thread just cannot currently ask. Treating
                # None like "confirmed absent" here would permanently mark
                # every root-shell session `stopped` the first liveness
                # check after any lock/expiry, which is exactly the bug this
                # distinction exists to avoid -- skip the check this tick
                # instead and let a later, unlocked poll decide for real.
                if live_names is not None and tmux_name not in live_names:
                    # The pane is gone outright rather than dead-but-kept:
                    # killed from elsewhere, or an adopted pane, which we
                    # never set remain-on-exit on. Its last screen went with
                    # it; only the branch above can preserve one.
                    meta["stopped"] = True
                    meta["alive"] = False
                    meta["ended_ts"] = time.time()
                    save_meta(session_id, meta)
                    append_event(session_id, {"type": "session_ended"})
                    return
    except Exception as e:  # watcher must never crash the process
        log(f"attach watcher for {session_id} exiting on error: {e}")


CLAUDE_TRANSCRIPT_POLL_INTERVAL = 0.5


def _split_assistant_text_events(buf):
    """Splits `buf` (raw bytes accumulated from a Claude Code conversation
    JSONL file) into complete lines and returns (remaining_buf, texts) --
    `texts` is the list of assistant "text" content-block strings found in
    those complete lines, in order, each one destined to become its own
    agent_output event. Shared by _tail_claude_transcript ("claude-tui")
    and _watch_shell_claude (`claude` launched by hand in shell/host-shell/
    root-shell/attach) -- extracted 2026-09-01 after a codebase health
    pass found this exact parsing block duplicated between them, in
    precisely the area of the codebase with the heaviest bug history
    (the deployment notes, CHANGELOG's
    aigw-shell-claude-watcher-permission-retry, and this same day's
    the deployment notes) -- two copies meant a fix to one
    could miss the other.

    A malformed line (bad JSON) is skipped, not fatal: this reads Claude
    Code's own completed-message log, not a redrawing terminal, so a bad
    line should not happen, but must never crash the caller's watcher loop
    over one."""
    *complete, buf = buf.split(b"\n")
    texts = []
    for raw in complete:
        if not raw.strip():
            continue
        try:
            obj = json.loads(raw)
        except ValueError:
            continue
        if obj.get("type") != "assistant":
            continue
        content = (obj.get("message") or {}).get("content")
        if not isinstance(content, list):
            continue
        for block in content:
            if isinstance(block, dict) and block.get("type") == "text":
                text = block.get("text", "")
                if text.strip():
                    texts.append(text)
    return buf, texts


def _tail_claude_transcript(session_id):
    """Feeds the chat log for a "claude-tui" session from Claude Code's own
    on-disk conversation log (~/.claude/projects/<cwd-key>/<id>.jsonl --
    the same file list_claude_conversations reads for the "resume" picker),
    instead of trying to reconstruct it from the rendered pane.

    That log is the actual data Claude Code itself considers the
    conversation, not a rendering of it: each line is one complete JSON
    message, assistant reply text arrives as its own "text" content block,
    and there is no spinner/status-line/menu chrome to filter out, because
    that chrome was never written to this file to begin with -- only
    _watch_tmux_session's capture-pane view has that problem, which is also
    why its row-count "settle" heuristic could never really work for
    "claude-tui": that pane redraws a fixed-height viewport rather than
    growing line by line, so content routinely never reaches "settled"
    (see the guard for "claude-tui" in _watch_tmux_session).

    Deliberately only surfaces assistant *text* blocks, not tool_use/
    tool_result -- matching the granularity the row-count heuristic used to
    aim for. The user's own messages are not read from here either:
    send_message() already records those synchronously when sent, and this
    file would only repeat them a moment later.
    """
    meta = load_meta(session_id)
    if meta is None:
        return
    proj_dir = claude_project_dir(meta.get("cwd"))
    claude_session_id = meta.get("claude_session_id")
    # A pre-assigned id (create_session's assigned_claude_session_id,
    # the deployment notes) leaves claude_session_id
    # already set for a conversation that is otherwise exactly as "brand
    # new" as the fully-unknown-id case below -- resumed_from is what
    # actually tells a genuine --resume (file guaranteed to already exist,
    # prior content that must NOT be replayed into the chat) apart from
    # that (2026-09-14, the deployment notes: treating
    # the two the same here used to make a brand-new session's tailer
    # thread call target_path.stat() before Claude Code's own process had
    # gotten around to creating the file at all, catch the resulting
    # OSError, and exit silently and permanently -- no error logged, no
    # retry, the session's replies simply never reached the chat log again
    # for its entire life. Usually masked by _accept_workspace_trust_if_
    # shown's polling delay between spawning the pane and ensure_watcher()
    # starting this thread; the race surfaced on a session in an
    # already-trusted directory, where that delay was ~0).
    is_resume = bool(claude_session_id) and bool(meta.get("resumed_from"))

    if is_resume:
        # Resumed conversation: the log already exists (resolve_resume_id
        # checked that at creation time). Start from its current end so
        # today's session picks up only what's said from here on, the same
        # way a backend restart reattaching to an already-discovered
        # "claude-tui" log does not replay everything back into the chat.
        # Claimed too (see _claim_transcript), not just newly-discovered
        # files: a resumed conversation is exactly as much "this session's
        # own" as a freshly-discovered one, and must be just as unavailable
        # for some other session's discovery loop to mistakenly pick up.
        _claim_transcript(proj_dir, f"{claude_session_id}.jsonl", session_id)
        target_path = proj_dir / f"{claude_session_id}.jsonl"
        try:
            offset = target_path.stat().st_size
        except OSError:
            return
    else:
        # Brand-new conversation: Claude Code has not created its log file
        # yet (it may not even have started). Wait for one that was not
        # already there when this session's pane was created -- no
        # deadline: a user can take longer than any fixed timeout to type
        # their first message (more so right after the deployment notes'
        # trust-dialog fix added its own few-second delay before the pane is
        # even ready), and giving up here means this session never gets chat-
        # log bubbles for the rest of its life. This loop's own cost while
        # waiting is one directory listing (or, with a pre-assigned id, one
        # stat) per poll, no costlier than _watch_tmux_session's own
        # indefinite capture-pane polling for the same session, and it exits
        # the same way that one does: the session getting stopped.
        #
        # claude_session_id may already be known here (pre-assigned, see
        # above) -- the target filename is then already fixed, and this
        # only has to wait for Claude Code to create it, not discover which
        # of possibly several new files is this session's own. Only a
        # session with no pre-assigned id (an ssh:<machine> "claude-tui",
        # the deployment notes, or a session from before this feature
        # existed) falls back to scanning the directory for whichever new
        # .jsonl appears.
        if claude_session_id is None:
            try:
                known = {p.name for p in proj_dir.iterdir() if p.suffix == ".jsonl"}
            except OSError:
                known = set()
        target_path = None
        while target_path is None:
            meta = load_meta(session_id)
            if meta is None or meta.get("stopped"):
                return
            if claude_session_id is not None:
                candidate = proj_dir / f"{claude_session_id}.jsonl"
                if candidate.exists() and _claim_transcript(proj_dir, candidate.name, session_id):
                    target_path = candidate
                    break
            else:
                try:
                    fresh = [p for p in proj_dir.iterdir()
                             if p.suffix == ".jsonl" and p.name not in known]
                except OSError:
                    fresh = []
                if fresh:
                    # Highest mtime first, but a candidate is only actually
                    # ours once _claim_transcript says so -- two sessions
                    # racing on the same newly-appeared file must not both
                    # win (see _claimed_transcripts' own comment). A
                    # candidate that loses the claim is added to `known` so
                    # it is never reconsidered; the loop then either takes a
                    # lower-mtime candidate from this same poll or waits for
                    # the next one.
                    fresh.sort(key=lambda p: p.stat().st_mtime, reverse=True)
                    for candidate in fresh:
                        if _claim_transcript(proj_dir, candidate.name, session_id):
                            target_path = candidate
                            break
                        known.add(candidate.name)
                    if target_path is not None:
                        break
            time.sleep(CLAUDE_TRANSCRIPT_POLL_INTERVAL)
        if claude_session_id is None:
            claude_session_id = target_path.stem
            meta = load_meta(session_id)
            if meta is not None:
                meta["claude_session_id"] = claude_session_id
                save_meta(session_id, meta)
        # Current size at the moment of discovery, not a hardcoded 0: for a
        # conversation that is *actually* brand new this is ~0 anyway (we
        # only just finished waiting for the file to appear at all), but for
        # a pre-assigned id whose file already existed and had real content
        # by the time this thread got around to looking (a backend restart
        # reattaching mid-conversation, not a fresh session start) this is
        # what keeps that content from being replayed into the chat log a
        # second time -- same reasoning as the is_resume branch above, just
        # reached from "the file didn't exist a moment ago" instead of
        # "resolve_resume_id already confirmed it exists".
        try:
            offset = target_path.stat().st_size
        except OSError:
            offset = 0

    buf = b""
    last_liveness_check = 0.0
    try:
        while True:
            time.sleep(CLAUDE_TRANSCRIPT_POLL_INTERVAL)

            try:
                size = target_path.stat().st_size
            except OSError:
                size = offset

            if size > offset:
                with target_path.open("rb") as f:
                    f.seek(offset)
                    chunk = f.read(size - offset)
                offset = size
                buf += chunk
                buf, texts = _split_assistant_text_events(buf)
                for text in texts:
                    append_event(session_id, {"type": "agent_output", "text": text})

            now = time.time()
            if now - last_liveness_check > 5:
                last_liveness_check = now
                meta = load_meta(session_id)
                if meta is None or meta.get("stopped"):
                    return
    except Exception as e:  # watcher must never crash the process
        log(f"transcript tailer for {session_id} exiting on error: {e}")


# 2026-09-10 (the deployment notes): how stale an
# existing jsonl's mtime may be for _watch_shell_claude to still treat it as
# "the conversation aigw-backend merely lost track of across a restart"
# rather than "an unrelated earlier conversation in the same cwd". Widened
# from the original 20.0 on 2026-09-14 (the deployment notes
# restart-during-turn): a restart *gap* is seconds, but the on-disk file's
# own last write can be much older than that even while the conversation is
# very much still going -- a long agentic turn (several tool calls, a slow
# command) routinely goes well past 20s between writes, and a restart that
# happens to land in one such gap made this exact root-shell session's own
# chat log stop updating, permanently, for the rest of its life (observed
# live: this session, mid-turn, right after an unrelated aigw-backend
# restart for a different fix). Still short enough that an unrelated,
# genuinely-finished conversation in the same cwd needs to have been touched
# within the last 3 minutes to be mistaken for this one -- narrower than
# "restart gap", the risk this constant exists to bound in the first place.
RESUME_STALE_THRESHOLD_SECONDS = 180.0

CLAUDE_FOREGROUND_POLL_INTERVAL = 2.0


def _is_claude_foreground(command):
    """Whether tmux's own `pane_current_command` names Claude Code's CLI.

    On this host (location "container"/"host"/"root") that's always the
    bare name "claude" -- tmux reports argv[0]'s own basename for a Linux
    process. On an ssh:<machine> pane (winbox-a/winbox-b, both MSYS2 under
    Windows) tmux instead reports the *full path* of the real .exe --
    measured 2026-08-15: "C:\\Users\\alice\\.local\\bin\\claude.exe", i.e.
    exactly SSH_MACHINES[machine]["claude"] with backslashes -- so `command
    != "claude"` (the check this replaced) silently never matched on either
    ssh: machine at all: _claude_foreground never got set, and the real-
    transcript tailing below never ran, for every claude-tui-<machine> and
    every by-hand `claude` inside shell-<machine>/attach on those two
    machines. Matching on the final path component instead, case-
    insensitively (Windows filenames are case-insensitive) and with an
    optional ".exe", covers both shapes with one check."""
    base = command.rsplit("\\", 1)[-1].rsplit("/", 1)[-1]
    return base.lower() in ("claude", "claude.exe")


def _watch_shell_claude(session_id):
    """Companion to _watch_tmux_session for "shell"/"host-shell"/
    "root-shell"/"attach" (every location), and additionally for every
    "claude-tui-<machine>" ssh: preset (create_session's own dispatch above
    routes those here too, not to ensure_transcript_tailer/_tail_claude_
    transcript like local "claude-tui" -- those two ssh: presets have no
    ~/sandhome, so their cwd is never known ahead of time the way "claude-
    tui"'s meta["cwd"] is; see the "Always None for ssh:<machine>" comment
    in create_session). Those cases have no fixed cwd and no guarantee
    `claude` is even running at all, unlike "claude-tui" where both are
    known at session-creation time (see _tail_claude_transcript). Someone
    running `claude` interactively inside one of these panes by hand hits
    the exact same row-count-heuristic failure "claude-tui" did (see the
    "claude-tui" guard in _watch_tmux_session) -- this just detects that
    case at runtime instead of assuming it from the preset.

    Detection is tmux's own `pane_current_command`/`pane_current_path`, not
    a heuristic: they are the kernel's actual foreground-process name and
    cwd for the pane, updated by tmux itself independently of anything this
    process guesses from rendered text. While `pane_current_command` names
    Claude Code (see _is_claude_foreground), this thread tails that
    directory's on-disk conversation log (the newest one that appeared
    after detection, the same discovery approach _tail_claude_transcript
    uses for a brand-new "claude-tui" conversation) and sets
    _claude_foreground[session_id] so _watch_tmux_session suspends its own
    bubbling for exactly that stretch. When `claude` exits, the flag clears
    and capture-pane bubbling resumes on its own -- no special reset
    needed, since the row-count heuristic already recovers from any sudden
    screen-content jump via its "pane shrank" branch.

    For ssh:<machine>, that directory is on the *machine's own*
    filesystem, not this host's, so every Path.iterdir()/.stat()/.open()
    call below has an ssh: counterpart instead (_remote_claude_project_dir_
    key/_ssh_list_jsonl/_ssh_read_new) -- one extra ssh round trip per poll
    either way, same cost this loop already pays for the display-message
    call above it.

    meta.claude_session_id is normally absent for these presets (unlike
    "claude-tui"/"claude", there is no notion of resuming a *specific* past
    conversation picked from a list) -- EXCEPT when create_session pre-
    assigned a fresh one for a brand-new conversation (local "shell"/
    "host-shell"/"root-shell" and, since the deployment notes
    resumable-retry, ssh: SSH_SHELL_PRESETS too): in that case there is
    nothing to discover at all, see preassigned_id below. Absent it,
    nothing here needs to survive a backend restart -- it just starts
    noticing again from whatever is running once ensure_watcher re-fires
    for the session.
    """
    meta = load_meta(session_id)
    if meta is None:
        return
    tmux_name = meta.get("tmux_name", session_id)
    location = meta.get("tmux_location", "container")
    is_ssh = location.startswith("ssh:")
    machine = location.split(":", 1)[1] if is_ssh else None
    # See this function's own docstring and create_session's comment on
    # assigned_claude_session_id -- ssh: SSH_SHELL_PRESETS get one same as
    # the local interactive shells now; "attach" and CLAUDE_TUI_PRESETS
    # (which this function never runs for, see ensure_watcher) still don't.
    preassigned_id = meta.get("claude_session_id")

    active = False
    target_path = None  # local Path -- only used when not is_ssh
    target_name = None  # remote filename -- only used when is_ssh
    remote_key = None   # cached [A-Za-z0-9-] project-dir key -- only when is_ssh
    known = set()
    offset = 0
    buf = b""

    try:
        while True:
            time.sleep(CLAUDE_FOREGROUND_POLL_INTERVAL)

            meta = load_meta(session_id)
            if meta is None or meta.get("stopped"):
                with _claude_foreground_lock:
                    _claude_foreground.pop(session_id, None)
                return

            # "|" rather than an actual tab: tmux's format-string renderer
            # silently substitutes literal tab bytes embedded in a -p format
            # with "_" (measured), which would make this unsplittable and
            # fail the same way every poll -- "|" survives untouched and
            # cannot appear in either field (a command name or a path).
            # Same reasoning as _watch_tmux_session's identical guard: a
            # transient timeout must not permanently end this watcher (no
            # supervisor ever restarts it within this process's lifetime).
            try:
                r = tmux_exec(location, ["display-message", "-p", "-t", tmux_name,
                                          "#{pane_current_command}|#{pane_current_path}"])
            except subprocess.TimeoutExpired:
                log(f"tmux display-message for {session_id} timed out; skipping this poll")
                continue
            if r.returncode != 0:
                continue
            try:
                command, cwd = r.stdout.rstrip("\n").split("|", 1)
            except ValueError:
                continue

            if not _is_claude_foreground(command):
                if active:
                    active = False
                    with _claude_foreground_lock:
                        _claude_foreground.pop(session_id, None)
                continue

            if not active:
                active = True
                with _claude_foreground_lock:
                    _claude_foreground[session_id] = True
                # 2026-09-01 (the deployment notes): a
                # target already found during an earlier "active" streak
                # within *this same thread's lifetime* (target_path/
                # target_name, offset and buf are all function-scoped, so
                # they survive an active->False->True flap untouched unless
                # explicitly reset below) is still exactly the right file
                # to keep reading from -- do nothing and just fall through
                # to the normal read below. Skipping this is what used to
                # unconditionally wipe them and re-arm "wait for a *fresh*
                # file" every single time, below -- fine the first time
                # this thread ever sees `claude` in the foreground, actively
                # wrong on every re-detection after a merely *transient*
                # blip (some other process briefly visible as
                # #{pane_current_command} for one CLAUDE_FOREGROUND_POLL_
                # INTERVAL poll, not claude actually exiting): the
                # conversation never stopped, so no new file was ever going
                # to appear, and the chat log froze permanently until the
                # pane was closed and reopened -- measured 2026-09-01 on a
                # live session.
                have_target = (target_name is not None) if is_ssh else (target_path is not None)
                if not have_target and preassigned_id:
                    # create_session already minted this id just for this
                    # session before `claude` ever ran (the deployment notes
                    # claude-tail-cross-session-claim, extended to ssh:
                    # SSH_SHELL_PRESETS by the deployment notes
                    # resumable-retry) -- nothing to guess, no candidate to
                    # weigh against another session's. The file may not
                    # exist yet if `claude` only just started; size <=
                    # offset (0) below simply retries next poll until it
                    # does, same as any other not-yet-written target.
                    if is_ssh:
                        remote_key = _remote_claude_project_dir_key(machine, cwd)
                        if remote_key is not None:
                            target_name = f"{preassigned_id}.jsonl"
                            _claim_transcript(f"ssh:{machine}:{remote_key}", target_name, session_id)
                            offset = 0
                            buf = b""
                            have_target = True
                        # else: machine unreachable this exact poll -- leave
                        # have_target False. Falls through to the discovery
                        # block below for this one poll rather than retrying
                        # here, but that block converges on the same file
                        # anyway once it actually appears (nothing else can
                        # be "fresh" in a cwd this session just started using).
                    else:
                        proj_dir = claude_project_dir(cwd, home=_claude_home_for_location(location))
                        target_path = proj_dir / f"{preassigned_id}.jsonl"
                        _claim_transcript(str(proj_dir), target_path.name, session_id)
                        offset = 0
                        buf = b""
                        have_target = True
                if not have_target:
                    remote_key = _remote_claude_project_dir_key(machine, cwd) if is_ssh else None
                    if is_ssh:
                        candidates = _ssh_list_jsonl(machine, remote_key) if remote_key else []
                    else:
                        proj_dir = claude_project_dir(cwd, home=_claude_home_for_location(location))
                        try:
                            candidates = [(p, p.stat().st_mtime) for p in proj_dir.iterdir()
                                          if p.suffix == ".jsonl"]
                        except OSError:
                            candidates = []
                    # (proj_dir, filename) for local, ("ssh:<machine>:<key>", filename)
                    # for remote -- a namespace distinct enough that the two
                    # never collide, see _claimed_transcripts' own comment.
                    registry_ns = f"ssh:{machine}:{remote_key}" if is_ssh else str(
                        claude_project_dir(cwd, home=_claude_home_for_location(location)))
                    claimed_target = None
                    # 2026-09-10 (the deployment notes):
                    # only a *recently*-modified candidate is eligible for
                    # the "resume" heuristic below -- see
                    # RESUME_STALE_THRESHOLD_SECONDS. Without this, launching
                    # `claude` fresh in a cwd that still has an older,
                    # unrelated conversation on disk raced this scan against
                    # that new conversation's own not-yet-created jsonl: the
                    # scan above runs within one CLAUDE_FOREGROUND_POLL_
                    # INTERVAL of `claude` appearing in the foreground, well
                    # before Claude Code has written its first line, so the
                    # only candidate on disk was that stale file -- claimed
                    # as if resuming it, and then never revisited (this
                    # thread never re-scans once it has a target), so the
                    # brand-new conversation's real output was never tailed
                    # for the rest of the pane's life. Measured live on a
                    # "root-shell" session: chat log silently stopped
                    # updating right after `claude`'s startup banner.
                    now = time.time()
                    resumable = [c for c in candidates
                                 if now - c[1] <= RESUME_STALE_THRESHOLD_SECONDS]
                    if resumable:
                        # This thread has never found a target before *and*
                        # a conversation log was modified moments ago in
                        # this cwd -- overwhelmingly more likely to be the
                        # live conversation `claude` (confirmed in the
                        # foreground right now) has simply been continuing
                        # all along than an unrelated already-finished one,
                        # since aigw-backend itself was very probably what
                        # lost track (a restart -- claude_session_id is not
                        # persisted for this preset, see this function's own
                        # docstring, so a fresh thread here has no memory of
                        # which file it was on) rather than claude actually
                        # having just relaunched from nothing. Resume from
                        # the most-recently-modified one's *current* end
                        # (not its start, unlike a genuinely brand-new
                        # conversation) -- a message written in the narrow
                        # gap between aigw-backend stopping and this thread
                        # starting is the one realistic way to still miss a
                        # few lines here, an acceptable cost next to "frozen
                        # forever". Only the single *freshest* candidate is
                        # even attempted -- unlike the "brand-new file
                        # appeared" loop further down, where trying several
                        # candidates in claim order is fine (any of them could
                        # legitimately be the new conversation), exactly one
                        # file can be telling the truth about "this pane's
                        # conversation, continuing". Falling through to the
                        # second-freshest on a failed claim used to guess an
                        # arbitrary OTHER file belongs to this pane whenever
                        # two sessions shared a cwd and both had recently
                        # written -- itself a still-live session's own
                        # conversation, silently misdirecting this thread onto
                        # it forever (2026-09-11 incident: two root-shell
                        # sessions both driving `claude` in the same cwd,
                        # confirmed live via py-spy -- one thread's freshest
                        # candidate lost the race, fell back to the next
                        # candidate, and froze there for hours). If the
                        # freshest is already claimed (see
                        # _claimed_transcripts), that means some OTHER live
                        # session is that file's rightful owner -- there is
                        # nothing else here worth guessing at, so fall through
                        # to "wait for something new" below exactly like the
                        # brand-new-conversation case (2026-09-10 incident,
                        # `_tail_claude_transcript`'s own comment has that
                        # report).
                        newest, _ = max(resumable, key=lambda c: c[1])
                        name = newest if is_ssh else newest.name
                        if _claim_transcript(registry_ns, name, session_id):
                            claimed_target = newest
                    if claimed_target is not None:
                        target = claimed_target
                        if is_ssh:
                            target_name = target
                            _, offset = _ssh_read_new(machine, remote_key, target_name, 0)
                            offset = offset or 0
                        else:
                            target_path = target
                            try:
                                offset = target_path.stat().st_size
                            except OSError:
                                offset = 0
                        buf = b""
                    else:
                        # Either nothing exists yet in this cwd (brand-new
                        # conversation, no file of its own yet), or every
                        # existing candidate already belongs to some other
                        # session (see _claim_transcript above) -- either
                        # way, nothing here is safe to resume from. Snapshot
                        # what's here (candidates already covers this) so
                        # the discovery step further down only reacts to a
                        # file that appears *after* this and is not already
                        # somebody else's, exactly like _tail_claude_
                        # transcript's own brand-new-conversation branch.
                        known = {(c[0] if is_ssh else c[0].name) for c in candidates}
                        target_path = None
                        target_name = None
                        offset = 0
                        buf = b""

            if is_ssh:
                if remote_key is None:
                    remote_key = _remote_claude_project_dir_key(machine, cwd)
                    if remote_key is None:
                        continue  # machine unreachable this poll -- try again next time
                if target_name is None:
                    # `known` normally means "already rejected, don't
                    # reconsider" -- but a name can land there simply
                    # because it was too stale *at the one moment* the
                    # startup resumable-check above ran (RESUME_STALE_
                    # THRESHOLD_SECONDS is relative to `now`, which keeps
                    # moving), not because it is actually someone else's
                    # file. Re-admitting it here whenever it is freshly
                    # modified again fixes a permanent-hang case measured
                    # live 2026-09-16 (the deployment notes
                    # resumable-retry): this thread's own still-live
                    # conversation had gone an already-known-possible >180s
                    # without a write at the exact instant of an unrelated
                    # aigw-backend restart, got rejected once by that
                    # startup check, and then could never be discovered
                    # again for the rest of the pane's life (a name already
                    # in `known` never re-qualifies as "fresh" -- it is not
                    # a new file). A name only ever reaches `known` via
                    # this same file's own rejection paths (never removed),
                    # and a failed _claim_transcript below is idempotent to
                    # retry, so this costs nothing when the name really is
                    # someone else's.
                    now = time.time()
                    fresh = [(name, mtime) for name, mtime in _ssh_list_jsonl(machine, remote_key)
                             if name not in known or now - mtime <= RESUME_STALE_THRESHOLD_SECONDS]
                    if not fresh:
                        continue  # not written yet -- try again next poll
                    fresh.sort(key=lambda e: e[1], reverse=True)
                    ns = f"ssh:{machine}:{remote_key}"
                    for name, _ in fresh:
                        if _claim_transcript(ns, name, session_id):
                            target_name = name
                            break
                        known.add(name)
                    if target_name is None:
                        continue  # every fresh candidate already belongs to another session
                chunk, size = _ssh_read_new(machine, remote_key, target_name, offset)
                if size is None or size <= offset:
                    continue
                offset = size
                buf += chunk
            else:
                if target_path is None:
                    # See the matching is_ssh branch above
                    # (the deployment notes): `known`
                    # must not permanently exclude a name that is merely
                    # stale *right now* rather than genuinely someone
                    # else's -- same fix, local-filesystem shape.
                    now = time.time()
                    proj_dir = claude_project_dir(cwd, home=_claude_home_for_location(location))
                    try:
                        fresh = [p for p in proj_dir.iterdir()
                                 if p.suffix == ".jsonl" and
                                 (p.name not in known or now - p.stat().st_mtime <= RESUME_STALE_THRESHOLD_SECONDS)]
                    except OSError:
                        fresh = []
                    if not fresh:
                        continue  # not written yet -- try again next poll
                    fresh.sort(key=lambda p: p.stat().st_mtime, reverse=True)
                    for candidate in fresh:
                        if _claim_transcript(str(proj_dir), candidate.name, session_id):
                            target_path = candidate
                            break
                        known.add(candidate.name)
                    if target_path is None:
                        continue  # every fresh candidate already belongs to another session

                try:
                    size = target_path.stat().st_size
                except OSError:
                    continue
                if size <= offset:
                    continue
                # PermissionError here (not just at the stat() above) is
                # expected and transient: a brand-new jsonl created under a
                # directory with a default ACL for this user gets its ACL
                # mask intersected with the *creation mode*'s group bits
                # (posix_acl_create semantics, see the deployment notes
                # transcript-acl), which is 0 for the 0600 Claude Code
                # creates these with -- so the named ACL entry aigw-root-
                # tmux-grant set up is silently inert until some later event
                # (e.g. the next grant run, which re-applies the mask via an
                # explicit setfacl -m instead of the creation-time
                # intersection) fixes it. Must not exit the watcher over
                # this like the outer except does -- just retry next poll.
                try:
                    with target_path.open("rb") as f:
                        f.seek(offset)
                        chunk = f.read(size - offset)
                except OSError:
                    continue
                offset = size
                buf += chunk

            buf, texts = _split_assistant_text_events(buf)
            for text in texts:
                append_event(session_id, {"type": "agent_output", "text": text})
    except Exception as e:  # watcher must never crash the process
        log(f"shell-claude watcher for {session_id} exiting on error: {e}")
        with _claude_foreground_lock:
            _claude_foreground.pop(session_id, None)


def _resolve_claude_conversation(session_id):
    """Which Claude Code conversation (project dir + conversation id,
    local or on an ssh:<machine>) an aigw session is currently driving, for
    the subagent-log endpoints below. Returns None if there is nothing to
    show yet (no conversation started, claude not in the foreground, or the
    pane/session is gone), or one of:
        {"remote": False, "proj_dir": Path, "claude_session_id": str}
        {"remote": True, "machine": str, "key": str, "claude_session_id": str}

    "claude"/"claude-tui" record claude_session_id in meta.json once and
    for all (_run_claude_headless_turn / _tail_claude_transcript) -- read
    straight from there. Every CLAUDE_TUI_PRESETS member and
    "shell"/"host-shell"/"root-shell"/SSH_SHELL_PRESETS do too, but only
    when create_session pre-assigned one for a brand-new conversation
    (the deployment notes, extended to ssh: by
    the deployment notes; not "attach", see
    create_session's own comment) -- same known-id fast path, once claude is
    confirmed actually running there. Everything else ("attach", or any of
    the above from before create_session started assigning ids) persists
    nothing usable here, so this asks the pane live, the same way
    _watch_shell_claude's own foreground-detection loop does, and picks the
    most recently modified project log as "the" current conversation --
    ambiguous if another session shares the same cwd, same caveat as that
    function's own pre-fix history."""
    meta = load_meta(session_id)
    if meta is None:
        return None
    preset = meta.get("preset", "")

    if preset in ("claude", "claude-tui"):
        claude_session_id = meta.get("claude_session_id")
        if not claude_session_id:
            return None
        return {"remote": False, "proj_dir": claude_project_dir(meta.get("cwd")),
                "claude_session_id": claude_session_id}

    location = meta.get("tmux_location", "container")
    tmux_name = meta.get("tmux_name", session_id)
    r = tmux_exec(location, ["display-message", "-p", "-t", tmux_name,
                              "#{pane_current_command}|#{pane_current_path}"])
    if r.returncode != 0:
        return None
    try:
        command, cwd = r.stdout.rstrip("\n").split("|", 1)
    except ValueError:
        return None
    if not _is_claude_foreground(command):
        return None

    # See create_session's assigned_claude_session_id comment: ssh:
    # SSH_SHELL_PRESETS and CLAUDE_TUI_PRESETS can both carry a preassigned
    # id now (the deployment notes), so unlike
    # before this is no longer unconditionally None for every ssh: location.
    is_ssh = location.startswith("ssh:")
    machine = location.split(":", 1)[1] if is_ssh else None
    key = _remote_claude_project_dir_key(machine, cwd) if is_ssh else None
    if is_ssh and key is None:
        return None  # machine unreachable this call

    preassigned_id = meta.get("claude_session_id")
    if preassigned_id:
        if is_ssh:
            return {"remote": True, "machine": machine, "key": key, "claude_session_id": preassigned_id}
        return {"remote": False, "proj_dir": claude_project_dir(cwd, home=_claude_home_for_location(location)),
                "claude_session_id": preassigned_id}

    if is_ssh:
        files = _ssh_list_jsonl(machine, key)
        if not files:
            return None
        files.sort(key=lambda e: e[1], reverse=True)
        return {"remote": True, "machine": machine, "key": key,
                "claude_session_id": files[0][0][:-len(".jsonl")]}

    proj_dir = claude_project_dir(cwd, home=_claude_home_for_location(location))
    try:
        files = [(p.stem, p.stat().st_mtime) for p in proj_dir.iterdir() if p.suffix == ".jsonl"]
    except OSError:
        return None
    if not files:
        return None
    files.sort(key=lambda e: e[1], reverse=True)
    return {"remote": False, "proj_dir": proj_dir, "claude_session_id": files[0][0]}


def list_subagents(session_id):
    """Task-tool subagents spawned by an aigw session's current Claude Code
    conversation, newest-first: [{"agent_id", "description", "agent_type"}].

    Confirmed empirically 2026-08-15 (real `claude.exe` 2.1.233 on
    winbox-a): each Task/Agent-tool invocation gets its own file at
    <project-dir>/<claude_session_id>/subagents/agent-<agentId>.jsonl, with
    a sibling agent-<agentId>.meta.json Claude Code itself writes the
    moment the subagent starts -- {"agentType", "description", "toolUseId",
    "spawnDepth"}. This is a plain directory listing, not a heuristic."""
    conv = _resolve_claude_conversation(session_id)
    if conv is None:
        return []

    if conv["remote"]:
        base = f"$HOME/.claude/projects/{conv['key']}/{conv['claude_session_id']}/subagents"
        cmd = f"/usr/bin/find {base} -maxdepth 1 -name 'agent-*.meta.json' -printf '%T@ %f\\n' 2>/dev/null"
        r = _ssh_invoke(conv["machine"], cmd, timeout=10)
        if r.returncode != 0:
            return []
        entries = []
        for line in r.stdout.splitlines():
            try:
                mtime_s, name = line.split(" ", 1)
                entries.append((name, float(mtime_s)))
            except ValueError:
                continue
        entries.sort(key=lambda e: e[1], reverse=True)
        out = []
        for name, _mtime in entries:
            agent_id = name[len("agent-"):-len(".meta.json")]
            if not CLAUDE_CONV_ID_RE.match(agent_id):
                continue  # defense in depth before the unquoted path below
            r2 = _ssh_invoke(conv["machine"], f'cat "{base}/{name}" 2>/dev/null', timeout=10)
            if r2.returncode != 0:
                continue
            try:
                info = json.loads(r2.stdout)
            except ValueError:
                continue
            out.append({"agent_id": agent_id, "description": info.get("description"),
                        "agent_type": info.get("agentType")})
        return out

    subdir = conv["proj_dir"] / conv["claude_session_id"] / "subagents"
    try:
        meta_files = sorted(subdir.glob("agent-*.meta.json"), key=lambda p: p.stat().st_mtime, reverse=True)
    except OSError:
        return []
    out = []
    for mp in meta_files:
        try:
            info = json.loads(mp.read_text())
        except (OSError, ValueError):
            continue
        agent_id = mp.name[len("agent-"):-len(".meta.json")]
        out.append({"agent_id": agent_id, "description": info.get("description"),
                    "agent_type": info.get("agentType")})
    return out


def _render_subagent_transcript(raw_lines):
    """Turns a subagent's own JSONL lines into readable plain text. Each
    line is one of Claude Code's own message objects -- same schema as any
    top-level conversation (see claude_project_dir), just with
    "isSidechain": true and an "agentId" alongside the usual fields.

    Unlike the main chat log (_tail_claude_transcript/_watch_shell_claude
    above deliberately show assistant *text* only, never tool_use/
    tool_result), tool calls ARE included here: seeing what a subagent
    actually *did* -- which files it read, which commands it ran -- is the
    entire reason to open this log at all, not just its final words.
    tool_result content is truncated rather than dropped or shown in full:
    a Bash tool_result can be huge, but "some result appeared" is still
    useful context and a full dump would make this unreadable on a phone."""
    out = []
    for raw in raw_lines:
        raw = raw.strip()
        if not raw:
            continue
        try:
            obj = json.loads(raw)
        except ValueError:
            continue
        msg = obj.get("message") or {}
        content = msg.get("content")
        if obj.get("type") == "user" and isinstance(content, str):
            out.append(f"> {content}")
            continue
        if not isinstance(content, list):
            continue
        for block in content:
            if not isinstance(block, dict):
                continue
            btype = block.get("type")
            if btype == "text":
                text = block.get("text", "").strip()
                if text:
                    out.append(text)
            elif btype == "tool_use":
                name = block.get("name", "?")
                inp = json.dumps(block.get("input", {}), ensure_ascii=False)
                if len(inp) > 200:
                    inp = inp[:200] + "…"
                out.append(f"\U0001f527 {name}({inp})")
            elif btype == "tool_result":
                inner = block.get("content")
                if isinstance(inner, list):
                    inner = " ".join(b.get("text", "") for b in inner
                                      if isinstance(b, dict) and b.get("type") == "text")
                if isinstance(inner, str):
                    inner = inner.strip()
                    if len(inner) > 300:
                        inner = inner[:300] + "…"
                    if inner:
                        out.append(f"  ↳ {inner}")
    return "\n\n".join(out)


def get_subagent_log(session_id, agent_id):
    """Full rendered text of one subagent conversation (see list_subagents
    for how these files are found/named). Reads the whole file every call
    rather than tailing an offset: a Task-tool subagent is a single,
    bounded delegation, not a long-running session, so these logs stay
    small, and the UI only polls this while its own detail panel for that
    one subagent is open -- not continuously, unlike the main chat tailers
    above."""
    if not CLAUDE_CONV_ID_RE.match(agent_id):
        return None
    conv = _resolve_claude_conversation(session_id)
    if conv is None:
        return None

    if conv["remote"]:
        path = f"$HOME/.claude/projects/{conv['key']}/{conv['claude_session_id']}/subagents/agent-{agent_id}.jsonl"
        r = _ssh_invoke(conv["machine"], f'cat "{path}" 2>/dev/null', timeout=10)
        if r.returncode != 0 or not r.stdout:
            return None
        return _render_subagent_transcript(r.stdout.splitlines())

    path = conv["proj_dir"] / conv["claude_session_id"] / "subagents" / f"agent-{agent_id}.jsonl"
    try:
        raw_lines = path.read_text(errors="replace").splitlines()
    except OSError:
        return None
    return _render_subagent_transcript(raw_lines)


def send_push_notification(session_id, message):
    if not STATE_DIR.exists():
        return
    subs_path = STATE_DIR / "push_subscriptions.json"
    if not subs_path.exists():
        return
    try:
        from pywebpush import webpush, WebPushException
    except ImportError:
        log("pywebpush not available, skipping push")
        return

    subs = json.loads(subs_path.read_text())
    if not subs:
        return
    vapid_sub = f"mailto:aigw@{PUBLIC_HOST}"
    if os.path.exists(VAPID_SUB_FILE):
        vapid_sub = Path(VAPID_SUB_FILE).read_text().strip()

    payload = json.dumps({"session_id": session_id, "message": message})
    remaining = []
    for sub in subs:
        try:
            webpush(
                subscription_info=sub,
                data=payload,
                vapid_private_key=VAPID_PRIVATE_KEY_FILE,
                vapid_claims={"sub": vapid_sub},
            )
            remaining.append(sub)
        except WebPushException as e:
            code = getattr(e.response, "status_code", None)
            if code in (404, 410):
                log(f"push subscription gone, dropping: {e}")
                continue  # expired/unsubscribed, drop it
            log(f"push failed: {e}")
            remaining.append(sub)
        except Exception as e:
            # A single malformed subscription (bad keys, etc.) must not take
            # down notification delivery to every other subscriber, nor
            # crash the calling thread (this runs right after a headless
            # claude turn finishes -- see _run_claude_headless_turn).
            log(f"push failed (unexpected error, dropping subscription): {e}")
    subs_path.write_text(json.dumps(remaining))


# Presets with a Claude persona on the other end of the conversation, vs.
# everything else ("shell" and friends), where what's being read back is
# just terminal output, not a reply from anyone -- the download's speaker
# label reflects that distinction the same way the chat log's bubbles do.
CLAUDE_PERSONA_PRESETS = {"claude", "claude-tui", "claude-login", "claude-login-host", "claude-login-root"}


def _transcript_speaker(preset):
    return "Claude" if preset in CLAUDE_PERSONA_PRESETS else "出力"


def _transcript_filename(meta):
    # Deliberately not built from the user-supplied label: it can contain
    # arbitrary characters (including non-ASCII), which Content-Disposition
    # cannot carry in the plain `filename=` parameter without RFC 5987
    # percent-encoding. preset and id are both always plain hex/ASCII, so
    # this never needs that -- the real label still appears inside the file.
    ts = meta.get("created_ts")
    stamp = time.strftime("%Y%m%d-%H%M%S", time.localtime(ts)) if ts else meta.get("id", "session")
    return f"aigw-{meta.get('preset', 'session')}-{stamp}-{meta.get('id', '')[:8]}.txt"


def build_transcript(session_id):
    """A human-readable plain-text export of one session -- the same events
    the chat log itself renders (user_message/agent_output/image/system/
    session_ended), not the raw JSONL: `live_tail`/`screen` are ephemeral
    rendering-only events with no lasting content once a real event
    supersedes them (see renderEvent() in app.js), so replaying them here
    would just reproduce mid-typing fragments instead of the settled
    conversation."""
    meta = load_meta(session_id)
    if meta is None:
        return None
    speaker = _transcript_speaker(meta.get("preset"))

    header = [f"# {meta.get('label') or meta.get('preset')} ({meta.get('preset')})"]
    if meta.get("cwd"):
        header.append(f"作業ディレクトリ: {meta['cwd']}")
    created = meta.get("created_ts")
    if created:
        header.append(f"作成: {time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(created))}")
    # meta.json never persists "alive" -- list_sessions() computes it fresh
    # each call from a live tmux/process check, which this export has no
    # need to pay for. "stopped" is the persisted field and close enough for
    # a one-line summary (measured: "alive" is always absent here, which
    # made this line read "終了" for every session regardless of reality).
    header.append("状態: " + ("終了" if meta.get("stopped") else "実行中"))
    header.append("")
    header.append("-" * 60)
    header.append("")

    body = []
    try:
        raw_lines = (session_dir(session_id) / "events.jsonl").read_text().splitlines()
    except OSError:
        raw_lines = []
    for raw in raw_lines:
        if not raw.strip():
            continue
        try:
            ev = json.loads(raw)
        except ValueError:
            continue
        ts = ev.get("ts")
        stamp = time.strftime("%H:%M:%S", time.localtime(ts)) if ts else "--:--:--"
        etype = ev.get("type")
        if etype == "user_message":
            tag = " (未送信)" if ev.get("submit") is False else ""
            body.append(f"[{stamp}] あなた{tag}:")
            body.append(ev.get("text", ""))
            body.append("")
        elif etype == "agent_output":
            body.append(f"[{stamp}] {speaker}:")
            body.append(ev.get("text", ""))
            body.append("")
        elif etype in ("image", "attachment"):  # "image" is what every outbox
            # file was called before "attachment"+"kind" (2026-08-15, see
            # outbox_attachment_kind) -- old sessions' events.jsonl still has
            # it, and it always did mean "an outbox file", never only a
            # picture, so it renders exactly the same way here.
            body.append(f"[{stamp}] {speaker}: [添付ファイル: {ev.get('filename', '')}]")
            body.append("")
        elif etype == "system":
            body.append(f"[{stamp}] システム: {ev.get('text', '')}")
            body.append("")
        elif etype == "session_ended":
            exit_status = ev.get("exit_status")
            msg = (f"セッションは終了しました (終了コード {exit_status})" if exit_status
                   else "セッションは終了しました")
            body.append(f"[{stamp}] {msg}")
            body.append("")
        # else: live_tail/screen -- ephemeral, intentionally skipped
    return "\n".join(header + body)


# the deployment notes, the design review (2026-08-30, revision 2):
# the single choke point for what a shared collaborator's request
# (X-Aigw-On-Behalf-Of set, see Handler._on_behalf_of) is allowed to reach
# at all, checked before do_GET's/do_POST's own route dispatch even looks
# at the path.
#
# The real bug here was never "a shared collaborator can send a message /
# press a key / stop / resize / rename the owner's session" -- every one of
# those routes calls resolve_session_access(session_id, on_behalf_of) before
# doing anything, which requires on_behalf_of to be in that SPECIFIC
# session's own shared_with list. That is exactly what the deployment notes' own
# README promises ("共同作業" -- collaboration, not view-only) and
# the deployment notes documents deliberately. An earlier revision of this
# comment/allowlist got this wrong and blocked those routes too, on the
# theory that "read-only" was inherently safer -- it is not any safer
# (resolve_session_access already enforces the real boundary) and it broke
# a real, intended feature. Reverted.
#
# The actual bug (found 2026-08-30, the design review):
# aigw-gateway's /agents/api/shared/<owner>/... proxy used to forward ANY
# backend path at all, including routes that call resolve_session_access
# for NOBODY -- they never look at shared_with because they were never
# written to be reachable cross-user in the first place:
#   - POST /push/subscribe: no check of any kind. Silently adds an
#     attacker's endpoint to the victim's push subscriptions (their
#     conversation summaries then go to the attacker indefinitely) and is
#     an SSRF besides (pywebpush POSTs to whatever endpoint URL is given).
#   - POST /sessions/<id>/notify: took a session id but never called
#     resolve_session_access, so it did not matter whose session it was.
#     (Fixed on its own terms 2026-09-17: that route is now owner-only and
#     resolves the session itself -- see its handler. It stays off the
#     allowlist below regardless.)
#   - GET /capabilities, /workdirs, /tmux-sessions, /claude-conversations,
#     /project-docs/{roots,api}, /claude-auth (status), /container-ip: no
#     session id at all, so there is no shared_with to even check against.
#   - POST /sessions (create), /sessions/adopt, /claude-auth/{login,logout},
#     /chrome/kill: same shape, act on the TARGET user's own resources with
#     no session-scoped permission check possible.
#
# So the correct dividing line is not GET vs POST and not "read vs write"
# -- it is exactly "does this route call resolve_session_access() (or, for
# the bare listing, list_sessions(on_behalf_of), which does the equivalent
# shared_with filtering) before doing anything". Every route in that set is
# already safe for a shared collaborator by construction; every route
# outside it either has no notion of shared_with to check, or (delete,
# share, unshare) is deliberately owner-only regardless. This allowlist is
# named after resolve_session_access on purpose: before adding anything to
# it, confirm the target route actually calls resolve_session_access (or
# list_sessions(on_behalf_of) for the one bare-listing exception) -- if it
# doesn't, the fix is to add that call to the route first, in a separate
# change, not to widen this list around it.
#
# aigw-gateway carries a matching pair of allowlists (SHARED_ALLOWED_GET_RE /
# SHARED_ALLOWED_POST_RE), but this backend cannot assume gateway stays
# correct forever -- a gateway bug, or a route added on one side and not
# kept in sync on the other, must not silently reopen the design notes This is the
# authoritative copy.
#
# Explicitly OFF both lists, on purpose, even though each is session-scoped:
#   - sessions/<id>/notify: session-scoped, and since 2026-09-17 it does
#     call resolve_session_access -- but it also 403s any on_behalf_of at
#     all, because there is no legitimate reason for a viewer other than
#     the owner to trigger a push notification. Off the list on purpose,
#     not for want of a check.
#   - sessions/<id>/{delete,share,unshare,archive,unarchive}: each already
#     403s on_behalf_of explicitly (see those routes) -- destroying the
#     owner's data, re-sharing/un-sharing what the owner chose to share, or
#     hiding a session from the owner's own list are deliberately
#     owner-only under the deployment notes regardless of shared_with.
#   - push/subscribe, sessions (POST create), sessions/adopt: not
#     session-scoped at all -- there is no shared_with to check, and no
#     legitimate reason for a request "on behalf of" someone else to reach
#     them.
#   - capabilities, unlock/status, unlock/begin-assertion,
#     unlock/finish-assertion, unlock/begin-registration,
#     unlock/finish-registration, unlock/lock (Phase 2b of the design
#     notes): also not session-scoped, and _unlockd_call() always uses
#     THIS process's own getpass.getuser() regardless of what a request body
#     says -- there is no notion of "check/affect someone else's unlock
#     window on their behalf" for a shared collaborator to have, so falling
#     through to the default 403 here is correct, not an oversight.
def _shared_get_path_allowed(parts):
    """True if a GET for this path (already split into `parts`, see do_GET)
    is reachable when the request carries an on_behalf_of. Matches exactly
    the routes that call resolve_session_access() before doing anything
    (events, events/page, screen, files/<name>, subagents, subagents/<id>,
    download), plus the bare session list (list_sessions(on_behalf_of) does
    the equivalent shared_with filtering) -- see the comment above this
    function for why this is the right boundary."""
    if parts == ["sessions"]:
        return True
    if len(parts) < 3 or parts[0] != "sessions":
        return False
    action = parts[2]
    if len(parts) == 3:
        return action in ("events", "screen", "subagents", "download")
    if len(parts) == 4:
        if action == "events":
            return parts[3] == "page"
        if action in ("files", "subagents"):
            return True
    return False


def _shared_post_path_allowed(parts):
    """True if a POST for this path is reachable when the request carries
    an on_behalf_of. Matches exactly the routes that call
    resolve_session_access() before doing anything: messages, keys, stop,
    resize, rename -- this is the deployment notes' "共同作業" (a shared
    collaborator may act on the session exactly like the owner). notify is
    deliberately NOT here despite being session-scoped -- see the comment
    above _shared_get_path_allowed for why. delete/share/unshare/archive/
    unarchive are also not here; those routes already 403 on_behalf_of
    explicitly regardless of this function."""
    if len(parts) != 3 or parts[0] != "sessions":
        return False
    return parts[2] in ("messages", "keys", "stop", "resize", "rename")


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        log(fmt % args)

    def _json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _unlock_required(self, e):
        """The one place that turns an UnlockRequired (raised by
        require_unlock_if_outside_sandbox(), see that function's docstring)
        into an HTTP response -- always 403 with unlock_required:true, which
        is the one flag app.js's withUnlockRetry() looks for to know "run
        the passkey ceremony and retry this same request", as opposed to any
        other 403 in this file (e.g. the deployment notes' "sharing does not
        include this") that must NOT trigger a WebAuthn prompt. Every POST
        route below that can raise UnlockRequired adds one `except
        UnlockRequired as e: return self._unlock_required(e)` rather than
        building this dict by hand each time.

        "tier" (the original task brief) is UnlockRequired's own e.tier --
        "host" or "root", whichever _tier_for_location() decided this
        location needs -- so app.js knows which tier to request from
        aigw-unlockd's begin-assertion instead of guessing or always
        asking for the stronger one (which would pointlessly demand a
        root-tier passkey from a user who only has, and only needs, a
        host-tier one)."""
        return self._json(403, {"error": str(e), "unlock_required": True, "tier": e.tier})

    def _on_behalf_of(self):
        """Who aigw-gateway says this request is really for (the deployment notes),
        or None for the normal case (this backend's own user).

        This header used to be trusted on the premise that aigw-gateway was
        the only process that could ever reach this backend at all --
        false, on the loopback-TCP transport this backend used to have (see
        BACKEND_SOCKET_PATH's comment, the deployment notes). What can reach this
        backend's socket now is this user's own processes, and root (only
        ever aigw-proxy-handler in practice, relaying a connection that
        already passed through aigw-backend-proxy@<port>.socket's own,
        separately permissioned activation socket -- see that unit and this
        file's module docstring). There really is nothing left here for
        anyone else to spoof: the owning user setting this header
        themselves (say, with curl) can only ever point it at *someone
        else's* shared_with check, which resolve_session_access still
        enforces normally -- it grants them no more than their own
        Unix-level access to this, their own backend, already did."""
        return self.headers.get("X-Aigw-On-Behalf-Of") or None

    def _read_json_body(self):
        length = int(self.headers.get("Content-Length", 0))
        if length == 0:
            return {}
        return json.loads(self.rfile.read(length) or b"{}")

    def do_GET(self):
        parsed = urlparse(self.path)
        parts = [p for p in parsed.path.split("/") if p]
        qs = parse_qs(parsed.query)
        on_behalf_of = self._on_behalf_of()

        # See _shared_get_path_allowed's own comment (the deployment notes,
        # the design review): this must run before any route
        # below, not per-route, so a route added later that forgets to
        # check on_behalf_of does not silently become reachable cross-user.
        if on_behalf_of is not None and not _shared_get_path_allowed(parts):
            return self._json(403, {"error": "sharing does not include this"})

        if parts == ["sessions"]:
            return self._json(200, {"sessions": list_sessions(on_behalf_of)})

        # The viewer's own manual drag-reorder of the session list
        # (the deployment notes, 2026-09-11): a display preference, not a
        # session mutation, so unlike the routes above it is never reached
        # with on_behalf_of set -- it isn't under the /shared/<owner>/...
        # prefix the gateway proxies cross-user, and _shared_get_path_allowed
        # only needs to gate paths that are. Stored per-viewer in this
        # backend's own STATE_DIR, same place as push_subscriptions.json.
        if parts == ["session-order"]:
            order_path = STATE_DIR / "session_order.json"
            order = json.loads(order_path.read_text()) if order_path.exists() else []
            return self._json(200, {"order": order})

        if parts == ["tmux-sessions"]:
            return self._json(200, {"sessions": list_untracked_tmux_sessions()})

        # What this particular user may do, for the UI to key off.
        # root_shell: the "root-shell" preset is offered only to users whose
        # aigw-root-tmux@<user>.service is enabled -- that unit's socket
        # permissions are the actual gate, not this answer.
        # ssh_machines: GPU machines actually reachable right now over the
        # shared SSH key (the deployment notes) -- not a per-user
        # permission (every aigw user with this backend at all shares the
        # same key), just a live reachability probe, same "if it says yes it
        # will work" spirit as root_shell.
        # unlock: the design notes' "GET /capabilities must report the
        # unlock state so the UI can reflect it" -- read-only (`status`, NEVER
        # `touch`: see require_unlock_if_outside_sandbox's own docstring for
        # why polling must never itself be what keeps a window open). On any
        # trouble reaching aigw-unlockd, _unlockd_call already answers
        # {"ok": False, ...}; unlocked comes back False and expires_at None
        # in that case too, which is the honest answer for a UI display --
        # "cannot currently confirm this is unlocked" and "not unlocked"
        # look the same to a user deciding whether to tap a host/root
        # preset. GET /unlock/status below answers the same shape for the
        # frontend's own dedicated countdown poll -- this is just a second
        # copy of the same read folded into the one call the preset dropdown
        # already makes at load time.
        if parts == ["capabilities"]:
            unlock = _unlockd_call("status")
            reachable = reachable_ssh_machines()
            return self._json(200, {
                "root_shell": root_shell_allowed(),
                "ssh_machines": reachable,
                # Which of the reachable machines also offer the drive/folder
                # picker on their Claude preset (the deployment notes) --
                # winbox-a/winbox-b, not linuxbox. The frontend only shows
                # #ssh-cwd-opts for one of these.
                "ssh_machines_drives": [m for m in reachable if SSH_MACHINES.get(m, {}).get("drives")],
                "unlock": {
                    "unlocked": bool(unlock.get("ok")) and bool(unlock.get("unlocked")),
                    "expires_at": unlock.get("expires_at") if unlock.get("ok") else None,
                    # Whether this user has a passkey at all, i.e. whether a
                    # locked window is something they can actually open. The
                    # frontend needs this to offer host/root presets *while
                    # locked* -- root_shell above is only true once the socket
                    # exists, which now means only while already unlocked, so
                    # keying the menu off it alone hides the very option that
                    # starts an unlock (see verb_status's own comment).
                    "enrolled": bool(unlock.get("ok")) and bool(unlock.get("enrolled")),
                    # enrolled_root (the original task brief): "enrolled" above is
                    # true for ANY tier (a host-tier credential satisfies
                    # it) -- exactly what should gate offering the
                    # host-shell preset while locked, but NOT enough to
                    # decide whether the root-shell preset (and the root
                    # Claude-auth row, and Kill Chrome) should ever appear:
                    # those must only be offered to someone who can
                    # actually reach root. app.js's canRoot uses this field,
                    # not "enrolled", for exactly that reason.
                    "enrolled_root": bool(unlock.get("ok")) and bool(unlock.get("enrolled_root")),
                    # tier (the original task brief): which tier the currently
                    # open window (if any) is -- None while locked. Lets a
                    # UI distinguish "unlocked for host only" from
                    # "unlocked for root" without a second call.
                    "tier": unlock.get("tier") if unlock.get("ok") else None,
                },
            })

        # Phase 2b passkey-unlock ceremony (the design notes, the design notes): this
        # backend is a pure relay for the assertion half of WebAuthn (the
        # registration half -- begin/finish-registration -- is POST-only,
        # see do_POST below) plus the read-only status poll the frontend's
        # persistent countdown uses. It never inspects, trusts, or computes
        # anything about whether an assertion is valid -- see
        # require_unlock_if_outside_sandbox's and _unlockd_call's own
        # docstrings for why that verdict belongs to aigw-unlockd alone. Not
        # session-scoped, so on_behalf_of already 403'd above before this
        # point is ever reached (see _shared_get_path_allowed) -- there is no
        # legitimate reason for a shared collaborator to poll or affect the
        # session owner's own passkey/unlock state.
        if parts == ["unlock", "status"]:
            return self._json(200, _unlockd_call("status"))

        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "events":
            _, err = resolve_session_access(parts[1], on_behalf_of)
            if err:
                return self._json(*err)
            return self._sse(parts[1], qs)

        # Plain-JSON page of history for the chat UI's lazy load
        # (the deployment notes) -- unlike GET .../events (SSE,
        # always starts from `since`/Last-Event-ID and then stays open),
        # this is a one-shot request the client makes both for the initial
        # tail and for each further-back page as the user scrolls up.
        if len(parts) == 4 and parts[0] == "sessions" and parts[2] == "events" and parts[3] == "page":
            session_id = parts[1]
            _, err = resolve_session_access(session_id, on_behalf_of)
            if err:
                return self._json(*err)
            before = None
            if qs.get("before"):
                try:
                    before = int(qs["before"][0])
                except ValueError:
                    return self._json(400, {"error": "invalid before"})
            limit = 50
            if qs.get("limit"):
                try:
                    limit = max(1, min(500, int(qs["limit"][0])))
                except ValueError:
                    return self._json(400, {"error": "invalid limit"})
            events, has_more = events_page(session_id, before=before, limit=limit)
            return self._json(200, {"events": events, "has_more": has_more})

        if len(parts) == 4 and parts[0] == "sessions" and parts[2] == "files":
            _, err = resolve_session_access(parts[1], on_behalf_of)
            if err:
                return self._json(*err)
            return self._serve_outbox_file(parts[1], parts[3])

        # Choices for the two headless-claude knobs on the new-session bar.
        # Both are pure directory reads of this user's own ~/sandhome (see
        # list_workdirs / claude_project_dir), never a container round-trip.
        # The pane's current contents, for the UI's screen panel. Served from
        # the watcher's cache, so opening the panel costs no container access
        # at all; live updates then arrive as ephemeral "screen" SSE events.
        # ?before=<n> (2026-09-01, the deployment notes)
        # instead pages backward through _screen_backlog -- same before/
        # limit/has_more shape as GET .../events/page -- for the "scroll up
        # past the live tail" gesture, not the default view.
        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "screen":
            session_id = parts[1]
            _, err = resolve_session_access(session_id, on_behalf_of)
            if err:
                return self._json(*err)
            if qs.get("before"):
                try:
                    before = int(qs["before"][0])
                except ValueError:
                    return self._json(400, {"error": "invalid before"})
                limit = SCREEN_BACKLOG_PAGE_LINES
                if qs.get("limit"):
                    try:
                        limit = max(1, min(1000, int(qs["limit"][0])))
                    except ValueError:
                        return self._json(400, {"error": "invalid limit"})
                lines, has_more = screen_history_page(session_id, before, limit)
                if lines is None:
                    return self._json(404, {"error": "no such session"})
                return self._json(200, {"text": "\n".join(lines), "has_more": has_more})
            with _latest_screen_lock:
                return self._json(200, {"text": _latest_screen.get(session_id, "")})

        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "download":
            _, err = resolve_session_access(parts[1], on_behalf_of)
            if err:
                return self._json(*err)
            return self._serve_transcript_download(parts[1])

        # Task-tool subagents the session's current Claude Code conversation
        # has spawned (see list_subagents/get_subagent_log) -- polled while
        # the chat view's subagent panel is open, same "ask fresh every time"
        # shape as /screen rather than a persistent cache, since these are
        # looked up on demand and change far less often than a pane's screen.
        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "subagents":
            session_id = parts[1]
            _, err = resolve_session_access(session_id, on_behalf_of)
            if err:
                return self._json(*err)
            return self._json(200, {"subagents": list_subagents(session_id)})

        if len(parts) == 4 and parts[0] == "sessions" and parts[2] == "subagents":
            session_id, agent_id = parts[1], parts[3]
            _, err = resolve_session_access(session_id, on_behalf_of)
            if err:
                return self._json(*err)
            text = get_subagent_log(session_id, agent_id)
            if text is None:
                return self._json(404, {"error": "no such subagent log"})
            return self._json(200, {"text": text})

        if parts == ["claude-auth"]:
            return self._json(200, claude_auth_status_all())

        # One level at a time: the client asks for the children of whatever
        # directory it is currently showing. `dir` is echoed back normalised,
        # so the client never has to reconstruct the path it landed on.
        if parts == ["workdirs"]:
            try:
                abs_cwd = resolve_workdir(qs.get("dir", [""])[0])
            except ValueError as e:
                return self._json(400, {"error": str(e)})
            rel = "" if abs_cwd is None else os.path.relpath(abs_cwd, SANDHOME)
            return self._json(200, {
                "dir": "" if rel == "." else rel,
                "subdirs": list_subdirs(abs_cwd),
            })

        # Same "one level at a time" shape as /workdirs above, but for a
        # drives-capable ssh machine's Claude preset (the deployment notes
        # workdirs) -- an empty `dir` means "no drive chosen yet", answered
        # with the machine's own drive letters instead of subdirs; a chosen
        # drive/folder answers with that directory's subdirs instead.
        if parts == ["ssh-workdirs"]:
            machine = qs.get("machine", [""])[0]
            if not SSH_MACHINES.get(machine, {}).get("drives"):
                return self._json(400, {"error": "unknown or non-drives-capable ssh machine"})
            if not ssh_reachable(machine):
                return self._json(400, {"error": f"{machine} is not reachable over SSH right now"})
            try:
                dir_ = resolve_ssh_workdir(machine, qs.get("dir", [""])[0])
            except ValueError as e:
                return self._json(400, {"error": str(e)})
            if dir_ is None:
                return self._json(200, {"dir": "", "drives": list_ssh_drives(machine), "subdirs": []})
            return self._json(200, {"dir": dir_, "drives": [], "subdirs": list_ssh_subdirs(machine, dir_)})

        # Optional, deployment-supplied route (the deployment notes
        # split): project-docs -- see aigw_site_routes.handle_backend_get
        # and SITE_CTX/the aigw_site_routes import (near resolve_workdir).
        if aigw_site_routes and aigw_site_routes.handle_backend_get(self, SITE_CTX, parts, qs):
            return

        if parts == ["claude-conversations"]:
            try:
                abs_cwd = resolve_workdir(qs.get("cwd", [""])[0])
            except ValueError as e:
                return self._json(400, {"error": str(e)})
            return self._json(200, {"conversations": list_claude_conversations(abs_cwd)})

        if parts == ["container-ip"]:
            try:
                return self._json(200, {"ip": container_ip()})
            except (RuntimeError, subprocess.TimeoutExpired) as e:
                return self._json(502, {"error": str(e)})

        self._json(404, {"error": "not found"})

    def do_POST(self):
        parsed = urlparse(self.path)
        parts = [p for p in parsed.path.split("/") if p]
        on_behalf_of = self._on_behalf_of()

        # See _shared_post_path_allowed's own comment (the deployment notes,
        # the design review, revision 2): this must run before
        # any route below, not per-route, so a route added later that
        # forgets to call resolve_session_access does not silently become
        # reachable cross-user. messages/keys/stop/resize/rename ARE allowed
        # here -- they already call resolve_session_access themselves
        # further down and that is the deployment notes' intended "共同作業".
        if on_behalf_of is not None and not _shared_post_path_allowed(parts):
            return self._json(403, {"error": "sharing does not include this"})

        if parts == ["sessions"]:
            body = self._read_json_body()
            try:
                meta = create_session(
                    body.get("preset", "shell"), body.get("label"),
                    cwd=body.get("cwd"), resume=body.get("resume"),
                    skip_permissions=body.get("skip_permissions", True),
                    cols=body.get("cols"), rows=body.get("rows"),
                )
            except UnlockRequired as e:
                return self._unlock_required(e)
            except (ValueError, RuntimeError) as e:
                return self._json(400, {"error": str(e)})
            return self._json(201, meta)

        # Both take {"scope": "container"|"host"|"root"}, defaulting to the
        # container -- which is what a client written before the host/root
        # rows existed sends, and still the one these presets mostly use.
        if parts == ["claude-auth", "logout"]:
            scope = (self._read_json_body() or {}).get("scope", "container")
            try:
                return self._json(200, {"ok": True, "output": claude_auth_logout_scope(scope)})
            except UnlockRequired as e:
                return self._unlock_required(e)
            except ValueError as e:
                return self._json(400, {"error": str(e)})
            except RuntimeError as e:
                return self._json(502, {"error": str(e)})

        # Login can't be a one-shot command (see the "claude-login" entry in
        # TMUX_PRESETS), so this hands back an ordinary chat session instead
        # of a result: the URL shows up as pane output and the code goes back
        # through the normal composer. At most one such session exists per
        # scope -- see start_claude_login for why a second one is a trap.
        if parts == ["claude-auth", "login"]:
            scope = (self._read_json_body() or {}).get("scope", "container")
            try:
                meta = start_claude_login(scope)
            except UnlockRequired as e:
                return self._unlock_required(e)
            except (ValueError, RuntimeError) as e:
                return self._json(400, {"error": str(e)})
            return self._json(201, meta)

        # {"scope": "self"|"all"} -- "all" additionally requires root_shell
        # (see kill_all_chrome), same gate GET /capabilities already reports
        # as root_shell so the frontend only offers it where it will work.
        if parts == ["chrome", "kill"]:
            scope = (self._read_json_body() or {}).get("scope", "self")
            try:
                if scope == "all":
                    kill_all_chrome()
                elif scope == "self":
                    kill_own_chrome()
                else:
                    return self._json(400, {"error": f"unknown scope: {scope}"})
            except UnlockRequired as e:
                return self._unlock_required(e)
            except RuntimeError as e:
                return self._json(400, {"error": str(e)})
            return self._json(200, {"ok": True})

        if parts == ["sessions", "adopt"]:
            body = self._read_json_body()
            try:
                meta = adopt_session(body.get("tmux_name", ""), body.get("location", "container"),
                                      body.get("label"), cols=body.get("cols"), rows=body.get("rows"))
            except UnlockRequired as e:
                return self._unlock_required(e)
            except (ValueError, RuntimeError) as e:
                return self._json(400, {"error": str(e)})
            return self._json(201, meta)

        # Re-fits an existing session's pane to whatever screen is looking at
        # it right now -- see resize_session for why this needs to exist at
        # all beyond create_session's own one-time `-x`.
        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "resize":
            session_id = parts[1]
            _, err = resolve_session_access(session_id, on_behalf_of)
            if err:
                return self._json(*err)
            body = self._read_json_body()
            try:
                resize_session(session_id, body.get("cols"), body.get("rows"))
            except UnlockRequired as e:
                return self._unlock_required(e)
            return self._json(200, {"ok": True})

        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "messages":
            session_id = parts[1]
            meta, err = resolve_session_access(session_id, on_behalf_of)
            if err:
                return self._json(*err)
            body = self._read_json_body()
            text = body.get("text", "")
            # Default True: a client that predates the 送信/実行 split, or any
            # other caller that just posts a text, still gets text-then-Enter.
            submit = body.get("submit", True) is not False
            if meta.get("preset") in HEADLESS_PRESETS and (not text or not submit):
                # No pane to type into between turns -- a message either is a
                # turn or is nothing (see the "claude" preset in PRESETS).
                return self._json(400, {"error": "this preset takes whole messages only"})
            if not text and not submit:
                return self._json(400, {"error": "nothing to send"})
            # Tag who actually typed this when it's a shared collaborator, not
            # the owner (the deployment notes) -- renderEvent() shows this as a name
            # prefix so a co-worked session stays legible about who said what.
            try:
                send_message(session_id, text, submit, from_user=on_behalf_of)
            except UnlockRequired as e:
                return self._unlock_required(e)
            except (RuntimeError, subprocess.TimeoutExpired) as e:
                return self._json(502, {"error": f"message may not have reached the session: {e}"})
            return self._json(202, {"ok": True})

        # Attach an image to this session (2026-09-08): saves it where the
        # session's own pane can Read() it (save_inbox_attachment's own
        # docstring has the per-location detail) and hands back that path --
        # the frontend inserts it as text into the composer, so sending it is
        # just an ordinary message from here on, no new wire protocol into
        # the pane. Body is JSON + base64 (not multipart) to reuse
        # _read_json_body/the rest of this handler's existing shape rather
        # than adding a second body-parsing path just for this one route.
        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "attach":
            session_id = parts[1]
            meta, err = resolve_session_access(session_id, on_behalf_of)
            if err:
                return self._json(*err)
            # Checked against the raw header before _read_json_body() reads
            # the body into memory -- base64 alone runs ~33% over the decoded
            # size, plus the JSON wrapper, so this cap is deliberately looser
            # than MAX_INBOX_BYTES itself.
            content_length = int(self.headers.get("Content-Length", 0))
            if content_length > MAX_INBOX_BYTES * 3 // 2:
                return self._json(413, {"error": "attachment too large"})
            body = self._read_json_body()
            filename = body.get("filename", "")
            if outbox_attachment_kind(filename) != "image":
                return self._json(400, {"error": "only image attachments are supported right now"})
            try:
                data = base64.b64decode(body.get("data_base64", ""), validate=True)
            except (ValueError, base64.binascii.Error):
                return self._json(400, {"error": "data_base64 is not valid base64"})
            if not data:
                return self._json(400, {"error": "data_base64 is required"})
            if len(data) > MAX_INBOX_BYTES:
                return self._json(413, {"error": f"attachment too large (max {MAX_INBOX_BYTES // (1024 * 1024)}MB)"})
            # Same headless exemption as send_message above: the "claude"
            # preset always runs in this user's own container regardless of
            # meta's tmux_location, so it never needs this gate.
            if meta.get("preset") not in HEADLESS_PRESETS:
                try:
                    require_unlock_if_outside_sandbox(meta.get("tmux_location", "container"))
                except UnlockRequired as e:
                    return self._unlock_required(e)
            try:
                path = save_inbox_attachment(session_id, meta, filename, data)
            except RuntimeError as e:
                return self._json(502, {"error": str(e)})
            return self._json(201, {"path": path})

        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "stop":
            session_id = parts[1]
            _, err = resolve_session_access(session_id, on_behalf_of)
            if err:
                return self._json(*err)
            try:
                stop_session(session_id)
            except UnlockRequired as e:
                return self._unlock_required(e)
            return self._json(200, {"ok": True})

        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "delete":
            session_id = parts[1]
            # Owner-only, full stop -- destroying the owner's data is outside
            # what "shared, can collaborate" is meant to grant even though
            # every other action here treats a shared collaborator exactly
            # like the owner (the deployment notes).
            if on_behalf_of is not None:
                return self._json(403, {"error": "sharing does not include delete"})
            if not SESSION_ID_RE.match(session_id) or load_meta(session_id) is None:
                return self._json(404, {"error": "no such session"})
            delete_session(session_id)
            return self._json(200, {"ok": True})

        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "rename":
            session_id = parts[1]
            _, err = resolve_session_access(session_id, on_behalf_of)
            if err:
                return self._json(*err)
            body = self._read_json_body()
            try:
                meta = rename_session(session_id, body.get("label", ""))
            except ValueError as e:
                return self._json(400, {"error": str(e)})
            return self._json(200, meta)

        # Owner-only, same reasoning as delete/share/unshare below: this
        # flips a field in the session's own meta.json, which is shared
        # state (the owner sees it too), not a per-viewer preference like
        # session-order -- a shared collaborator must not be able to hide a
        # session from the owner's own list (the deployment notes).
        if len(parts) == 3 and parts[0] == "sessions" and parts[2] in ("archive", "unarchive"):
            session_id = parts[1]
            if on_behalf_of is not None:
                return self._json(403, {"error": f"sharing does not include {parts[2]}"})
            try:
                meta = archive_session(session_id, parts[2] == "archive")
            except ValueError as e:
                return self._json(404, {"error": str(e)})
            return self._json(200, meta)

        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "keys":
            session_id = parts[1]
            meta, err = resolve_session_access(session_id, on_behalf_of)
            if err:
                return self._json(*err)
            if meta.get("preset") in HEADLESS_PRESETS:
                return self._json(400, {"error": "key input only applies to tmux-based presets"})
            body = self._read_json_body()
            try:
                send_key(
                    meta.get("tmux_name", session_id), meta.get("tmux_location", "container"), body.get("key", ""),
                    ctrl=bool(body.get("ctrl")), alt=bool(body.get("alt")), shift=bool(body.get("shift")),
                )
            except UnlockRequired as e:
                return self._unlock_required(e)
            except ValueError as e:
                return self._json(400, {"error": str(e)})
            return self._json(200, {"ok": True})

        # Owner-only (never proxied through /agents/api/shared/<owner>/...,
        # but reject on_behalf_of defensively anyway): a shared collaborator
        # can co-work a session but must not be able to grant/revoke sharing
        # themselves -- that would let them sub-share to a third person the
        # owner never chose (the deployment notes).
        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "share":
            session_id = parts[1]
            if on_behalf_of is not None:
                return self._json(403, {"error": "cannot re-share a shared session"})
            body = self._read_json_body()
            try:
                meta = share_session(session_id, (body.get("username") or "").strip())
            except ValueError as e:
                return self._json(400, {"error": str(e)})
            return self._json(200, meta)

        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "unshare":
            session_id = parts[1]
            if on_behalf_of is not None:
                return self._json(403, {"error": "cannot modify sharing on a shared session"})
            body = self._read_json_body()
            try:
                meta = unshare_session(session_id, (body.get("username") or "").strip())
            except ValueError as e:
                return self._json(400, {"error": str(e)})
            return self._json(200, meta)

        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "notify":
            # Owner-only, like delete/share/unshare above. Until 2026-09-17
            # this was the one sessions/<id>/* route that checked nothing at
            # all: no resolve_session_access, so a relayed request would have
            # been honoured for any session id of any user. aigw-gateway's
            # allowlist kept that unreachable from outside, but the boundary
            # belongs here, not in a list this file has to trust stays right.
            # A collaborator has no legitimate reason to buzz the owner's
            # phone, so this is a 403 rather than a shared_with check.
            session_id = parts[1]
            if on_behalf_of is not None:
                return self._json(403, {"error": "cannot notify on a shared session"})
            _meta, err = resolve_session_access(session_id, None)
            if err:
                return self._json(*err)
            body = self._read_json_body()
            send_push_notification(session_id, body.get("message", "New activity"))
            return self._json(200, {"ok": True})

        # See the GET counterpart above for why no owner/on_behalf_of check
        # is needed here: this never carries a session id, so it can only
        # ever reorder ids the viewer already knows about (their own list --
        # possibly including ids of sessions shared with them, which is fine,
        # since this is purely how *they* like to see their own dashboard).
        if parts == ["session-order"]:
            body = self._read_json_body()
            order = body.get("order")
            if not isinstance(order, list) or not all(isinstance(x, str) for x in order):
                return self._json(400, {"error": "order must be a list of session ids"})
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            (STATE_DIR / "session_order.json").write_text(json.dumps(order))
            return self._json(200, {"ok": True})

        if parts == ["push", "subscribe"]:
            body = self._read_json_body()
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            subs_path = STATE_DIR / "push_subscriptions.json"
            subs = json.loads(subs_path.read_text()) if subs_path.exists() else []
            endpoint = body.get("endpoint")
            subs = [s for s in subs if s.get("endpoint") != endpoint]
            subs.append(body)
            subs_path.write_text(json.dumps(subs))
            return self._json(201, {"ok": True})

        # ------------------------------------------------------------------
        # Phase 2b passkey-unlock ceremony (the design notes, the design notes): every one
        # of these five POST routes (plus GET /unlock/status above) is a
        # pure relay to aigw-unlockd over _unlockd_call() and answers 200
        # with whatever unlockd said,
        # VERBATIM, ok:true or ok:false alike -- the HTTP status here means
        # "the relay itself worked", not "the WebAuthn ceremony succeeded".
        # That distinction is deliberate and matches the design notes' "root 側
        # で検証... gateway/backend は不透明なバイト列を中継するだけ": this
        # process must never be in a position to fabricate an "ok": true a
        # compromised copy of it could use to grant itself an unlock window,
        # so it is structurally incapable of deciding the verdict -- it can
        # only ask unlockd and repeat the answer. The one case that does NOT
        # come from unlockd is a transport failure, which _unlockd_call()
        # already turns into a synthetic {"ok": false, "error": ...} before
        # it ever gets here, so there is nothing route-specific to catch.
        #
        # "user" is never read from the request body for any of these -- see
        # _unlockd_call's own docstring for why that would be a privilege
        # bug, not just redundant. begin-registration/finish-registration
        # take a caller-supplied "token" (the one-time value from `sudo
        # aigw-passkey register <user>`'s URL, see passkey-register.html);
        # unlockd itself is what checks that token's "user" field against
        # THIS request's own peer uid (_require_peer_is_user_or_root) and
        # against the token record it minted, so a token minted for a
        # different user simply fails there -- there is no need (and no
        # ability) to pre-validate that overlap here.
        if parts == ["unlock", "begin-registration"]:
            body = self._read_json_body()
            return self._json(200, _unlockd_call("begin-registration", token=body.get("token", "")))

        if parts == ["unlock", "finish-registration"]:
            body = self._read_json_body()
            return self._json(200, _unlockd_call(
                "finish-registration", token=body.get("token", ""), credential=body.get("credential"),
            ))

        if parts == ["unlock", "begin-assertion"]:
            # "tier" (the original task brief/6): which tier the caller is trying
            # to unlock for -- app.js sends the tier it got back from the
            # 403 that triggered this ceremony (Handler._unlock_required's
            # own "tier" field) or, for the login-time "does this user have
            # anything at all" probe, whatever it otherwise decided to ask
            # for. Passed straight through, unexamined, same as every other
            # field on this relay -- aigw-unlockd's own _validate_tier is
            # what actually rejects a missing/unknown tier (fail closed:
            # "unknown tier ... → deny", task brief's constraints section).
            body = self._read_json_body()
            return self._json(200, _unlockd_call("begin-assertion", tier=body.get("tier")))

        if parts == ["unlock", "finish-assertion"]:
            body = self._read_json_body()
            return self._json(200, _unlockd_call("finish-assertion", credential=body.get("credential")))

        if parts == ["unlock", "lock"]:
            return self._json(200, _unlockd_call("lock"))

        self._json(404, {"error": "not found"})

    def _serve_outbox_file(self, session_id, filename):
        if not SESSION_ID_RE.match(session_id) or not OUTBOX_NAME_RE.match(filename):
            return self._json(400, {"error": "invalid path"})
        p = session_dir(session_id) / "outbox" / filename
        if not p.is_file():
            return self._json(404, {"error": "not found"})
        data = p.read_bytes()
        self.send_response(200)
        # A real Content-Type (image/png, model/gltf-binary, ...) rather
        # than always octet-stream: <model-viewer> itself doesn't care (it
        # sniffs the bytes), but a browser tab opened directly on this URL
        # should still render/preview sensibly.
        self.send_header("Content-Type", mimetypes.guess_type(filename)[0] or "application/octet-stream")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def _serve_transcript_download(self, session_id):
        if not SESSION_ID_RE.match(session_id):
            return self._json(400, {"error": "invalid session id"})
        meta = load_meta(session_id)
        if meta is None:
            return self._json(404, {"error": "no such session"})
        text = build_transcript(session_id)
        data = text.encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        # filename is always plain ASCII (see _transcript_filename) so the
        # bare `filename=` parameter needs no RFC 5987 percent-encoding.
        self.send_header("Content-Disposition", f'attachment; filename="{_transcript_filename(meta)}"')
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def _sse(self, session_id, qs):
        if not SESSION_ID_RE.match(session_id) or load_meta(session_id) is None:
            return self._json(404, {"error": "no such session"})

        last_event_id = self.headers.get("Last-Event-ID")
        since = 0
        if last_event_id:
            try:
                since = int(last_event_id)
            except ValueError:
                since = 0
        elif qs.get("since"):
            try:
                since = int(qs["since"][0])
            except ValueError:
                since = 0

        q = queue.Queue()
        with _subscribers_lock:
            _subscribers.setdefault(session_id, []).append(q)

        try:
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Connection", "keep-alive")
            self.end_headers()

            events_path = session_dir(session_id) / "events.jsonl"
            max_replayed = since
            if events_path.exists():
                with events_path.open("r") as f:
                    for line in f:
                        try:
                            ev = json.loads(line)
                        except ValueError:
                            continue
                        if ev.get("seq", 0) > since:
                            self._write_sse(ev)
                            max_replayed = max(max_replayed, ev["seq"])

            while True:
                try:
                    ev = q.get(timeout=20)
                except queue.Empty:
                    self.wfile.write(b": keep-alive\n\n")
                    continue
                # Ephemeral events (push_ephemeral, e.g. "screen") carry no
                # seq -- they are not in events.jsonl, so they can never be a
                # duplicate of something the replay above already sent, and
                # the dedupe check must not swallow them.
                seq = ev.get("seq")
                if seq is None or seq > max_replayed:
                    self._write_sse(ev)
        except (BrokenPipeError, ConnectionResetError):
            pass
        finally:
            with _subscribers_lock:
                subs = _subscribers.get(session_id, [])
                if q in subs:
                    subs.remove(q)

    def _write_sse(self, event):
        data = json.dumps(event)
        # No `id:` line for ephemeral events: EventSource remembers the last
        # id it saw and resends it as Last-Event-ID on reconnect, so emitting
        # `id: 0` here would rewind the resume point and replay the whole
        # conversation on every reconnect.
        prefix = "" if event.get("seq") is None else f"id: {event['seq']}\n"
        self.wfile.write(f"{prefix}data: {data}\n\n".encode())


class NotifyOnlyHandler(BaseHTTPRequestHandler):
    """Handles ONLY POST /sessions/<id>/notify, reachable from this user's
    own container over the docker0 bridge -- and only from that container,
    enforced per request by notify_peer_allowed(). Deliberately does not
    expose any other route from the main Handler (session list/messages/
    files) here -- see the NOTIFY_PORT comment above for why that boundary
    matters."""

    protocol_version = "HTTP/1.1"

    def log_message(self, fmt, *args):
        log(f"[notify] {fmt % args}")

    def do_POST(self):
        if not notify_peer_allowed(self.client_address[0]):
            return self._json(403, {"error": "forbidden"})
        parsed = urlparse(self.path)
        parts = [p for p in parsed.path.split("/") if p]
        if len(parts) == 3 and parts[0] == "sessions" and parts[2] == "notify":
            session_id = parts[1]
            length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(length) if length else b""
            try:
                payload = json.loads(body) if body else {}
            except ValueError:
                payload = {}
            message = payload.get("message") or f"Claude: {payload.get('hook_event_name', 'notification')}"
            if SESSION_ID_RE.match(session_id):
                send_push_notification(session_id, message)
            return self._json(200, {"ok": True})
        self._json(404, {"error": "not found"})

    def _json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


class UnixHTTPServer(ThreadingHTTPServer):
    """ThreadingHTTPServer bound to an AF_UNIX path instead of an AF_INET
    (host, port) pair -- see BACKEND_SOCKET_PATH's comment for why
    (the deployment notes). ThreadingHTTPServer/HTTPServer/TCPServer are all
    written assuming AF_INET throughout, so two of their assumptions need
    overriding rather than just flipping `address_family`:

      - HTTPServer.server_bind() derives server_name/server_port from
        `self.server_address[0]`/`[1]` -- fine for a ("host", port) tuple,
        silently wrong for a path string (server_address[1] would be the
        path's second *character*, not an error, so this would not fail
        loudly). server_bind() below does its own binding instead of
        calling into that, and never relies on server_name/server_port
        itself (nothing in this file reads them), so it just sets them to
        harmless placeholders afterward for any stdlib code that expects
        them to exist at all.
      - accept() on an AF_UNIX listening socket hands back '' as the peer
        address (a connecting Unix-domain client is anonymous unless it
        explicitly bound itself to a path first, which no caller here
        ever does) instead of a (host, port) tuple. Nothing in this file
        reads self.client_address either (log_message is overridden on
        both Handler classes below), but get_request() still normalizes it
        to a harmless same-shaped tuple so any future code that assumes
        the documented `(host, port)` shape fails loudly on a bad value
        instead of an IndexError buried in string indexing.
    """
    address_family = socket.AF_UNIX

    def server_bind(self):
        # A stale socket file from a previous run that didn't exit cleanly
        # (aigw-backend@.service is Restart=on-failure, so a killed/crashed
        # instance's socket inode outlives it) makes bind() fail with
        # "address already in use" even though nothing is actually
        # listening on it anymore -- unlink first, unconditionally, rather
        # than only on an orderly shutdown.
        try:
            os.unlink(self.server_address)
        except FileNotFoundError:
            pass
        self.socket.bind(self.server_address)
        self.server_address = self.socket.getsockname()
        # The actual access-control decision (the deployment notes): connecting to
        # an AF_UNIX socket requires *write* permission on it (unix(7)).
        # Owner-only (0600, no group bits at all) is enough here -- unlike
        # aigw-backend-proxy@.socket's own activation socket (owner "aigw",
        # so group access matters for aigw-gateway), the only thing besides
        # this user's own processes that ever connects to *this* socket is
        # aigw-proxy-handler, which runs as root and so isn't subject to
        # file permissions in the first place (root already gets in
        # regardless of what these bits say -- see this file's module
        # docstring for why that's where the trust boundary is meant to
        # live). BACKEND_SOCKET_DIR being world-writable+sticky like /tmp
        # only lets other users create/see *sibling* files in the same
        # directory, never open this one.
        os.chmod(self.server_address, 0o600)
        # Neither of these is read anywhere in this file -- HTTPServer.
        # server_bind() normally derives them from server_address[0]/[1],
        # which for a filesystem path would be nonsense (see this class's
        # docstring), so they're just placeholders for any stdlib code that
        # expects the attributes to exist at all.
        self.server_name = self.server_address
        self.server_port = 0

    def get_request(self):
        conn, _ = self.socket.accept()
        return conn, ("aigw-backend-unix-socket", 0)


def main():
    SESSIONS_DIR.mkdir(parents=True, exist_ok=True)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    list_sessions()  # starts watchers for any pre-existing sessions

    try:
        notify_server = ThreadingHTTPServer((DOCKER0_ADDR, NOTIFY_PORT), NotifyOnlyHandler)
        threading.Thread(target=notify_server.serve_forever, daemon=True).start()
        log(f"notify listener on {DOCKER0_ADDR}:{NOTIFY_PORT}")
    except OSError as e:
        log(f"could not bind docker0 notify listener ({e}); "
            f"Claude Notification/Stop hooks won't reach this backend")

    server = UnixHTTPServer(BACKEND_SOCKET_PATH, Handler)
    log(f"listening on {BACKEND_SOCKET_PATH} (uid={os.getuid()}, home={HOME})")
    server.serve_forever()


if __name__ == "__main__":
    main()
